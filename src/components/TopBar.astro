---
// The top bar, the same on every page so it never moves between them: the logo (its menu comes from nav.js), an
// optional tool title (the "title" slot, an <h1 class="jsal-title">), the page's own links (the default slot) and
// the theme button. "class" adds a page's own layout class, such as a tool's "app-header".
// The logo and the theme button come from lib/topbar.mjs, shared with the team Playbook's own bar.
import { BRAND, THEME } from "../lib/topbar.mjs";
const { class: extra } = Astro.props;
---
<header class:list={[extra, "jsal-top"]}>
  <Fragment set:html={BRAND} />
  <slot name="title" />
  <div class="jsal-actions">
    <slot />
    <Fragment set:html={THEME} />
  </div>
</header>
