---
// The home page's Updates list: the newest change in each of the three most recently changed parts of the site, from
// the changelog collection (src/lib/updates.mjs). Plain rows without links: each tool has its own tile, and the
// heading's line links the changelog.
import { getCollection } from "astro:content";
import { updates } from "../lib/updates.mjs";
const rows = updates(await getCollection("changelog"));
---
<ul class="upd">
  {rows.map((u) => (
    <Fragment><li data-sec={u.section}><span class="upd-name"><img class="upd-ico" src={u.icon} alt="" width="28" height="28">{u.name}</span><time class="mono" datetime={u.date}>{u.label}</time><span class="upd-line">{u.short}</span></li>{"\n"}</Fragment>
  ))}
</ul>
