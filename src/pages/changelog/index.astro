---
import Page from "../../layouts/Page.astro";
import TopBar from "../../components/TopBar.astro";
import { getCollection } from "astro:content";
import { SECTIONS, inOrder, byDay, longDate, section, sentence } from "../../lib/changelog.mjs";
// Every entry from the changelog collection (src/content/changelog.json), grouped by day, newest first
const entries = inOrder(await getCollection("changelog"));
// The filter's parts, each with its address (#redirect-import) and how many entries it has
const slug = (name) => name.toLowerCase().replace(/ /g, "-");
const parts = SECTIONS.map((s) => ({ ...s, id: slug(s.name), count: entries.filter((e) => e.tag === s.name).length }));
---
<Page
  title="Changelog | jsal.io"
  description="Everything that has changed on jsal.io, newest first: the CMS Picker, Clean Paste, the Image Resizer, Redirect Import and the rest of the site."
  path="/changelog/"
  robots="noindex"
  ogDescription="Everything that has changed on jsal.io, newest first."
>
<style is:inline slot="head">
* { box-sizing: border-box; }
body { margin: 0; color: var(--jsal-ink); font: 15px/1.6 var(--jsal-font); -webkit-font-smoothing: antialiased; }
.wrap { max-width: calc(var(--jsal-col) + 40px); margin: 0 auto; padding: 0 var(--jsal-gutter) var(--jsal-page-end); }
.log { margin-top: var(--jsal-page-top); max-width: 44em; }
.code { margin: 0 0 var(--jsal-space-12); font: 500 12px/1.5 "JetBrains Mono", Consolas, monospace; letter-spacing: 0.06em; text-transform: uppercase; color: var(--jsal-accent); }
h1 { margin: 0; font: 700 46px/1.05 "Lora", Georgia, serif; letter-spacing: -0.02em; }   /* every page title's size, as on the home page */
@media (max-width: 520px) { h1 { font-size: 40px; } }
h1 em { font-weight: 600; color: var(--jsal-accent); }
.log .lead { margin: var(--jsal-space-32) 0 0; padding-bottom: var(--jsal-space-40); border-bottom: 1px solid var(--jsal-line); font-size: 17px; color: var(--jsal-ink-2); text-wrap: pretty; }   /* the intro ends in a thin line */
.log .lead + h2 { margin-top: var(--jsal-space-40); }
.log h2 { margin: var(--jsal-space-40) 0 var(--jsal-space-8); font: 700 24px/1.25 "Lora", Georgia, serif; letter-spacing: -0.01em; }
.log ul { margin: 0; padding: 0; list-style: none; }
.log li { display: grid; grid-template-columns: 9.5em minmax(0, 1fr); gap: var(--jsal-space-12); padding: var(--jsal-space-8) 0; border-top: 1px solid var(--jsal-line); color: var(--jsal-ink-2); }
.log .log-name { color: var(--jsal-ink); font-weight: 600; }
@media (pointer: coarse) { .log-name a { position: relative; } .log-name a::after { content: ""; position: absolute; inset: -13px -4px; } }   /* 44px to tap */
.log a { color: var(--jsal-accent); text-underline-offset: 2px; }
@media (max-width: 520px) { .log li { grid-template-columns: minmax(0, 1fr); gap: var(--jsal-space-2); } }
/* With the filter showing, it takes the intro's closing line's place */
.log:has(.jsal-filter:not([hidden])) .lead { padding-bottom: 0; border-bottom: 0; }
.log .jsal-filter { margin-top: var(--jsal-space-32); }
.log .jsal-filter + h2 { margin-top: var(--jsal-space-32); }
.log [hidden] { display: none; }
</style>
<div class="wrap">
  <TopBar />
  <main class="log">
    <p class="code">Changelog</p>
    <h1>What’s <em>changed</em></h1>
    <p class="lead">Everything that has changed on jsal.io, newest first. The home page keeps only the latest change for each part of the site.</p>
    <p class="sr-only" id="flt-said" aria-live="polite"></p>
    <div class="jsal-filter" role="group" aria-label="Show changes to" hidden>
      <button type="button" data-part="" aria-pressed="true"><span class="t">All</span><span class="n">{entries.length}</span></button>
      {parts.map((p) => (
      <button type="button" data-part={p.id} aria-pressed="false"><img src={`/img/icons/${p.icon}.svg`} alt="" width="18" height="18"><span class="t">{p.name}</span><span class="n">{p.count}</span></button>
      ))}
    </div>
    {byDay(entries).map(([date, day]) => (
      <Fragment>
    <h2><time datetime={date}>{longDate(date)}</time></h2>
    <ul>
      {day.map((e) => (
      <Fragment><li data-short={e.short} data-part={slug(e.tag)}><span class="log-name">{section(e.tag).href ? <a href={section(e.tag).href}>{e.tag}</a> : e.tag}</span><span set:html={sentence(e.text)} /></li>{"\n"}</Fragment>
      ))}
    </ul>
      </Fragment>
    ))}
  </main>
</div>
<script is:inline>
// The filter: one part of the site at a time, kept in the address (#redirect-import) so a filtered view can be
// shared. Without this script the filter stays hidden and every change shows
(() => {
  const bar = document.querySelector('.jsal-filter'), said = document.getElementById('flt-said');
  const buttons = [...bar.querySelectorAll('button')];
  const show = (part, announce) => {
    if (!buttons.some((b) => b.dataset.part === part)) part = '';
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.part === part)));
    let n = 0;
    document.querySelectorAll('.log li[data-part]').forEach((li) => { li.hidden = !!part && li.dataset.part !== part; if (!li.hidden) n++; });
    // A day with nothing left to show drops its date too
    document.querySelectorAll('.log h2').forEach((h) => { const ul = h.nextElementSibling; ul.hidden = h.hidden = ![...ul.children].some((li) => !li.hidden); });
    if (announce) said.textContent = `${n} change${n === 1 ? '' : 's'}`;
  };
  bar.hidden = false;
  bar.addEventListener('click', (e) => {
    const b = e.target.closest('button');
    if (!b) return;
    // The page's history state stays as it is: page transitions read it to tell Back from forward
    history.replaceState(history.state, '', b.dataset.part ? `#${b.dataset.part}` : location.pathname);
    show(b.dataset.part, true);
  });
  addEventListener('hashchange', () => show(location.hash.slice(1), true));
  show(location.hash.slice(1), false);
})();
</script>
</Page>
