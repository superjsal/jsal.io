---
import Page from "../layouts/Page.astro";
import TopBar from "../components/TopBar.astro";
import Updates from "../components/Updates.astro";
---
<Page
  title="John Salvador: Technical SEO and Free Web Tools | jsal.io"
  description="John Salvador, a web developer in technical SEO. Free browser tools: CMS Picker to choose a website platform, Clean Paste, an Image Resizer and Redirect Import."
  path="/"
  ogTitle="John Salvador: Technical SEO and Free Web Tools"
  ogDescription="A web developer who works in technical SEO, and free browser tools: CMS Picker, Clean Paste, an Image Resizer and Redirect Import. Nothing is uploaded."
  ogImageAlt="jsal.io: CMS Picker and free content tools by John Salvador"
  cover
>
<script is:inline slot="head" type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": "https://jsal.io/#website", "url": "https://jsal.io/", "name": "jsal.io", "publisher": { "@id": "https://jsal.io/#john" } },
    { "@type": "ProfilePage", "@id": "https://jsal.io/#profile", "url": "https://jsal.io/", "name": "John Salvador: Technical SEO and Free Web Tools", "isPartOf": { "@id": "https://jsal.io/#website" }, "mainEntity": { "@id": "https://jsal.io/#john" } },
    { "@type": "Person", "@id": "https://jsal.io/#john", "name": "John Salvador", "jobTitle": "Web Developer, Technical SEO", "url": "https://jsal.io/", "email": "mailto:dev@jsal.io", "knowsAbout": ["SEO", "Technical SEO", "Content management systems", "Web development"], "sameAs": ["https://github.com/superjsal", "https://steamcommunity.com/id/jsalx87/"] }
  ]
}
</script>
<style is:inline slot="head">
/* Band colours: each tool keeps its own tint with a deep shade of it for the words.
   The pieces of each tool laid on the bands wear the tools' own colours, so they change with the theme as the tools do;
   in dark mode every piece has the same faint edge, and the platform keys a deeper shadow. */
:root {
  --t-cms: #d7c6f0; --t-cms-ink: #3d2466;
  --t-cp: #f3dc9a; --t-cp-ink: #4f3a08;
  --t-ir: #c6e2dd; --t-ir-ink: #13453f;
  --t-ri: #f0d2dc; --t-ri-ink: #5c1a30;
  --obj-shadow: 0 18px 40px rgb(30 20 10 / 0.2), 0 2px 6px rgb(30 20 10 / 0.08);
  --obj-edge: transparent;
  --key-sheen: inset 0 1px 0 rgb(255 255 255 / 0.35);
  --key-drop: 0 18px 24px rgb(30 20 40 / 0.22);
  --key-drop-low: 0 7px 11px rgb(30 20 40 / 0.2);

}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --t-cms: #2c2140; --t-cms-ink: #e3d4ff; --t-cp: #30280f; --t-cp-ink: #f3dc9a; --t-ir: #132a28; --t-ir-ink: #c6e2dd; --t-ri: #321b24; --t-ri-ink: #f4d2de;
    --obj-shadow: 0 18px 40px rgb(0 0 0 / 0.5); --obj-edge: var(--jsal-line-hi);
    --key-drop: 0 18px 24px rgb(0 0 0 / 0.45); --key-drop-low: 0 7px 11px rgb(0 0 0 / 0.4);

  }
}
:root[data-theme="dark"] {
  --t-cms: #2c2140; --t-cms-ink: #e3d4ff; --t-cp: #30280f; --t-cp-ink: #f3dc9a; --t-ir: #132a28; --t-ir-ink: #c6e2dd; --t-ri: #321b24; --t-ri-ink: #f4d2de;
  --obj-shadow: 0 18px 40px rgb(0 0 0 / 0.5); --obj-edge: var(--jsal-line-hi);
  --key-drop: 0 18px 24px rgb(0 0 0 / 0.45); --key-drop-low: 0 7px 11px rgb(0 0 0 / 0.4);

}

* { box-sizing: border-box; }
body { margin: 0; color: var(--jsal-ink); font: 15px/1.6 var(--jsal-font); -webkit-font-smoothing: antialiased; }
a { color: inherit; }
a:focus-visible { outline: 2px solid var(--jsal-accent); outline-offset: 3px; }
a:not(.band):focus-visible { border-radius: var(--jsal-radius); }
/* The column: a 20px gutter each side, wider where a notch or rounded corner cuts in (phones on their side). The top
   bar, the closing section and the footer sit in it; the bands run the full width, each with the same column inside (.in) */
.wrap { max-width: calc(var(--jsal-col) + 40px); margin: 0 auto; padding: 0 max(var(--jsal-gutter), env(safe-area-inset-right, 0px)) 0 max(var(--jsal-gutter), env(safe-area-inset-left, 0px)); }
.wrap.end { padding-bottom: var(--jsal-page-end); }

/* Top bar: the shared one (/shell.css), with section links */
.jsal-top nav { display: flex; gap: var(--jsal-space-2); font-size: 14px; }
.jsal-top nav a { padding: var(--jsal-space-8) var(--jsal-space-8); line-height: 20px; color: var(--jsal-muted); text-decoration: none; border-radius: var(--jsal-radius); }   /* 36px tall, like the apps' controls */
.jsal-top nav a:hover { color: var(--jsal-ink); }
@media (pointer: coarse) {
  .jsal-top nav a { position: relative; }
  .jsal-top nav a::after { content: ""; position: absolute; inset: -4px 0; }   /* 36px drawn, 44px to tap */
}

/* Even line breaks: headings split into balanced lines, paragraphs avoid a lone last word */
h1, h2 { text-wrap: balance; }
p { text-wrap: pretty; }

/* The page is a run of full-width bands, each in its tool's own colour: the tool's name and one line on one side, a
   real-looking piece of the tool at work on the other, the sides swapping down the page. The first band carries the
   page's headline beside the CMS Picker's keys. Each picture can be played with. */
.band { background: var(--bg); color: var(--ink); }
.in { display: flex; align-items: center; justify-content: space-between; gap: var(--jsal-space-48); max-width: calc(var(--jsal-col) + 40px); min-height: 520px; margin: 0 auto; padding: var(--jsal-space-64) max(var(--jsal-gutter), env(safe-area-inset-right, 0px)) var(--jsal-space-64) max(var(--jsal-gutter), env(safe-area-inset-left, 0px)); }
.flip .in { flex-direction: row-reverse; }
.hero { margin-top: var(--jsal-space-12); }
.hero .in { min-height: 620px; }
.txt { position: relative; z-index: 2; flex: 0 1 440px; min-width: 0; }
.roles { display: flex; flex-wrap: wrap; margin: 0; font: 500 12px/1.5 "JetBrains Mono", Consolas, monospace; letter-spacing: 0.06em; text-transform: uppercase; }
.roles span + span::before { content: "·"; content: "·" / ""; margin: 0 var(--jsal-space-8); color: var(--jsal-muted); }
.hero h1 { margin: var(--jsal-space-16) 0 0; font: 700 76px/1 "Lora", Georgia, serif; letter-spacing: -0.03em; }   /* style: allow (the home page's headline: the one line set larger than a page title) */
.hero h1 em { font-weight: 600; color: var(--jsal-accent); }
.hero .txt p { max-width: 34ch; margin: var(--jsal-space-20) 0 0; font-size: 17px; }
.cta { display: flex; margin: var(--jsal-space-20) 0 0; }
.cta a { display: inline-flex; align-items: center; padding: var(--jsal-space-8) var(--jsal-space-20); border-radius: var(--jsal-radius-pill); background: var(--jsal-fill); color: var(--jsal-on-fill); box-shadow: inset 0 0 0 1px var(--jsal-fill-edge); font-size: 15px; font-weight: var(--jsal-btn-weight); text-decoration: none; transition: transform var(--jsal-quick) ease; }
.cta a:hover { transform: translateY(-2px); }
.cta a:focus-visible { outline: none; box-shadow: var(--jsal-focus-ring); }
@media (pointer: coarse) { .cta a { min-height: 44px; } }
.band h2 { margin: 0; font: 700 46px/1.05 "Lora", Georgia, serif; letter-spacing: -0.02em; }
.band .txt p { max-width: 30ch; margin: var(--jsal-space-12) 0 0; font-size: 17px; line-height: 1.5; }
/* The way into the band's tool, said as its action */
.go { display: inline-flex; align-items: center; min-height: 40px; margin-top: var(--jsal-space-24); padding: 0 var(--jsal-space-20); border-radius: var(--jsal-radius-pill); background: var(--ink); color: var(--bg); font-size: 15px; font-weight: var(--jsal-btn-weight); text-decoration: none; transition: transform var(--jsal-quick) ease; }
.go:hover { transform: translateY(-2px); }
.go:focus-visible { outline: none; box-shadow: var(--jsal-focus-ring); }
@media (pointer: coarse) { .go { min-height: 44px; } }
/* A tool's picture: a small stage its pieces are placed on, drawn to the pieces' own scale and then enlarged as one,
   so every piece keeps its place and its motion at any size */
.pic { position: relative; flex: none; zoom: 1.3; }
.obj { position: absolute; transform: var(--rest, none); transition: transform var(--jsal-settle) var(--jsal-ease-out); }
.band:hover .obj { transform: var(--hover, var(--rest, none)); }
/* The edge is an outline just inside the piece: a ring drawn as a shadow comes out uneven on a tilted piece, thin on
   one side and heavy at the corners, and an outer one did so in Firefox */
.paper { background: var(--jsal-surface); color: var(--jsal-ink); box-shadow: var(--obj-shadow); outline: 1px solid var(--obj-edge); outline-offset: -1px; }
.mono { font: 600 11px/1.4 "JetBrains Mono", Consolas, monospace; }   /* style: allow (the pictures are miniatures of the tools) */

/* CMS Picker: one key per platform it compares, its logo in that platform's own colours with a darker edge under it,
   in a tilted brick. Playing, three needs take turns, each pressing the keys the quiz puts first for it (.fit-for names it). */
.cms { --bg: var(--t-cms); --ink: var(--t-cms-ink); }
.cms .pic { width: 500px; height: 410px; }
.pcs { left: 18px; top: 86px; z-index: 3; display: flex; flex-direction: column; gap: var(--jsal-space-12); transform-origin: top left; --rest: rotate(-10deg); --hover: rotate(-10deg) translate(-6px, -6px); }
.pcs > span { display: flex; gap: var(--jsal-space-12); }
.pcs > span:nth-child(even) { margin-left: 56px; }   /* style: allow (a picture, drawn to its own measure) */
.pc { --edge: color-mix(in srgb, var(--b) 66%, black); display: grid; place-items: center; width: 100px; height: 66px; border-radius: var(--jsal-radius-xl); background: linear-gradient(180deg, color-mix(in srgb, var(--b) 80%, white), var(--b) 60%); color: var(--c); box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); cursor: pointer; transition: translate var(--jsal-quick) ease, box-shadow var(--jsal-quick) ease; }
/* each key is its platform's guide: it sinks under the pointer and goes right down when pressed */
.pc:hover { translate: 0 4px; box-shadow: var(--key-sheen), 0 6px 0 var(--edge), var(--key-drop-low); }
.pc:active { translate: 0 8px; box-shadow: var(--key-sheen), 0 2px 0 var(--edge), var(--key-drop-low); }
.pc:focus-visible { outline: 2px solid var(--jsal-accent); outline-offset: 3px; }
.pc i { width: 30px; height: 30px; background: currentColor; -webkit-mask: var(--logo) center / contain no-repeat; mask: var(--logo) center / contain no-repeat; }
.pc .wide { width: 46px; }
.pc .wix { -webkit-mask-size: 36px auto; mask-size: 36px auto; }
.pc-light { --edge: color-mix(in srgb, var(--b) 80%, black); background: linear-gradient(180deg, var(--b), color-mix(in srgb, var(--b) 94%, black) 60%); }
/* the need being played, in a pill at the picture's top corner */
.fit-for { position: absolute; left: 0; top: 0; z-index: 4; display: grid; pointer-events: none; }
.fit-for span { grid-area: 1 / 1; justify-self: start; padding: var(--jsal-space-8) var(--jsal-space-12); border-radius: var(--jsal-radius-pill); background: var(--jsal-surface); color: var(--jsal-ink); box-shadow: var(--obj-shadow); outline: 1px solid var(--obj-edge); outline-offset: -1px; font-size: 12px; white-space: nowrap; opacity: 0; }
.p-wordpress { --b: #ffffff; --c: #21759b; }
.p-shopify { --b: #5e8e3e; --c: #ffffff; }
.p-substack { --b: #ff6719; --c: #ffffff; }
.p-wix { --b: #111111; --c: #ffffff; }
.p-squarespace { --b: #ffffff; --c: #111111; }
.p-webflow { --b: #146ef5; --c: #ffffff; }
.p-framer { --b: #0a0a0a; --c: #ffffff; }
.p-hubspot { --b: #ff7a59; --c: #ffffff; }
.p-square { --b: #111111; --c: #ffffff; }
.p-drupal { --b: #0678be; --c: #ffffff; }
.p-duda { --b: #ffffff; --c: #111111; }
.p-bigcommerce { --b: #121118; --c: #ffffff; }
.p-sanity { --b: #f03e2f; --c: #ffffff; }
.p-ghost { --b: #15171a; --c: #ffffff; }

/* Image Resizer: the crop editor with its size buttons and a tilted list of the files it made from that one photo.
   The crop box is the picked size's shape, as large as the photo allows, so playing it takes each size
   in turn (--ar, the width over the height, is registered so it can move smoothly) and each lands in the list. */
@property --ar { syntax: "<number>"; inherits: true; initial-value: 1.91; }
.ir { --bg: var(--t-ir); --ink: var(--t-ir-ink); }
.ir .pic { width: 460px; height: 280px; }
.ed { left: 14px; top: 46px; width: 250px; padding: 12px; border-radius: 16px; --hover: translateY(-8px); }   /* style: allow (a miniature of the tool, drawn to its own scale) */
.ed-head { display: flex; justify-content: space-between; color: var(--jsal-muted); }
.ed-photo { position: relative; display: block; margin-top: var(--jsal-space-8); height: 140px; border-radius: var(--jsal-radius-lg); overflow: hidden; container-type: size; }
.ed-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
.crop { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: min(100cqw, 100cqh * var(--ar)); height: min(100cqh, 100cqw / var(--ar)); outline: 2px solid var(--jsal-fill); outline-offset: -2px; box-shadow: 0 0 0 999px rgb(0 0 0 / 0.42); transition: --ar var(--jsal-settle) var(--jsal-ease-out); }   /* gold, as the tool draws it */
.crop i { position: absolute; width: 12px; height: 12px; border: 0 solid var(--jsal-fill); }
.crop i:nth-child(1) { left: 0; top: 0; border-width: 4px 0 0 4px; }
.crop i:nth-child(2) { right: 0; top: 0; border-width: 4px 4px 0 0; }
.crop i:nth-child(3) { left: 0; bottom: 0; border-width: 0 0 4px 4px; }
.crop i:nth-child(4) { right: 0; bottom: 0; border-width: 0 4px 4px 0; }
.sizes { display: flex; gap: 4px; margin-top: 10px; }   /* style: allow (a picture, drawn to its own measure) */
.sizes span { flex: 1; padding: 5px 0; border-radius: var(--jsal-radius); border: 1px solid var(--jsal-line); font-size: 10px; text-align: center; white-space: nowrap; cursor: pointer; }   /* style: allow (miniature: three sizes across the editor) */
.sizes .on { border-color: var(--jsal-fill); background: var(--jsal-accent-soft); color: var(--jsal-accent); }
.outs { right: 20px; top: 22px; z-index: 3; width: 214px; padding: 12px 14px; border-radius: 16px; --rest: rotate(4deg); --hover: rotate(6deg) translate(4px, -4px); }   /* style: allow (a miniature of the tool, drawn to its own scale) */
.outs-head { display: flex; justify-content: space-between; padding-bottom: var(--jsal-space-8); color: var(--jsal-muted); }
.outs-head span { color: var(--jsal-ok); }
.outs .row { display: flex; align-items: center; gap: 10px; padding: 6px 0; border-top: 1px solid var(--jsal-sunk); }   /* style: allow (a picture, drawn to its own measure) */
/* each file's thumbnail at its own shape, in the same 44 × 30 slot */
.th { flex: none; display: grid; place-items: center; width: 44px; height: 30px; }
.th img { display: block; width: min(44px, 30px * var(--ar)); height: min(30px, 44px / var(--ar)); border-radius: var(--jsal-radius-sm); object-fit: cover; }
.outs .row span { display: flex; flex-direction: column; font-size: 11px; line-height: 1.4; color: var(--jsal-muted); }   /* style: allow (miniature) */
.outs .row b { color: var(--jsal-ink); font-weight: 800; }   /* bolder than its row's 600 would ask for 900, past the font's heaviest */
/* the size picked by hand: its file marked in the list */
.outs .row.pick b { color: var(--jsal-accent); }

/* Clean Paste: its Text | HTML switch over a short post, straight.
   At rest a gold line stands just past halfway, where the text's lines end, the formatted text on its left and the HTML on its right (the switch's
   order), so the still picture shows the same words both ways; playing, the line shows all the text, wipes it all into
   HTML and comes back. */
.cp { --bg: var(--t-cp); --ink: var(--t-cp-ink); }
.cp .pic { width: 290px; height: 140px; zoom: 1.9; }
.sheet { left: 4px; top: 14px; --w: 54%; cursor: ew-resize; touch-action: pan-y; z-index: 1; width: 258px; padding: 14px; border-radius: 18px; display: flex; flex-direction: column; gap: 8px; --hover: translateY(-6px); }   /* style: allow (a miniature of the tool, drawn to its own scale) */
/* the tool's switch in miniature, across the sheet: Text over the formatted half, HTML over the code, the gold line running
   up through it and the selected gold filling the HTML side of the line */
.sw { position: relative; display: grid; grid-template-columns: 54% 1fr; padding: var(--jsal-space-2); border-radius: var(--jsal-radius); background: var(--jsal-sunk); }
.sw::before { content: ""; position: absolute; left: calc(var(--w) + 3px); right: 2px; top: 2px; bottom: 2px; border-radius: var(--jsal-radius-sm); background: var(--jsal-selected-bg); box-shadow: var(--jsal-selected-ring); }
.sw span { position: relative; padding: 2px 0; text-align: center; font: 600 11px/1.4 var(--jsal-font); color: var(--jsal-muted); }   /* style: allow (miniature) */
.sw .h { color: var(--jsal-selected-ink); }
/* the formatted text lies over its HTML, the same three lines, wiped away up to the line */
.views { position: relative; display: grid; }
.views > * { grid-area: 1 / 1; }
.views::after { content: ""; position: absolute; top: -36px; bottom: -4px; left: var(--w); width: 2px; border-radius: var(--jsal-radius-sm); background: var(--jsal-fill); }
.tx { display: flex; flex-direction: column; background: var(--jsal-surface); color: var(--jsal-ink-2); font-size: 12px; line-height: 1.6; clip-path: inset(0 calc(100% - var(--w)) 0 0); }
.tx b { color: var(--jsal-ink); font: 700 14px/1.37 "Lora", Georgia, serif; }   /* one line of the code's height */
.tx .li::before { content: "\2022"; margin-right: var(--jsal-space-8); color: var(--jsal-muted); }
.sheet code { color: var(--jsal-muted); font: 12px/1.6 "JetBrains Mono", Consolas, monospace; white-space: nowrap; }
.sheet code i { font-style: normal; color: var(--jsal-info); }
.sheet .ln { display: block; }
/* --w is where the line stands across the note: the pointer moves it, wiping the text into its HTML and back */

/* Redirect Import: the tool's sheet of old and new addresses, each row with its check, and the file it writes for the
   platform, overlapping its corner; both straight. The sheet's last row shows only on
   phones, where the file is left out. */
.ri { --bg: var(--t-ri); --ink: var(--t-ri-ink); }
.ri .pic { width: 460px; height: 300px; }
.rs { left: 14px; top: 10px; z-index: 2; width: 300px; padding: 10px 14px 8px; border-radius: 16px; display: flex; flex-direction: column; font-size: 12px; --hover: translateY(-6px); }   /* style: allow (a miniature of the tool, drawn to its own scale) */
.rs-head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: var(--jsal-space-8); font-size: 13px; }
.rs-head .mono, .rs .n, .rs .out-cell { color: var(--jsal-muted); }
.rs-row { display: grid; grid-template-columns: 12px 18px 1fr 1.2fr; gap: var(--jsal-space-8); align-items: center; padding: 3px 0; border-top: 1px solid var(--jsal-sunk); }
.rs-row .mono { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-weight: 500; }
.rs .bad-cell { color: var(--jsal-bad); }
.rs .last { display: none; }
.rs-note { margin: -2px 0 4px 46px; color: var(--jsal-bad); font-size: 11px; }   /* style: allow (miniature) */
/* each row's check, as the tool marks it: ready, needs you, or left out on purpose */
.dot { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; font-style: normal; font-size: 11px; font-weight: 700; line-height: 1; }   /* style: allow (miniature) */
.dot.ok { background: var(--jsal-ok-soft); color: var(--jsal-ok); }
.dot.bad { background: var(--jsal-bad-soft); color: var(--jsal-bad); }
.dot.out { background: var(--jsal-sunk); color: var(--jsal-muted); }
.rf { right: 22px; bottom: 14px; z-index: 3; width: 252px; padding: 10px 14px 12px; border-radius: 16px; display: flex; flex-direction: column; gap: 6px; --hover: translateY(-6px); }   /* style: allow (a miniature of the tool, drawn to its own scale) */
.rf-head { display: flex; justify-content: space-between; color: var(--jsal-muted); }
.rf-head span { color: var(--jsal-ok); }
.rf code { font: 12px/1.6 "JetBrains Mono", Consolas, monospace; white-space: nowrap; }
.rf .ln { display: block; overflow: hidden; text-overflow: ellipsis; }
.rf .mute { color: var(--jsal-muted); }
/* pointing at a ready row lights it and the line it wrote in the file */
.rs-row.lit, .rf .ln.lit { border-radius: var(--jsal-radius-sm); background: var(--jsal-accent-soft); }

/* After the tools, on the plain page: a way to say hi, and the newest change in each of the three most recently
   changed parts of the site, as a plain list (the rows aren't links, so they don't look like cards) */
.tail { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--jsal-space-48); padding-top: var(--jsal-space-64); }
.tail h2 { margin: 0 0 var(--jsal-space-8); font: 700 24px/1.25 "Lora", Georgia, serif; letter-spacing: -0.01em; }
.tail p { margin: 0; color: var(--jsal-ink-2); }
.tail a { position: relative; color: var(--jsal-accent); font-weight: 600; text-underline-offset: 2px; }
.upd { display: flex; flex-direction: column; margin: 0 0 var(--jsal-space-12); padding: 0; list-style: none; }
.upd li { position: relative; padding: var(--jsal-space-8) 0 var(--jsal-space-8) var(--jsal-space-40); border-top: 1px solid var(--jsal-line); }
.upd li:first-child { border-top: 0; }
.upd-name { display: block; padding-right: var(--jsal-space-48); font-size: 13px; font-weight: 700; }
.upd-ico { position: absolute; left: 0; top: 50%; translate: 0 -50%; border-radius: var(--jsal-radius); }
.upd time { position: absolute; right: 0; top: 9px; color: var(--jsal-muted); font-size: 12px; }
.upd-line { display: block; margin-top: 1px; font: 600 17px/1.3 "Lora", Georgia, serif; }

footer { margin-top: var(--jsal-space-32); padding-top: var(--jsal-space-8); border-top: 1px solid var(--jsal-line); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--jsal-space-12); font-size: 13px; color: var(--jsal-muted); }
footer nav { display: flex; gap: var(--jsal-space-4); }
