---
import Page from "../layouts/Page.astro";
import TopBar from "../components/TopBar.astro";
import Updates from "../components/Updates.astro";
import { v } from "../lib/v.mjs";

// The four tools, in the order of the list. Each stage shows one or two pictures of the tool at work (taken from
// the tool itself with its example loaded, in each theme, by .github/build/home-shots.mjs): [piece, width, height].
const TOOLS = [
  { id: "cms", name: "CMS Picker", job: "Choose a website platform", icon: "cms-picker", href: "/cms-picker/", cta: "Start the quiz",
    line: "Answer eight questions and see which of 14 website platforms fits you, and what each one lets you change for SEO.",
    facts: ["14 platforms, each checked against its own documentation", "SEO and AI search settings, platform by platform", "No sign-up, and no client lists behind the ranking"],
    pics: [["quiz", 840, 381]] },
  { id: "ir", name: "Image Resizer", job: "Resize images to exact sizes", icon: "image-resizer", href: "/image-resizer/", cta: "Open the resizer",
    line: "Drop in one image or a whole batch, set the size, move the crop and save. Nothing is uploaded.",
    facts: ["Exact pixel sizes, with a crop you can move", "JPG, PNG or WebP, one at a time or as a ZIP", "Works on your computer: nothing is uploaded"],
    pics: [["work", 451, 524], ["sizes", 348, 73]] },
  { id: "cp", name: "Clean Paste", job: "Clean up a pasted post", icon: "clean-paste", href: "/formatter/", cta: "Paste a post",
    line: "Paste from Word or Google Docs and get clean HTML, with the problems found before the post goes live.",
    facts: ["Finds stray H1s, bold lines meant as headings and draft links", "Copies as formatted text, HTML or WordPress blocks", "Stays in your browser"],
    pics: [["work", 509, 619], ["checks", 299, 227]] },
  { id: "ri", name: "Redirect Import", job: "Keep old links working", icon: "redirect-import", href: "/redirects/", cta: "Choose a file",
    line: "Turn a sheet of old and new addresses into the redirect file Shopify, WordPress, Wix and others import.",
    facts: ["Every row checked: ready, needs you or left out", "The exact file each platform asks for", "A live check that each old address lands"],
    pics: [["sheet", 495, 533], ["file", 331, 533]] },
];
// The CMS Picker's platforms, in its own order: [address, name]
const PLATFORMS = [["wordpress", "WordPress"], ["shopify", "Shopify"], ["wix", "Wix"], ["squarespace", "Squarespace"], ["webflow", "Webflow"], ["framer", "Framer"], ["hubspot", "HubSpot CMS"], ["bigcommerce", "BigCommerce"], ["drupal", "Drupal"], ["duda", "Duda"], ["ghost", "Ghost"], ["sanity", "Sanity"], ["square", "Square Online"], ["substack", "Substack"]];
---
<Page
  title="John Salvador: Technical SEO and Free Web Tools | jsal.io"
  description="John Salvador, a web developer in technical SEO. Free browser tools: CMS Picker to choose a website platform, Clean Paste, an Image Resizer and Redirect Import."
  path="/"
  ogTitle="John Salvador: Technical SEO and Free Web Tools"
  ogDescription="A web developer who works in technical SEO, and free browser tools: CMS Picker, Clean Paste, an Image Resizer and Redirect Import. Nothing is uploaded."
  ogImageAlt="jsal.io: CMS Picker and free content tools by John Salvador"
  cover
  outfit
>
<script is:inline slot="head" type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": "https://jsal.io/#website", "url": "https://jsal.io/", "name": "jsal.io", "publisher": { "@id": "https://jsal.io/#john" } },
    { "@type": "ProfilePage", "@id": "https://jsal.io/#profile", "url": "https://jsal.io/", "name": "John Salvador: Technical SEO and Free Web Tools", "isPartOf": { "@id": "https://jsal.io/#website" }, "mainEntity": { "@id": "https://jsal.io/#john" } },
    { "@type": "Person", "@id": "https://jsal.io/#john", "name": "John Salvador", "jobTitle": "Web Developer, Technical SEO", "url": "https://jsal.io/", "email": "mailto:dev@jsal.io", "knowsAbout": ["SEO", "Technical SEO", "Content management systems", "Web development"], "sameAs": ["https://github.com/superjsal", "https://steamcommunity.com/id/jsalx87/"] }
  ]
}
</script>
<style is:inline slot="head">
/* Each tool's own tint, with a deep shade of it for its name: the colour its stage wears here and the tool wears on
   its own page. A picture of a tool has a soft shadow in the light theme and a faint edge in the dark one. */
:root {
  --t-cms: #d7c6f0; --t-cms-ink: #3d2466;
  --t-cp: #f3dc9a; --t-cp-ink: #4f3a08;
  --t-ir: #c6e2dd; --t-ir-ink: #13453f;
  --t-ri: #f0d2dc; --t-ri-ink: #5c1a30;
  --shot-shadow: 0 24px 50px -22px rgb(20 23 28 / 0.35);
  --shot-edge: transparent;
  --f: "Outfit", "Segoe UI", system-ui, -apple-system, sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --t-cms: #2c2140; --t-cms-ink: #e3d4ff; --t-cp: #30280f; --t-cp-ink: #f3dc9a; --t-ir: #132a28; --t-ir-ink: #c6e2dd; --t-ri: #321b24; --t-ri-ink: #f4d2de;
    --shot-shadow: 0 24px 50px -18px rgb(0 0 0 / 0.6); --shot-edge: var(--jsal-line-hi);
  }
  :root:not([data-theme="light"]) .lt { display: none; }
  :root:not([data-theme="light"]) .dk { display: block; }
}
:root[data-theme="dark"] {
  --t-cms: #2c2140; --t-cms-ink: #e3d4ff; --t-cp: #30280f; --t-cp-ink: #f3dc9a; --t-ir: #132a28; --t-ir-ink: #c6e2dd; --t-ri: #321b24; --t-ri-ink: #f4d2de;
  --shot-shadow: 0 24px 50px -18px rgb(0 0 0 / 0.6); --shot-edge: var(--jsal-line-hi);
}
/* Every picture is there twice, once in each theme, and the theme shows its own */
.dk { display: none; }
:root[data-theme="dark"] .lt { display: none; }
:root[data-theme="dark"] .dk { display: block; }

* { box-sizing: border-box; }
body { margin: 0; color: var(--jsal-ink); font: 15px/1.5 var(--f); -webkit-font-smoothing: antialiased; }
a { color: inherit; }
a:focus-visible, .slot:focus-visible { outline: 2px solid var(--jsal-accent); outline-offset: 3px; border-radius: var(--jsal-radius); }
/* The column: a 20px gutter each side, wider where a notch or rounded corner cuts in (phones on their side) */
.wrap { max-width: calc(var(--jsal-col) + 40px); margin: 0 auto; padding: 0 max(var(--jsal-gutter), env(safe-area-inset-right, 0px)) var(--jsal-page-end) max(var(--jsal-gutter), env(safe-area-inset-left, 0px)); }

/* Top bar: the shared one (/shell.css), with section links */
.jsal-top nav { display: flex; gap: var(--jsal-space-2); font-size: 14px; }
.jsal-top nav a { padding: var(--jsal-space-8) var(--jsal-space-8); line-height: 20px; color: var(--jsal-muted); text-decoration: none; border-radius: var(--jsal-radius); }   /* 36px tall, like the apps' controls */
.jsal-top nav a:hover { color: var(--jsal-ink); }
@media (pointer: coarse) {
  .jsal-top nav a { position: relative; }
  .jsal-top nav a::after { content: ""; position: absolute; inset: -4px 0; }   /* 36px drawn, 44px to tap */
}

h1, h2 { text-wrap: balance; }
p { text-wrap: pretty; }

/* Pick a job: the list of tools on the left never moves, and the stage beside it is the chosen tool, in its colour */
.pick { display: grid; grid-template-columns: 296px minmax(0, 1fr); margin-top: var(--jsal-page-top); }
.rail { display: flex; flex-direction: column; padding: var(--jsal-space-8) 0; }
.rail h1 { margin: 0; font: 700 30px/1.1 var(--f); letter-spacing: -0.02em; }
.rail h1 em { font-style: normal; color: var(--jsal-accent); }
/* The list runs to the stage's edge, so the chosen row joins its stage; everything else in the rail stops short */
.rail > :not(.slots) { margin-right: var(--jsal-space-24); }
.sub { margin: var(--jsal-space-8) 0 0; color: var(--jsal-muted); }
.rail-h { margin: var(--jsal-space-32) 0 var(--jsal-space-8); color: var(--jsal-muted); font: 600 12px/1.5 var(--f); letter-spacing: 0.08em; text-transform: uppercase; }
.slots { display: grid; gap: var(--jsal-space-4); }
.slot { display: grid; grid-template-columns: 44px minmax(0, 1fr) 20px; gap: var(--jsal-space-12); align-items: center; padding: var(--jsal-space-12) var(--jsal-space-20) var(--jsal-space-12) var(--jsal-space-12); border-radius: var(--jsal-radius-xl) 0 0 var(--jsal-radius-xl); text-decoration: none; transition: background-color var(--jsal-quick); }
.slot:hover { background: var(--jsal-sunk); }
.slot img, .more-ui img { border-radius: var(--jsal-radius-lg); }
.slot b { display: block; font: 700 17px/1.2 var(--f); }
.slot-t > span { display: block; margin-top: var(--jsal-space-2); color: var(--jsal-muted); font-size: 13px; line-height: 1.3; }
.slot kbd { justify-self: center; min-width: 20px; padding: 1px 0; border: 1px solid var(--jsal-line-hi); border-radius: var(--jsal-radius-sm); color: var(--jsal-muted); font: 600 12px/1.3 var(--f); text-align: center; }
/* The chosen tool's row wears its tint and runs into its stage as one piece, and the logo's gold gem marks it */
.slot[aria-selected="true"] { background: var(--bg); color: var(--ink); }   /* style: allow (the chosen tool wears its own tint, as its stage does) */
.slot[aria-selected="true"] .slot-t > span { color: inherit; }
.slot[aria-selected="true"] kbd { border-color: currentColor; color: inherit; }   /* style: allow (the number takes the row's own ink) */
.slot { position: relative; }
.slot[aria-selected="true"]::before { content: ""; position: absolute; left: -16px; top: 50%; width: 10px; height: 10px; background: var(--jsal-fill); translate: 0 -50%; rotate: 45deg; }   /* style: allow (the logo's gem as a marker beside the row, not a selected fill) */
.cms { --bg: var(--t-cms); --ink: var(--t-cms-ink); }
.ir { --bg: var(--t-ir); --ink: var(--t-ir-ink); }
.cp { --bg: var(--t-cp); --ink: var(--t-cp-ink); }
.ri { --bg: var(--t-ri); --ink: var(--t-ri-ink); }
.more-ui { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: var(--jsal-space-12); align-items: center; margin-top: auto; padding: var(--jsal-space-12); border: 1px solid var(--jsal-line); border-radius: var(--jsal-radius-xl); text-decoration: none; transition: border-color var(--jsal-quick); }
.more-ui:hover { border-color: var(--jsal-hover-line); }
.more-ui b { display: block; font: 700 15px/1.2 var(--f); }
.more-ui span span { display: block; margin-top: var(--jsal-space-2); color: var(--jsal-muted); font-size: 13px; line-height: 1.3; }

/* A stage: the tool's name very large, what it does and its button on the left, the tool at work on the right,
   running off the stage's edge. Without scripts all four stages show, one under the other. */
.stages { display: grid; gap: var(--jsal-space-24); min-width: 0; }
.stage { position: relative; container-type: inline-size; overflow: hidden; display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); grid-template-rows: auto 1fr; column-gap: var(--jsal-space-32); align-content: start; min-height: 664px; padding: var(--jsal-space-40) var(--jsal-space-40) 0; border-radius: 0 var(--jsal-radius-tile) var(--jsal-radius-tile) 0; background: var(--bg); }
.home-js .stage:not(.on) { display: none; }
/* Picking a tool: the stage's colour turns to the new tool's (the colour sits behind the stages, so it can), and
   the new stage's parts arrive in order from the way the list moved: its name, its words, then its pictures. The
   first stage is simply there when the page opens. */
.home-js .stages { border-radius: 0 var(--jsal-radius-tile) var(--jsal-radius-tile) 0; background: var(--bg, var(--t-cms)); }
.home-js .stages.live { transition: background-color 0.5s cubic-bezier(0.16, 1, 0.3, 1); }   /* style: allow (the stage's colour turning: slower than a state change, so it reads as one move with the parts arriving) */
.home-js .stage { background: none; }
@keyframes arrive { from { opacity: 0; translate: 0 calc(var(--dir, 1) * var(--far, 20px)); } }
/* The gem travels: one gold gem slides down the list to the chosen row, turning as it goes, overshoots a little
   and lands with a ring, so the eye is led to the new spot. From 1280px, where the list is a column. */
.gem { display: none; position: absolute; left: -19px; top: 0; z-index: 1; width: 12px; height: 12px; background: var(--jsal-fill); translate: 0 var(--y, 0); rotate: var(--r, 45deg); pointer-events: none; transition: translate 0.55s cubic-bezier(0.34, 1.45, 0.64, 1), rotate 0.55s cubic-bezier(0.16, 1, 0.3, 1); }   /* style: allow (the gem's trip between rows: a spring that overshoots and settles) */
@keyframes land { from { box-shadow: 0 0 0 0 color-mix(in srgb, var(--jsal-fill) 70%, transparent); } to { box-shadow: 0 0 0 14px color-mix(in srgb, var(--jsal-fill) 0%, transparent); } }
.gem.land { animation: land 0.7s 0.3s ease-out; }   /* style: allow (the ring as the gem lands, after its trip) */
@media (min-width: 1280px) {
  .slots { position: relative; }
  .home-js .gem { display: block; }
  .home-js .slot[aria-selected="true"]::before { display: none; }
}
@keyframes gem { from { scale: 0; rotate: -45deg; } }
.live .stage.on :is(h2, .say > *, .shot, .keys) { animation: arrive 0.6s cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0s) both; }   /* style: allow (a choreographed arrival: each part follows the one before) */
.live .stage.on h2 { --far: 36px; }
.live .stage.on .say > p { --d: 0.05s; }
.live .stage.on .go { --d: 0.1s; }
.live .stage.on .facts { --d: 0.15s; }
.live .stage.on .a { --d: 0.1s; --far: 56px; }
.live .stage.on .b { --d: 0.2s; --far: 72px; }
.live .stage.on .keys { --d: 0.25s; }
.slot[aria-selected="true"]::before { animation: gem 0.4s cubic-bezier(0.16, 1, 0.3, 1); }   /* style: allow (the gem landing on the chosen row) */
.stage h2 { grid-column: 1 / -1; margin: 0; color: var(--ink); font: 800 clamp(40px, 11cqi, 96px)/0.95 var(--f); letter-spacing: -0.03em; white-space: nowrap; }   /* style: allow (the stage's name: the page's one very large line) */
.say { padding: var(--jsal-space-24) 0 var(--jsal-space-40); }
.say p { margin: 0; font: 500 20px/1.4 var(--f); }
.jsal-btn.go { min-height: 48px; margin-top: var(--jsal-space-24); padding: 0 var(--jsal-space-24); gap: var(--jsal-space-8); font: 700 17px/1 var(--f); }
.go svg { width: 18px; height: 18px; }
.facts { display: grid; gap: var(--jsal-space-12); margin: var(--jsal-space-32) 0 0; padding: 0; list-style: none; line-height: 1.4; }
.facts li { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: var(--jsal-space-12); }
.facts svg { width: 20px; height: 20px; color: var(--ink); }
.pic { position: relative; min-height: 420px; margin-top: var(--jsal-space-24); }
.shot { position: absolute; left: var(--x, 0); top: var(--y, 0); width: var(--w); max-width: none; height: auto; border-radius: var(--jsal-radius-xl); box-shadow: var(--shot-shadow); outline: 1px solid var(--shot-edge); }
.lt.shot, .dk.shot { display: none; }
.lt.shot { display: block; }
.cms .a { --w: 700px; }
.ir .a { --x: 80px; --w: 390px; }
.ir .b { --y: 190px; --w: 280px; }
.cp .a { --x: 72px; --w: 420px; }
.cp .b { --y: 230px; --w: 240px; }
.ri .a { --w: 370px; }
.ri .b { --x: 292px; --y: 112px; --w: 250px; }
/* The CMS Picker's stage ends in a key per platform, each opening that platform's guide */
.keys { position: absolute; left: var(--jsal-space-40); right: var(--jsal-space-40); bottom: var(--jsal-space-32); }
.keys p { margin: 0 0 var(--jsal-space-8); font-size: 14px; }
.keys ul { display: grid; grid-template-columns: repeat(14, minmax(0, 1fr)); gap: var(--jsal-space-8); margin: 0; padding: 0; list-style: none; }
.keys a { display: grid; place-items: center; height: 48px; border-radius: var(--jsal-radius-xl); background: color-mix(in srgb, var(--ink) 12%, transparent); transition: background-color var(--jsal-quick); }
.keys a:hover { background: color-mix(in srgb, var(--ink) 22%, transparent); }
.keys i { width: 24px; height: 24px; background: var(--ink); -webkit-mask: var(--logo) center / contain no-repeat; mask: var(--logo) center / contain no-repeat; }
/* A narrow stage stacks: the words, then the picture, then the keys in two rows */
@container (max-width: 700px) {
  .say, .pic { grid-column: 1 / -1; }
  .say { padding-bottom: 0; }
  .pic { min-height: 320px; }
  .b { visibility: hidden; }
  .ir .a, .cp .a { --x: 0px; }
  .keys { position: static; grid-column: 1 / -1; padding: var(--jsal-space-24) 0 var(--jsal-space-32); }
  .keys ul { grid-template-columns: repeat(7, minmax(0, 1fr)); }
  .cms .a { --w: 560px; }
  .cms .pic { min-height: 262px; }
}

/* Under the stage: what changed lately, and how to say hi */
.more { display: grid; grid-template-columns: 272px minmax(0, 1fr) minmax(0, 1fr); gap: var(--jsal-space-24); margin-top: var(--jsal-space-64); }
.more h2 { margin: 0; font: 700 24px/1.2 var(--f); letter-spacing: -0.01em; }
.more h2 + p { margin: var(--jsal-space-8) 0 0; color: var(--jsal-muted); }
.more a { color: var(--jsal-accent); text-underline-offset: 3px; }
.upd { margin: 0; padding: 0; list-style: none; }
.upd li { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; gap: var(--jsal-space-2) var(--jsal-space-12); align-items: center; padding: var(--jsal-space-12) 0; border-top: 1px solid var(--jsal-line); }
.upd li:first-child { padding-top: 0; border-top: 0; }
.upd-name { display: contents; color: var(--jsal-muted); font-size: 13px; }
.upd-ico { grid-row: 1 / 3; border-radius: var(--jsal-radius); }
.upd time { color: var(--jsal-muted); font-size: 13px; font-variant-numeric: tabular-nums; }
.upd-line { grid-column: 2 / 4; font: 600 17px/1.3 var(--f); }
.hi p { margin: 0; font: 500 20px/1.4 var(--f); }
.hi .mail { display: inline-block; margin-top: var(--jsal-space-12); font: 700 24px/1.2 var(--f); }

footer { margin-top: var(--jsal-space-48); padding-top: var(--jsal-space-8); border-top: 1px solid var(--jsal-line); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--jsal-space-12); font-size: 13px; color: var(--jsal-muted); }
footer nav { display: flex; gap: var(--jsal-space-4); }
footer a, footer .foot-btn { padding: var(--jsal-space-8); color: var(--jsal-accent); text-decoration: underline; text-underline-offset: 2px; }   /* the site's own links: gold, as in every Made by line */
footer .foot-btn { border: 0; background: none; font: inherit; cursor: pointer; }   /* reopens the analytics choice (/nav.js) */
/* The platform guides: a quiet row of links above the footer's own line */
.fg { flex: 1 0 100%; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--jsal-space-12); padding-bottom: var(--jsal-space-8); }
.fg span { margin-right: var(--jsal-space-4); font: 600 12px/1.5 var(--f); letter-spacing: 0.08em; text-transform: uppercase; }
footer .fg a { padding: var(--jsal-space-4) 0; color: var(--jsal-muted); text-decoration: none; }
footer .fg a:hover { color: var(--jsal-ink); text-decoration: underline; }
@media (pointer: coarse) {
  footer a, footer .foot-btn { min-height: 44px; display: inline-flex; align-items: center; }
}

/* A small laptop or a tablet: the list runs across the top as four tabs, the stage under it */
@media (max-width: 1279px) {
  .pick { grid-template-columns: minmax(0, 1fr); gap: var(--jsal-space-24); }
  .rail > :not(.slots) { margin-right: 0; }
  .rail-h, .slot kbd, .slot[aria-selected="true"]::before { display: none; }
  .stage, .home-js .stages { border-radius: var(--jsal-radius-tile); }
  .slots { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: var(--jsal-space-24); }
  .slot { grid-template-columns: 44px minmax(0, 1fr); padding: var(--jsal-space-12); border-radius: var(--jsal-radius-xl); }
  .more-ui { order: 3; margin-top: var(--jsal-space-24); }
  .rail { display: contents; }
  .rail h1 { margin-top: var(--jsal-space-8); }
  .stages { order: 2; }
  .more { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .more > div:first-child { grid-column: 1 / -1; }
}
/* An upright phone: the four tools become a dock that stays at the foot of the screen while the stage is in view */
@media (max-width: 699px) {
  .pick { gap: var(--jsal-space-16); }
  .slots { order: 3; position: sticky; bottom: 0; z-index: 2; gap: 0; margin: 0 calc(var(--jsal-gutter) * -1); padding: var(--jsal-space-4) var(--jsal-space-8) max(var(--jsal-space-8), env(safe-area-inset-bottom, 0px)); background: var(--jsal-bg); border-top: 1px solid var(--jsal-line); }
  .slot { grid-template-columns: minmax(0, 1fr); justify-items: center; gap: var(--jsal-space-4); padding: var(--jsal-space-8) var(--jsal-space-2); text-align: center; }
  .slot img { width: 36px; height: 36px; }
  .slot b { font-size: 12px; font-weight: 600; }
  .slot-t > span { display: none; }
  .more-ui { order: 4; margin-top: 0; }
  .stage { min-height: 0; padding: var(--jsal-space-24) var(--jsal-space-20) 0; }
  .say { padding-top: var(--jsal-space-16); }
  .say p { font-size: 17px; }
  .facts { margin-top: var(--jsal-space-24); }
  .keys { padding-bottom: var(--jsal-space-24); }
  .more { grid-template-columns: minmax(0, 1fr); margin-top: var(--jsal-space-48); gap: var(--jsal-space-32); }
}
@media (prefers-reduced-motion: reduce) {
  .slot, .more-ui, .keys a, .home-js .stages.live { transition: none; }
  .live .stage.on :is(h2, .say > *, .shot, .keys), .slot[aria-selected="true"]::before, .gem.land { animation: none; }
  .gem { transition: none; }
}
</style>
<div class="wrap">
  <TopBar><nav aria-label="Sections"><a href="#updates">Updates</a><a href="mailto:dev@jsal.io">Email</a></nav></TopBar>

  <!-- Pick a job: each row of the list is a link to its tool's stage below; with scripts the rows become tabs and
       one stage shows at a time. The stage's button (data-app) opens the tool. -->
  <main class="pick">
    <script is:inline>document.documentElement.classList.add('home-js');</script>
    <div class="rail">
      <h1>Small tools that do <em>one job</em> well.</h1>
      <p class="sub">Free, in your browser, by John Salvador.</p>
      <p class="rail-h" id="jobs-h">Pick a job</p>
      <div class="slots" aria-labelledby="jobs-h">
        {TOOLS.map((t, i) => (
          <a class={`slot ${t.id}`} href={`#${t.id}`} id={`tab-${t.id}`} aria-selected={i === 0 ? "true" : "false"}><img src={`/img/icons/${t.icon}.svg`} alt="" width="44" height="44"><span class="slot-t"><b>{t.name}</b><span>{t.job}</span></span><kbd aria-hidden="true">{i + 1}</kbd></a>
        ))}
      </div>
      <a class="more-ui" href="/jsal-ui/"><img src="/img/icons/off-the-clock.svg" alt="" width="44" height="44"><span><b>Off the clock</b><span>jsal.ui, my free WoW Forever addon</span></span></a>
    </div>

    <div class="stages">
      {TOOLS.map((t, i) => (
        <section class={`stage ${t.id}${i === 0 ? " on" : ""}`} id={t.id} aria-labelledby={`h-${t.id}`}>
          <h2 id={`h-${t.id}`}>{t.name}</h2>
          <div class="say">
            <p>{t.line}</p>
            <a class="jsal-btn primary go" href={t.href} data-app>{t.cta}<svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9h12M10 4l5 5-5 5"/></svg></a>
            <ul class="facts">
              {t.facts.map((f) => <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l3.8 3.8 8-8.6"/></svg><span>{f}</span></li>)}
            </ul>
          </div>
          <div class="pic" aria-hidden="true">
            {t.pics.map(([piece, w, h], n) => ["light", "dark"].map((theme) => (
              <img class={`shot ${n ? "b" : "a"} ${theme === "light" ? "lt" : "dk"}`} src={v(`/img/home/${t.id}-${piece}-${theme}.webp`)} alt="" width={w} height={h} loading={i === 0 ? "eager" : "lazy"} decoding="async">
            )))}
          </div>
          {t.id === "cms" && (
            <nav class="keys" aria-label="Platform guides, as logos">
              <p>Or read one platform’s guide</p>
              <ul>{PLATFORMS.map(([id, name]) => <li><a href={`/cms-picker/${id}/`} aria-label={name} title={name}><i style={`--logo: url(/cms-picker/logos/${id}.svg)`}></i></a></li>)}</ul>
            </nav>
          )}
        </section>
      ))}
    </div>
  </main>

  <!-- Site updates (the newest change in each of the three most recently changed parts of the site) and email -->
  <section class="more" id="updates" aria-labelledby="updates-h">
    <div>
      <h2 id="updates-h">Updates</h2>
      <p>What changed, newest first. <a href="/changelog/">Full changelog</a></p>
    </div>
    <Updates />
    <div class="hi">
      <p>Questions, tool ideas or SEO talk are all welcome. Also on <a href="https://github.com/superjsal">GitHub</a>.</p>
      <a class="mail" href="mailto:dev@jsal.io">dev@jsal.io</a>
    </div>
  </section>

  <footer>
    <!-- Platform guides: the CMS Picker's page per platform, in its order, as a quiet row of links -->
    <nav class="fg" aria-label="Platform guides"><span aria-hidden="true">Platform guides</span>{PLATFORMS.map(([id, name]) => <a href={`/cms-picker/${id}/`}>{name}</a>)}</nav>
    <span><svg class="jsal-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect class="jsal-mark-tile" x=".5" y=".5" width="31" height="31" rx="6.5"/><path class="jsal-mark-j" d="M20 15V20a4.5 4.5 0 0 1-9 0"/><path class="jsal-mark-gem" d="M20 5l3 3-3 3-3-3z"/></svg>© <span id="y">2026</span> John Salvador</span>
    <nav aria-label="Elsewhere"><a href="/play/">Off the clock</a><a href="/privacy/">Privacy</a><button type="button" class="foot-btn" data-jsal-consent>Analytics</button></nav>
  </footer>
</div>
<script is:inline>
document.getElementById('y').textContent = new Date().getFullYear();
// The list becomes tabs: a row shows its tool's stage in place (arrow keys move along the list, and 1 to 4 pick a
// tool from anywhere on the page). The address keeps the choice (#pick-ir), so a link can open the page on any tool.
(() => {
  const list = document.querySelector('.slots'), tabs = [...list.children], stages = [...document.querySelectorAll('.stage')];
  list.setAttribute('role', 'tablist');
  const wide = matchMedia('(min-width: 1280px)');
  const orient = () => list.setAttribute('aria-orientation', wide.matches ? 'vertical' : 'horizontal');
  orient(); wide.addEventListener('change', orient);
  stages.forEach((s, i) => { s.setAttribute('role', 'tabpanel'); s.setAttribute('aria-labelledby', tabs[i].id); });
  let cur = 0, rest = 0, live = false;
  const box = document.querySelector('.stages');
  // One gem for the whole list: it slides to the chosen row, half a turn each trip, and lands with a ring
  const gem = list.appendChild(Object.assign(document.createElement('i'), { className: 'gem' }));
  gem.setAttribute('aria-hidden', 'true');
  let turns = 0;
  const place = (i, moved) => {
    gem.style.setProperty('--y', `${tabs[i].offsetTop + tabs[i].offsetHeight / 2 - 6}px`);
    if (!moved) return;
    gem.style.setProperty('--r', `${45 + 180 * ++turns}deg`);
    gem.classList.remove('land'); void gem.offsetWidth; gem.classList.add('land');
  };
  addEventListener('resize', () => place(cur));
  const pick = (i, focus) => {
    // after the first, a pick says which way the list moved, so the new stage's parts arrive from there
    if (live && i !== cur) { box.style.setProperty('--dir', i < cur ? -1 : 1); box.classList.add('live'); }
    box.style.setProperty('--bg', `var(--t-${stages[i].id})`);
    place(i, live && i !== cur);
    cur = i;
    tabs.forEach((t, j) => { t.setAttribute('aria-selected', i === j ? 'true' : 'false'); t.tabIndex = i === j ? 0 : -1; });
    stages.forEach((s, j) => s.classList.toggle('on', i === j));
    if (focus) tabs[i].focus();
  };
  tabs.forEach((t, i) => {
    t.setAttribute('role', 'tab'); t.setAttribute('aria-controls', stages[i].id);
    t.addEventListener('click', (e) => { e.preventDefault(); pick(i); history.replaceState(history.state, '', i ? `#pick-${stages[i].id}` : location.pathname + location.search); });
    t.addEventListener('keydown', (e) => {
      const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
      if (step) { e.preventDefault(); pick((i + step + tabs.length) % tabs.length, true); }
      if (e.key === ' ') { e.preventDefault(); pick(i); }
    });
  });
  // The mouse wheel over the list steps through it, one tool a notch; past either end the page scrolls as usual
  list.addEventListener('wheel', (e) => {
    const to = cur + Math.sign(e.deltaY);
    if (e.ctrlKey || Math.abs(e.deltaY) <= Math.abs(e.deltaX) || to < 0 || to >= tabs.length) return;
    e.preventDefault();
    if (e.timeStamp < rest) return;   // a trackpad sends a stream of small moves: one step, then a short rest
    rest = e.timeStamp + 220;
    tabs[to].click();
  }, { passive: false });
  // #pick-<tool> names no element, so opening the page on a tool doesn't scroll down to its stage
  const at = stages.findIndex((s) => `#pick-${s.id}` === location.hash);
  pick(at < 0 ? 0 : at);
  live = true;
  addEventListener('keydown', (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey || e.target.closest('input, textarea, select, [contenteditable]')) return;
    const n = '1234'.indexOf(e.key);
    if (e.key.length === 1 && n >= 0) pick(n, true);
  });
})();
</script>
</Page>
