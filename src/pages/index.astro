<script is:inline>
document.getElementById('y').textContent = new Date().getFullYear();
// Touch screens have no hover: each band's picture plays once, the first time half the band is in the middle of the
// screen (not while the band above is still being read), and stops before the loop would fade, so it rests as it started
if (matchMedia('(hover: none)').matches && matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window) {
  const seen = new IntersectionObserver((entries) => entries.forEach((e) => {
    if (!e.isIntersecting) return;
    seen.unobserve(e.target);
    // the CMS Picker plays one of its three needs, picked at random, so no platform is always the one shown
    const cms = e.target.classList.contains('cms');
    if (cms) e.target.style.setProperty('--fit-start', `${-2.7 * Math.floor(Math.random() * 3)}s`);
    e.target.classList.add('play');
    setTimeout(() => e.target.classList.remove('play'), cms ? 2600 : 2900);
  }), { rootMargin: '-20% 0px -20% 0px', threshold: 0.5 });
  document.querySelectorAll('.cms, .ir, .cp, .ri').forEach((band) => seen.observe(band));
}
// The pictures can be played with. Once a pointer is on one, its own play stops (.hands) and it answers the pointer
document.querySelectorAll('.pic').forEach((pic) => pic.addEventListener('pointerenter', () => pic.closest('.band').classList.add('hands'), { once: true }));
// Image Resizer: pick a size and the crop box takes its shape, its file marked in the list
const crop = document.querySelector('.crop'), sizes = [...document.querySelectorAll('.sizes span')], files = [...document.querySelectorAll('.outs .row')];
sizes.forEach((size, i) => size.addEventListener('click', () => {
  crop.style.setProperty('--ar', [1.91, 1, 1.524][i]);
  sizes.forEach((s, j) => s.classList.toggle('on', i === j));
  files.forEach((f, j) => f.classList.toggle('pick', i === j));
}));
// Clean Paste: the gold line goes where the pointer is, wiping the note between its text and its HTML
const sheet = document.querySelector('.sheet'), views = sheet.querySelector('.views');
sheet.addEventListener('pointermove', (e) => {
  const box = views.getBoundingClientRect();
  sheet.style.setProperty('--w', `${Math.max(0, Math.min(100, ((e.clientX - box.left) / box.width) * 100))}%`);
});
// Redirect Import: pointing at a ready row lights it and the line it wrote in the file
const lines = [...document.querySelectorAll('.rf .ln')];
[...document.querySelectorAll('.rs-row')].slice(0, 3).forEach((row, i) => {
  const lit = (on) => [row, lines[i + 1]].forEach((el) => el.classList.toggle('lit', on));
  row.addEventListener('pointerenter', () => lit(true));
  row.addEventListener('pointerleave', () => lit(false));
});
</script>
