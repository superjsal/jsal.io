<script is:inline>
document.getElementById('y').textContent = new Date().getFullYear();
// Touch screens have no hover: each tile's picture plays once, the first time half the tile is in the middle of the
// screen (not while the tile above is still being read), and stops before the loop would fade, so it rests as it started
if (matchMedia('(hover: none)').matches && matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window) {
  const seen = new IntersectionObserver((entries) => entries.forEach((e) => {
    if (!e.isIntersecting) return;
    seen.unobserve(e.target);
    // the CMS Picker plays one of its three needs, picked at random, so no platform is always the one shown
    const cms = e.target.classList.contains('cms');
    if (cms) e.target.style.setProperty('--fit-start', `${-2.7 * Math.floor(Math.random() * 3)}s`);
    e.target.classList.add('play');
    setTimeout(() => e.target.classList.remove('play'), cms ? 2600 : 2900);
  }), { rootMargin: '-20% 0px -20% 0px', threshold: 0.5 });
  document.querySelectorAll('.cms, .ir, .cp, .hi, .ri').forEach((tile) => seen.observe(tile));
}
</script>
