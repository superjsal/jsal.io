---
import Page from "../layouts/Page.astro";
import TopBar from "../components/TopBar.astro";
import Updates from "../components/Updates.astro";
---
<Page
  title="John Salvador: Technical SEO and Free Web Tools | jsal.io"
  description="John Salvador, a web developer who works in technical SEO. Free browser tools: CMS Picker to choose a website platform, Clean Paste and an Image Resizer."
  path="/"
  ogTitle="John Salvador: Technical SEO and Free Web Tools"
  ogDescription="A web developer who works in technical SEO, and free browser tools: CMS Picker, Clean Paste and an Image Resizer. Nothing is uploaded."
  ogImageAlt="jsal.io: CMS Picker and free content tools by John Salvador"
  cover
>
<Fragment slot="head"><Fragment set:html={`<!-- Colours, top bar, column width and page transitions: shared styles in /shell.css -->`} /></Fragment>
<script is:inline slot="head" type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": "https://jsal.io/#website", "url": "https://jsal.io/", "name": "jsal.io", "publisher": { "@id": "https://jsal.io/#john" } },
    { "@type": "ProfilePage", "@id": "https://jsal.io/#profile", "url": "https://jsal.io/", "name": "John Salvador: Technical SEO and Free Web Tools", "isPartOf": { "@id": "https://jsal.io/#website" }, "mainEntity": { "@id": "https://jsal.io/#john" } },
    { "@type": "Person", "@id": "https://jsal.io/#john", "name": "John Salvador", "jobTitle": "Web Developer, Technical SEO", "url": "https://jsal.io/", "email": "mailto:dev@jsal.io", "knowsAbout": ["SEO", "Technical SEO", "Content management systems", "Web development"], "sameAs": ["https://github.com/superjsal", "https://steamcommunity.com/id/jsalx87/"] }
  ]
}
</script>
<style is:inline slot="head">
/* Tile colours: each tool keeps its own tint with a deep shade of it for the words; Updates and Say hi are plain.
   The pieces of each tool laid on the tiles wear the tools' own colours, so they change with the theme as the tools do;
   in dark mode every piece has the same faint edge, and the platform keys a deeper shadow. */
:root {
  --t-cms: #d7c6f0; --t-cms-ink: #3d2466;
  --t-cp: #f3dc9a; --t-cp-ink: #4f3a08;
  --t-ir: #c6e2dd; --t-ir-ink: #13453f;
  --t-ri: #f0d2dc; --t-ri-ink: #5c1a30;
  --t-plain: #e8e5dd;
  --obj-shadow: 0 18px 40px rgb(30 20 10 / 0.2), 0 2px 6px rgb(30 20 10 / 0.08);
  --key-sheen: inset 0 1px 0 rgb(255 255 255 / 0.35);
  --key-drop: 0 18px 24px rgb(30 20 40 / 0.22);
  --key-drop-low: 0 7px 11px rgb(30 20 40 / 0.2);
  --wm-gem: 0.35;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --t-cms: #2c2140; --t-cms-ink: #e3d4ff; --t-cp: #30280f; --t-cp-ink: #f3dc9a; --t-ir: #132a28; --t-ir-ink: #c6e2dd; --t-ri: #321b24; --t-ri-ink: #f4d2de; --t-plain: #1c1f27;
    --obj-shadow: inset 0 0 0 1px var(--jsal-line-hi), 0 18px 40px rgb(0 0 0 / 0.5);   /* edge drawn inside: an outside ring on a tilted piece draws unevenly in Firefox */
    --key-drop: 0 18px 24px rgb(0 0 0 / 0.45); --key-drop-low: 0 7px 11px rgb(0 0 0 / 0.4);
    --wm-gem: 0.45;   /* a little stronger, so the faint gold doesn't read as brown on the dark tints */
  }
}
:root[data-theme="dark"] {
  --t-cms: #2c2140; --t-cms-ink: #e3d4ff; --t-cp: #30280f; --t-cp-ink: #f3dc9a; --t-ir: #132a28; --t-ir-ink: #c6e2dd; --t-ri: #321b24; --t-ri-ink: #f4d2de; --t-plain: #1c1f27;
  --obj-shadow: inset 0 0 0 1px var(--jsal-line-hi), 0 18px 40px rgb(0 0 0 / 0.5);
  --key-drop: 0 18px 24px rgb(0 0 0 / 0.45); --key-drop-low: 0 7px 11px rgb(0 0 0 / 0.4);
  --wm-gem: 0.45;
}

* { box-sizing: border-box; }
body { margin: 0; color: var(--jsal-ink); font: 15px/1.6 var(--jsal-font); -webkit-font-smoothing: antialiased; }
a { color: inherit; }
a:focus-visible { outline: 2px solid var(--jsal-accent); outline-offset: 3px; }
a:not(.tile):focus-visible { border-radius: var(--jsal-radius); }   /* tiles keep their own rounded corners, and the outline follows them */
/* The column: a 20px gutter each side, wider where a notch or rounded corner cuts in (phones on their side) */
.wrap { max-width: calc(var(--jsal-col) + 40px); margin: 0 auto; padding: 0 max(var(--jsal-gutter), env(safe-area-inset-right, 0px)) var(--jsal-page-end) max(var(--jsal-gutter), env(safe-area-inset-left, 0px)); }

/* Top bar: the shared one (/shell.css), with section links */
.jsal-top nav { display: flex; gap: var(--jsal-space-2); font-size: 14px; }
.jsal-top nav a { padding: var(--jsal-space-8) var(--jsal-space-8); line-height: 20px; color: var(--jsal-muted); text-decoration: none; border-radius: var(--jsal-radius); }   /* 36px tall, like the apps' controls */
.jsal-top nav a:hover { color: var(--jsal-ink); }
@media (pointer: coarse) {
  .jsal-top nav a { position: relative; }
  .jsal-top nav a::after { content: ""; position: absolute; inset: -4px 0; }   /* 36px drawn, 44px to tap */
}

/* Even line breaks: headings split into balanced lines, paragraphs avoid a lone last word */
h1, h2 { text-wrap: balance; }
p { text-wrap: pretty; }

/* Bento grid: six columns, the wide tile swapping sides each row, and Updates across the bottom */
.grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); grid-template-rows: minmax(440px, auto) minmax(256px, auto) minmax(276px, auto) minmax(220px, auto); gap: var(--jsal-space-32); margin-top: var(--jsal-page-top); }
.intro { grid-column: 1 / 3; grid-row: 1; align-self: start; padding-right: var(--jsal-space-12); }
.cms { grid-column: 3 / 7; grid-row: 1; }
.ir { grid-column: 1 / 5; grid-row: 2; }
.cp { grid-column: 5 / 7; grid-row: 2; }
.hi { grid-column: 1 / 3; grid-row: 3; }
.ri { grid-column: 3 / 7; grid-row: 3; }
.now { grid-column: 1 / 7; grid-row: 4; }

/* The intro: at the shared distance under the top bar, flush with the logo */
.roles { display: flex; flex-wrap: wrap; margin: 0; font: 500 12px/1.5 "JetBrains Mono", Consolas, monospace; letter-spacing: 0.06em; text-transform: uppercase; color: var(--jsal-accent); }
.roles span + span::before { content: "·"; content: "·" / ""; margin: 0 var(--jsal-space-8); color: var(--jsal-muted); }
.intro h1 { margin: var(--jsal-space-12) 0 0; font: 700 46px/1.05 "Lora", Georgia, serif; letter-spacing: -0.02em; }
.intro h1 em { font-weight: 600; color: var(--jsal-accent); }
.intro p { margin: var(--jsal-space-16) 0 0; font-size: 17px; color: var(--jsal-ink-2); }
.cta { display: flex; margin: var(--jsal-space-20) 0 0; }
.cta a { display: inline-flex; align-items: center; padding: var(--jsal-space-8) var(--jsal-space-20); border-radius: var(--jsal-radius-pill); background: var(--jsal-fill); color: var(--jsal-on-fill); box-shadow: inset 0 0 0 1px var(--jsal-fill-edge); font-size: 15px; font-weight: var(--jsal-btn-weight); text-decoration: none; transition: transform var(--jsal-quick) ease; }
.cta a:hover { transform: translateY(-2px); }
.cta a:focus-visible { outline: none; box-shadow: var(--jsal-focus-ring); }
@media (pointer: coarse) { .cta a { min-height: 44px; } }

/* Tiles: soft colour, a deep-shade serif name, and real-looking pieces of the tool laid on top. Each tile
   clips most of its pieces (.clip); a piece may poke a little past the edge, never near another tile and never into the
   page's side gutter, so nothing reaches past the column at any width. Every tool tile reads the same way: its name and
   line at the top left, then the picture. */
.tile { position: relative; display: flex; flex-direction: column; border-radius: var(--jsal-radius-tile); --pad: var(--jsal-space-24); padding: var(--pad); background: var(--bg); color: var(--ink); text-decoration: none; transition: transform var(--jsal-settle) var(--jsal-ease-out); }
a.tile:hover, .hi:has(.hi-mail:hover) { transform: translateY(-4px) rotate(-0.4deg); }
.tile .txt { position: relative; z-index: 2; }
.tile h2 { margin: 0; font: 700 30px/1.1 "Lora", Georgia, serif; }
.tile .txt p { margin: var(--jsal-space-8) 0 0; font-size: 17px; line-height: 1.45; }
.clip { position: absolute; inset: 0; overflow: hidden; border-radius: inherit; pointer-events: none; }
.obj { position: absolute; transform: var(--rest, none); transition: transform var(--jsal-settle) var(--jsal-ease-out); }
a.tile:hover .obj, .hi:has(.hi-mail:hover) .obj { transform: var(--hover, var(--rest, none)); }
.paper { background: var(--jsal-surface); color: var(--jsal-ink); box-shadow: var(--obj-shadow); }
.mono { font: 600 11px/1.4 "JetBrains Mono", Consolas, monospace; }   /* style: allow (the pictures are miniatures of the tools) */
/* Each tool's app icon drawn large and faint in the tile's ink, its gem a faint gold, behind the pictures and always
   clear of the words: a texture, never something the eye goes to before the picture */
.wm { position: absolute; color: var(--ink); }
.wm .s { opacity: 0.07; }
.wm .g { fill: var(--jsal-fill); opacity: var(--wm-gem); }

/* CMS Picker: one key per platform it compares, its logo in that platform's own colours with a darker edge under it,
   in a tilted brick clear of the words above it; it keeps its distance from the tile's right edge, which is the
   column's, so the tilted brick never reaches the gutter however wide the tile is. Playing, three needs take turns, each pressing the keys the quiz puts first for it (.fit-for names it). */
.cms { --bg: var(--t-cms); --ink: var(--t-cms-ink); }
.cms .txt { max-width: 290px; }
.cms .wm { width: 420px; height: 420px; left: calc(100% - 816px); top: 80px; rotate: -10deg; }   /* a podium tilted like the keys, whole, under the words and left of the keys */
.pcs { left: calc(100% - 482px); top: 116px; z-index: 3; display: flex; flex-direction: column; gap: var(--jsal-space-12); transform-origin: top left; --rest: rotate(-10deg); --hover: rotate(-10deg) translate(-6px, -6px); }
.pcs > span { display: flex; gap: var(--jsal-space-12); }
.pcs > span:nth-child(even) { margin-left: 56px; }   /* style: allow (a picture, drawn to its own measure) */
.pc { --edge: color-mix(in srgb, var(--b) 66%, black); display: grid; place-items: center; width: 100px; height: 66px; border-radius: var(--jsal-radius-xl); background: linear-gradient(180deg, color-mix(in srgb, var(--b) 80%, white), var(--b) 60%); color: var(--c); box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); }
.pc i { width: 30px; height: 30px; background: currentColor; -webkit-mask: var(--logo) center / contain no-repeat; mask: var(--logo) center / contain no-repeat; }
.pc .wide { width: 46px; }
.pc .wix { -webkit-mask-size: 36px auto; mask-size: 36px auto; }
.pc-light { --edge: color-mix(in srgb, var(--b) 80%, black); background: linear-gradient(180deg, var(--b), color-mix(in srgb, var(--b) 94%, black) 60%); }
/* the need being played, in a pill under the tile's line */
.fit-for { position: absolute; left: var(--pad); top: 106px; z-index: 4; display: grid; pointer-events: none; }
.fit-for span { grid-area: 1 / 1; justify-self: start; padding: var(--jsal-space-8) var(--jsal-space-12); border-radius: var(--jsal-radius-pill); background: var(--jsal-surface); color: var(--jsal-ink); box-shadow: var(--obj-shadow); font-size: 12px; white-space: nowrap; opacity: 0; }
.p-wordpress { --b: #ffffff; --c: #21759b; }
.p-shopify { --b: #5e8e3e; --c: #ffffff; }
.p-substack { --b: #ff6719; --c: #ffffff; }
.p-wix { --b: #111111; --c: #ffffff; }
.p-squarespace { --b: #ffffff; --c: #111111; }
.p-webflow { --b: #146ef5; --c: #ffffff; }
.p-framer { --b: #0a0a0a; --c: #ffffff; }
.p-hubspot { --b: #ff7a59; --c: #ffffff; }
.p-square { --b: #111111; --c: #ffffff; }
.p-drupal { --b: #0678be; --c: #ffffff; }
.p-duda { --b: #ffffff; --c: #111111; }
.p-bigcommerce { --b: #121118; --c: #ffffff; }
.p-sanity { --b: #f03e2f; --c: #ffffff; }
.p-ghost { --b: #15171a; --c: #ffffff; }

/* Image Resizer: the crop editor with its size buttons and a tilted list of the files it made from that one photo, the
   row's breakout. The crop box is the picked size's shape, as large as the photo allows, so playing it takes each size
   in turn (--ar, the width over the height, is registered so it can move smoothly) and each lands in the list. */
@property --ar { syntax: "<number>"; inherits: true; initial-value: 1.91; }
.ir { --bg: var(--t-ir); --ink: var(--t-ir-ink); }
.ir .txt { max-width: 258px; }
.ir .wm { width: 394px; height: 394px; left: -80px; top: 36px; }   /* the photo's frame lined up with the words, starting under them */
.ed { left: 290px; top: 22px; width: 250px; padding: 12px; border-radius: 16px; --hover: translateY(-8px); }   /* style: allow (a miniature of the tool, drawn to its own scale) */
.ed-head { display: flex; justify-content: space-between; color: var(--jsal-muted); }
.ed-photo { position: relative; display: block; margin-top: var(--jsal-space-8); height: 140px; border-radius: var(--jsal-radius-lg); overflow: hidden; container-type: size; }
.ed-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
.crop { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: min(100cqw, 100cqh * var(--ar)); height: min(100cqh, 100cqw / var(--ar)); outline: 2px solid var(--jsal-fill); outline-offset: -2px; box-shadow: 0 0 0 999px rgb(0 0 0 / 0.42); }   /* gold, as the tool draws it */
.crop i { position: absolute; width: 12px; height: 12px; border: 0 solid var(--jsal-fill); }
.crop i:nth-child(1) { left: 0; top: 0; border-width: 4px 0 0 4px; }
.crop i:nth-child(2) { right: 0; top: 0; border-width: 4px 4px 0 0; }
.crop i:nth-child(3) { left: 0; bottom: 0; border-width: 0 0 4px 4px; }
.crop i:nth-child(4) { right: 0; bottom: 0; border-width: 0 4px 4px 0; }
.sizes { display: flex; gap: 4px; margin-top: 10px; }   /* style: allow (a picture, drawn to its own measure) */
.sizes span { flex: 1; padding: 5px 0; border-radius: var(--jsal-radius); border: 1px solid var(--jsal-line); font-size: 10px; text-align: center; white-space: nowrap; }   /* style: allow (miniature: three sizes across the editor) */
.sizes .on { border-color: var(--jsal-fill); background: var(--jsal-accent-soft); color: var(--jsal-accent); }
.outs { right: 20px; top: -2px; z-index: 3; width: 214px; padding: 12px 14px; border-radius: 16px; --rest: rotate(4deg); --hover: rotate(6deg) translate(4px, -4px); }   /* style: allow (a miniature of the tool, drawn to its own scale) */
.outs-head { display: flex; justify-content: space-between; padding-bottom: var(--jsal-space-8); color: var(--jsal-muted); }
.outs-head span { color: var(--jsal-ok); }
.outs .row { display: flex; align-items: center; gap: 10px; padding: 6px 0; border-top: 1px solid var(--jsal-sunk); }   /* style: allow (a picture, drawn to its own measure) */
/* each file's thumbnail at its own shape, in the same 44 × 30 slot */
.th { flex: none; display: grid; place-items: center; width: 44px; height: 30px; }
.th img { display: block; width: min(44px, 30px * var(--ar)); height: min(30px, 44px / var(--ar)); border-radius: var(--jsal-radius-sm); object-fit: cover; }
.outs .row span { display: flex; flex-direction: column; font-size: 11px; line-height: 1.4; color: var(--jsal-muted); }   /* style: allow (miniature) */
.outs .row b { color: var(--jsal-ink); }

/* Clean Paste: its Text | HTML switch over a short post, straight and poking past the tile's left edge so the watermark
   shows. At rest a gold line stands just past halfway, where the text's lines end, the formatted text on its left and the HTML on its right (the switch's
   order), so the still picture shows the same words both ways; playing, the line shows all the text, wipes it all into
   HTML and comes back. */
.cp { --bg: var(--t-cp); --ink: var(--t-cp-ink); }
.cp .wm { width: 354px; height: 354px; right: -134px; top: 64px; }   /* under the words, off the right edge */
.sheet { left: -12px; top: 118px; z-index: 1; width: 258px; padding: 14px; border-radius: 18px; display: flex; flex-direction: column; gap: 8px; --hover: translateY(-6px); }   /* style: allow (a miniature of the tool, drawn to its own scale) */
/* the tool's switch in miniature, across the sheet: Text over the formatted half, HTML over the code, the gold line running
   up through it and the selected gold filling the HTML side of the line */
.sw { position: relative; display: grid; grid-template-columns: 54% 1fr; padding: var(--jsal-space-2); border-radius: var(--jsal-radius); background: var(--jsal-sunk); }
.sw::before { content: ""; position: absolute; left: calc(54% + 3px); right: 2px; top: 2px; bottom: 2px; border-radius: var(--jsal-radius-sm); background: var(--jsal-selected-bg); box-shadow: var(--jsal-selected-ring); }
.sw span { position: relative; padding: 2px 0; text-align: center; font: 600 11px/1.4 var(--jsal-font); color: var(--jsal-muted); }   /* style: allow (miniature) */
.sw .h { color: var(--jsal-selected-ink); }
/* the formatted text lies over its HTML, the same three lines, wiped away up to the line */
.views { position: relative; display: grid; }
.views > * { grid-area: 1 / 1; }
.views::after { content: ""; position: absolute; top: -36px; bottom: -4px; left: 54%; width: 2px; border-radius: var(--jsal-radius-sm); background: var(--jsal-fill); }
.tx { display: flex; flex-direction: column; background: var(--jsal-surface); color: var(--jsal-ink-2); font-size: 12px; line-height: 1.6; clip-path: inset(0 46% 0 0); }
.tx b { color: var(--jsal-ink); font: 700 14px/1.37 "Lora", Georgia, serif; }   /* one line of the code's height */
.tx .li::before { content: "\2022"; margin-right: var(--jsal-space-8); color: var(--jsal-muted); }
.sheet code { color: var(--jsal-muted); font: 12px/1.6 "JetBrains Mono", Consolas, monospace; white-space: nowrap; }
.sheet code i { font-style: normal; color: var(--jsal-info); }
.sheet .ln { display: block; }

/* Say hi: a draft to the site's address, tilted and poking out at the tile's top-right corner (the row's breakout). The heading's
   link covers the whole tile, so the GitHub link sits above it. */
.hi { --bg: var(--t-plain); --ink: var(--jsal-ink); justify-content: flex-end; }
.hi-mail { text-decoration: none; }
.hi .txt { position: static; margin-top: 130px; }   /* style: allow (room for the draft) static: the link's cover below spans the whole tile; the margin keeps the words under the draft */
.hi-mail::after { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: var(--jsal-radius-tile); }
.hi-mail:focus-visible { outline: none; }
.hi:has(.hi-mail:focus-visible) { outline: 2px solid var(--jsal-accent); outline-offset: 3px; }
.hi .txt a:not(.hi-mail) { position: relative; z-index: 2; color: var(--jsal-accent); font-weight: 600; text-underline-offset: 2px; }
.draft { left: 40px; right: -12px; top: 2px; z-index: 3; padding: 12px 14px; border-radius: 16px; font-size: 12px; pointer-events: none; transform-origin: top right; --rest: rotate(2deg); --hover: rotate(2deg) translateY(-6px); }   /* a click on the draft reaches the email link under it; style: allow (a miniature) */
.draft > span { display: flex; gap: 10px; padding: 4px 0; border-top: 1px solid var(--jsal-sunk); }   /* style: allow (a picture, drawn to its own measure) */
.draft > span:first-child { justify-content: space-between; align-items: center; padding: 0 0 var(--jsal-space-4); border: 0; font-size: 13px; font-weight: 700; }
.draft > span:first-child i { font-style: normal; font-weight: 400; color: var(--jsal-muted); }
.draft em { width: 52px; font-style: normal; color: var(--jsal-muted); }
.draft .body { padding-top: var(--jsal-space-8); }
.draft .body i { overflow: hidden; font-style: normal; color: var(--jsal-ink-2); white-space: nowrap; text-overflow: ellipsis; }

/* Redirect Import: the tool's sheet of old and new addresses, each row with its check, and the file it writes for the
   platform, poking out of the tile's bottom edge towards Updates; both straight. The sheet's last row shows only on
   phones, where the file is left out. */
.ri { --bg: var(--t-ri); --ink: var(--t-ri-ink); }
.ri .txt { max-width: 258px; }
.ri .wm { width: 360px; height: 360px; left: -60px; top: 64px; }   /* the window under the words, its arrow pointing at the sheet */
.rs { left: 290px; top: 10px; z-index: 2; width: 300px; padding: 10px 14px 8px; border-radius: 16px; display: flex; flex-direction: column; font-size: 12px; --hover: translateY(-6px); }   /* style: allow (a miniature of the tool, drawn to its own scale) */
.rs-head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: var(--jsal-space-8); font-size: 13px; }
.rs-head .mono, .rs .n, .rs .out-cell { color: var(--jsal-muted); }
.rs-row { display: grid; grid-template-columns: 12px 18px 1fr 1.2fr; gap: var(--jsal-space-8); align-items: center; padding: 3px 0; border-top: 1px solid var(--jsal-sunk); }
.rs-row .mono { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-weight: 500; }
.rs .bad-cell { color: var(--jsal-bad); }
.rs .last { display: none; }
.rs-note { margin: -2px 0 4px 46px; color: var(--jsal-bad); font-size: 11px; }   /* style: allow (miniature) */
/* each row's check, as the tool marks it: ready, needs you, or left out on purpose */
.dot { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; font-style: normal; font-size: 11px; font-weight: 700; line-height: 1; }   /* style: allow (miniature) */
.dot.ok { background: var(--jsal-ok-soft); color: var(--jsal-ok); }
.dot.bad { background: var(--jsal-bad-soft); color: var(--jsal-bad); }
.dot.out { background: var(--jsal-sunk); color: var(--jsal-muted); }
.rf { right: 22px; bottom: -10px; z-index: 3; width: 252px; padding: 10px 14px 12px; border-radius: 16px; display: flex; flex-direction: column; gap: 6px; --hover: translateY(-6px); }   /* style: allow (a miniature of the tool, drawn to its own scale) */
.rf-head { display: flex; justify-content: space-between; color: var(--jsal-muted); }
.rf-head span { color: var(--jsal-ok); }
.rf code { font: 12px/1.6 "JetBrains Mono", Consolas, monospace; white-space: nowrap; }
.rf .ln { display: block; overflow: hidden; text-overflow: ellipsis; }
.rf .mute { color: var(--jsal-muted); }

/* Updates: the newest change in each of the three most recently changed parts, as a plain list, newest first (the
   rows aren't links, so they don't look like cards), and a faint stack of notes as its watermark */
.now { --bg: var(--t-plain); --ink: var(--jsal-ink); justify-content: flex-end; }
.now .txt { max-width: 260px; }
.now .txt a { color: var(--jsal-accent); font-weight: 600; text-underline-offset: 2px; }
.now .wm { width: 300px; height: 300px; left: calc(50% - 202px); top: -48px; }   /* a stack of notes, the gem on the newest, whole, in the open middle between the words and the list */
.upd { position: absolute; right: var(--pad); top: 16px; width: min(404px, calc(100% - 340px)); display: flex; flex-direction: column; margin: 0; padding: 0; list-style: none; }
.upd li { position: relative; padding: var(--jsal-space-8) 0 var(--jsal-space-8) var(--jsal-space-40); border-top: 1px solid var(--jsal-line); }
.upd li:first-child { border-top: 0; }
.upd-name { display: block; padding-right: var(--jsal-space-48); font-size: 13px; font-weight: 700; }
.upd-ico { position: absolute; left: 0; top: 50%; translate: 0 -50%; border-radius: var(--jsal-radius); }
.upd time { position: absolute; right: 0; top: 9px; color: var(--jsal-muted); font-size: 12px; }
.upd-line { display: block; margin-top: 1px; font: 600 17px/1.3 "Lora", Georgia, serif; }

footer { margin-top: var(--jsal-space-32); padding-top: var(--jsal-space-8); border-top: 1px solid var(--jsal-line); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--jsal-space-12); font-size: 13px; color: var(--jsal-muted); }
footer nav { display: flex; gap: var(--jsal-space-4); }
footer a, footer .foot-btn { padding: var(--jsal-space-8); color: var(--jsal-accent); text-decoration: underline; text-underline-offset: 2px; }   /* the site's own links: gold, as in every Made by line */
footer .foot-btn { border: 0; background: none; font: inherit; cursor: pointer; }   /* reopens the analytics choice (/nav.js) */
/* The platform guides: a full-width row of plain links in the footer's muted ink, so they don't compete with the tiles */
.fg { flex: 1 0 100%; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--jsal-space-12); padding-bottom: var(--jsal-space-8); }
.fg span { margin-right: var(--jsal-space-4); font: 500 12px/1.5 "JetBrains Mono", Consolas, monospace; letter-spacing: 0.06em; text-transform: uppercase; }
footer .fg a { padding: var(--jsal-space-4) 0; color: var(--jsal-muted); text-decoration: none; }
footer .fg a:hover { color: var(--jsal-ink); text-decoration: underline; }
@media (pointer: coarse) {
  footer a, footer .foot-btn { min-height: 44px; display: inline-flex; align-items: center; }
  .hi .txt a:not(.hi-mail)::after, .now .txt a::after { content: ""; position: absolute; inset: -13px -4px; }
}

/* Narrower desktops and phones on their side: the intro on its own row, the CMS Picker, the Image Resizer, Redirect
   Import and Updates full width, and Clean Paste beside Say hi */
@media (max-width: 1279px) {
  .now .wm { width: 200px; height: 200px; left: -8px; top: -24px; }   /* no open middle here: above the words, in line with them */
  .grid { grid-template-rows: none; }
  .intro { grid-column: 1 / -1; grid-row: auto; padding-right: 0; }
  .intro p { max-width: 34em; }
  .cms, .ir, .ri, .now { grid-column: 1 / -1; grid-row: auto; }
  .cms { min-height: 440px; }
  .ir, .cp { min-height: 256px; }
  .ri { min-height: 276px; }   /* room for the sheet's four rows above the file */
  .hi { min-height: 292px; }   /* the draft clear of the words under it */
  .now { min-height: 272px; }
  .cp { grid-column: 1 / 4; grid-row: auto; }
  .hi { grid-column: 4 / 7; grid-row: auto; }
  .sheet { left: var(--pad); }   /* the column's edge: in line with the words instead of poking into the gutter */
  .draft { right: 0; }
}
/* Narrower desktops: the CMS Picker's tile is wider than its keys need, so its podium moves out from under them into
   the open space under the words */
@media (min-width: 861px) and (max-width: 1279px) {
  .cms .wm { width: 460px; height: 460px; left: -40px; top: 60px; }
}
/* Phones on their side: a shorter CMS Picker, its brick smaller, anchored to the right and filling the tile (its top
   keys poking out, beside the words), its watermark under the words */
@media (min-width: 600px) and (max-width: 860px) {
  .cms { min-height: 300px; }
  .cms .txt { max-width: 250px; }
  .pcs { left: auto; right: 358px; top: 46px; translate: 100% 0; --rest: rotate(-10deg) scale(0.74); --hover: rotate(-10deg) scale(0.74) translate(-6px, -6px); }
  .cms .wm { width: 240px; height: 240px; left: -20px; top: 112px; rotate: none; }   /* upright and whole, under the words */
  .fit-for { top: 130px; }   /* under the line's two lines */
}
/* The narrowest of those: a smaller brick inside the tile, narrower words, and room for Say hi's three lines */
@media (min-width: 600px) and (max-width: 699px) {
  .cms .txt { max-width: 220px; }
  .pcs { right: 290px; top: 36px; --rest: rotate(-10deg) scale(0.6); --hover: rotate(-10deg) scale(0.6) translate(-6px, -6px); }
  .cp, .hi { min-height: 304px; }
  .sheet { top: 140px; transform-origin: top left; --rest: scale(0.86); --hover: scale(0.86) translateY(-6px); }
  .ri .txt { max-width: 236px; }   /* the name on one line, clear of the sheet */
  .tile.ri { min-height: 224px; }   /* the smaller sheet needs less */
  .ri .rs { left: auto; right: var(--pad); width: 300px; transform-origin: top right; --rest: scale(0.8); --hover: scale(0.8) translateY(-6px); }   /* the whole sheet, smaller, rather than its cells cut short */   /* the words take a second line here, so the sheet starts lower, and the tile is narrower than the sheet */
}
/* Too narrow for the output list beside the editor, the file beside the sheet, or the updates beside the words: the
   list and the file go and the editor and sheet grow into their room, and the updates run across the tile under the words */
@media (min-width: 600px) and (max-width: 759px) {
  .ir { min-height: 272px; }   /* the taller editor */
  .ed { left: 290px; right: var(--pad); width: auto; min-width: 250px; }
  .ed-photo { height: 160px; }
  .rf { display: none; }
  .ri { min-height: 256px; }   /* no file under the sheet here */
  .rs { right: var(--pad); width: auto; }
}
/* Clean Paste's line takes two lines here too */
@media (min-width: 700px) and (max-width: 799px) {
  .sheet { top: 140px; }
}
@media (max-width: 759px) {
  .outs { display: none; }
  .now .wm { display: none; }   /* the notes fill the top of the tile here */
  .now { height: auto; }
  .now .clip { position: static; overflow: visible; }
  .upd { position: static; width: auto; margin: var(--jsal-space-8) 0 calc(var(--jsal-space-8) * -1); }   /* under the words; the last row's padding is the tile's */
}
/* One column (phones upright): each tile only as tall as its piece and words, each piece poking a little out of its
   tile as on desktop; no watermarks */
@media (max-width: 599px) {
  .grid > * { grid-column: 1 / -1 !important; }
  .hi { order: 1; }   /* one tile per row: Say hi after every tool, then Updates */
  .now { order: 2; }
  .wm { display: none; }
  .cms, .ir, .cp, .hi, .ri { min-height: 0; }
  .tile.cms { padding-bottom: 262px; }   /* style: allow (room for the brick under the words) */
  .pcs { left: 14px; top: 146px; --rest: rotate(-10deg) scale(0.6); --hover: var(--rest); }
  .fit-for { left: 20px; top: -12px; }   /* no room under the line here, so it pokes out of the tile's top */
  /* the editor and the sheet follow their words: the editor at the tile's full width, inside it, and the sheet
     centred, a negative margin taking back the room its scaling frees */
  .ir .clip { position: static; order: 1; overflow: visible; }
  .ed { position: relative; display: block; left: auto; top: auto; width: auto; margin: 18px 0 0; --rest: none; --hover: translateY(-6px); }   /* style: allow (a picture, drawn to its own measure) */
  .ed-photo { height: 170px; }
  .sheet { position: relative; left: auto; top: auto; margin: 26px auto -12px; width: min(258px, 100%); transform-origin: top center; --rest: rotate(-2deg) scale(0.9); --hover: rotate(-2deg) scale(0.9) translateY(-6px); }   /* style: allow (a picture, drawn to its own measure) */
  /* Redirect Import's sheet under its words, inside the tile, with all four rows; no file */
  .rs { position: relative; left: auto; top: auto; margin: 22px auto -8px; width: min(300px, 100%); }   /* style: allow (a picture, drawn to its own measure) */
  .rs .last { display: grid; }
  .rf { display: none; }
  .hi .txt { margin-top: 136px; }   /* style: allow (room for the draft) */
  .draft { left: 20px; right: 20px; width: auto; max-width: 340px; margin: 0 auto; transform-origin: top center; --rest: rotate(2deg) scale(0.9); --hover: rotate(2deg) scale(0.9) translateY(-6px); }
  .intro p { font-size: 17px; }
}
#updates, #hi-h { scroll-margin-top: 16px; }
/* Phones: a smaller title and tiles, one spacing step for the grid, and only the Updates link kept in the top bar
   (Email is in Say hi) */
/* The narrowest phones: a smaller brick, so it fits across the tile and the page never scrolls sideways */
@media (max-width: 374px) {
  .pcs { left: calc(50% - 130px); top: 170px; --rest: rotate(-10deg) scale(0.54); }   /* centred (275px across, its box starting 8px left of its corner) and under the line's two lines */
  .tile.cms { padding-bottom: 262px; }   /* style: allow (room for the brick) */
}
/* The narrowest phones: the sheet takes the tile's padding too, its addresses smaller, so every one shows whole */
@media (max-width: 389px) {
  .rs { width: calc(100% + 20px); margin-left: -10px; margin-right: -10px; padding-left: 10px; padding-right: 10px; }   /* style: allow (a picture, drawn to its own measure) */
  .rs-row { grid-template-columns: 12px 18px 1fr 1fr; gap: var(--jsal-space-8); }
  .rs-row .mono { font-size: 10px; }   /* style: allow (miniature) */
}
@media (max-width: 520px) {
  .jsal-top nav a:not([href="#updates"]) { display: none; }
  .grid { gap: var(--jsal-space-32); }
  .roles span + span::before { margin: 0 var(--jsal-space-8); }
  .intro h1 { font-size: 40px; }
  .tile { --pad: var(--jsal-space-20); }
  footer { margin-top: var(--jsal-space-32); }
}
/* Pointing at a tile (or focusing it) plays what its tool does three times; on touch screens once, the
   first time the tile comes into view (the script below sets .play). The CMS Picker's keys show what fits three needs
   in turn (one, picked at random, on touch screens), the crop box takes each size's shape in turn, the formatted text wipes into its HTML, the email types itself and the
   redirect sheet's rows are checked into their file. */
@media (prefers-reduced-motion: no-preference) {
  /* each need lights the keys the real quiz ranks first for it: a small shop, a paid newsletter, a startup that wants
     to design every detail; --fit-start skips ahead to one of them (2.7s each) */
  .cms:is(:hover, :focus-visible, .play) :is(.pc, .fit-for span) { animation: var(--k, fit-0) 8.1s ease-in-out var(--fit-start, 0s) both; }   /* style: allow (the home pictures play) */
  :is(.p-shopify, .p-bigcommerce, .p-square) { --k: fit-1; }
  :is(.p-ghost, .p-substack, .p-squarespace) { --k: fit-2; }
  :is(.p-framer, .p-webflow, .p-wix) { --k: fit-3; }
  .fit-for span:nth-child(1) { --k: fit-for-1; }
  .fit-for span:nth-child(2) { --k: fit-for-2; }
  .fit-for span:nth-child(3) { --k: fit-for-3; }
  /* each piece has its own keyframes rather than a delay, so every loop starts them all together; they stop on their
     third loop just before the rows fade (2.88 = the 88% keyframe), so they rest as shown */
  .ir:is(:hover, :focus-visible, .play) :is(.crop, .sizes span, .outs .row, .outs-head span) { animation: var(--k) 3.6s ease-in-out 2.88 both; }   /* style: allow (the home pictures play) */
  .crop { --k: ir-ar; }
  .sizes span:nth-child(1) { --k: ir-s1; }
  .sizes span:nth-child(2) { --k: ir-s2; }
  .sizes span:nth-child(3) { --k: ir-s3; }
  .outs .row:nth-child(2) { --k: ir-r1; }
  .outs .row:nth-child(3) { --k: ir-r2; }
  .outs .row:nth-child(4) { --k: ir-r3; }
  .outs-head span { --k: ir-pill; }
  .cp:is(:hover, :focus-visible, .play) :is(.tx, .sw span), .cp:is(:hover, :focus-visible, .play) .views::after, .cp:is(:hover, :focus-visible, .play) .sw::before { animation: var(--k) 3.4s ease-in-out 3 both; }   /* style: allow (the home pictures play) */
  .tx { --k: cp-tx; }
  .views::after { --k: cp-line; }
  .sw::before { --k: cp-thumb; }
  .sw .t { --k: cp-t; }
  .sw .h { --k: cp-h; }
  .hi:is(.play, :has(.hi-mail:is(:hover, :focus-visible))) .draft .body i { animation: hi-type 3.6s steps(41, end) 2.9 both; }   /* style: allow (the home pictures play) */
  .ri:is(:hover, :focus-visible, .play) :is(.rs .dot, .rs-note, .rf .ln:not(.mute)) { animation: var(--k) 3s ease-out 2.9 both; }   /* style: allow (the home pictures play) */
  .rs-row:nth-of-type(2) .dot { --k: ri-d1; }
  .rs-row:nth-of-type(3) .dot { --k: ri-d2; }
  .rs-row:nth-of-type(4) .dot { --k: ri-d3; }
  .rs-row:nth-of-type(5) .dot { --k: ri-d4; }
  .rs-row:nth-of-type(7) .dot { --k: ri-d5; }
  .rs-note { --k: ri-note; }
  .rf .ln:nth-child(2) { --k: ri-f1; }
  .rf .ln:nth-child(3) { --k: ri-f2; }
  .rf .ln:nth-child(4) { --k: ri-f3; }
}
/* CMS Picker: three needs of 2.3s, a 0.4s pause after each with every key back up */
@keyframes fit-0 { 0% { opacity: 1; filter: none; translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 3%, 26% { opacity: 0.25; filter: saturate(0.2); translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 29%, 33% { opacity: 1; filter: none; translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 36%, 59% { opacity: 0.25; filter: saturate(0.2); translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 62%, 66% { opacity: 1; filter: none; translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 69%, 92% { opacity: 0.25; filter: saturate(0.2); translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 95%, 100% { opacity: 1; filter: none; translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } }
@keyframes fit-1 { 0% { opacity: 1; filter: none; translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 3%, 26% { opacity: 1; filter: none; translate: 0 7px; box-shadow: var(--key-sheen), 0 3px 0 var(--edge), var(--key-drop-low), 0 0 0 3px var(--jsal-fill); } 29%, 33% { opacity: 1; filter: none; translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 36%, 59% { opacity: 0.25; filter: saturate(0.2); translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 62%, 66% { opacity: 1; filter: none; translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 69%, 92% { opacity: 0.25; filter: saturate(0.2); translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 95%, 100% { opacity: 1; filter: none; translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } }
@keyframes fit-2 { 0% { opacity: 1; filter: none; translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 3%, 26% { opacity: 0.25; filter: saturate(0.2); translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 29%, 33% { opacity: 1; filter: none; translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 36%, 59% { opacity: 1; filter: none; translate: 0 7px; box-shadow: var(--key-sheen), 0 3px 0 var(--edge), var(--key-drop-low), 0 0 0 3px var(--jsal-fill); } 62%, 66% { opacity: 1; filter: none; translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 69%, 92% { opacity: 0.25; filter: saturate(0.2); translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 95%, 100% { opacity: 1; filter: none; translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } }
@keyframes fit-3 { 0% { opacity: 1; filter: none; translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 3%, 26% { opacity: 0.25; filter: saturate(0.2); translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 29%, 33% { opacity: 1; filter: none; translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 36%, 59% { opacity: 0.25; filter: saturate(0.2); translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 62%, 66% { opacity: 1; filter: none; translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } 69%, 92% { opacity: 1; filter: none; translate: 0 7px; box-shadow: var(--key-sheen), 0 3px 0 var(--edge), var(--key-drop-low), 0 0 0 3px var(--jsal-fill); } 95%, 100% { opacity: 1; filter: none; translate: 0 0; box-shadow: var(--key-sheen), 0 10px 0 var(--edge), var(--key-drop); } }
@keyframes fit-for-1 { 0%, 0% { opacity: 0; translate: 0 6px; } 3%, 26% { opacity: 1; translate: 0 0; } 29%, 100% { opacity: 0; translate: 0 0; } }
@keyframes fit-for-2 { 0%, 33% { opacity: 0; translate: 0 6px; } 36%, 59% { opacity: 1; translate: 0 0; } 62%, 100% { opacity: 0; translate: 0 0; } }
@keyframes fit-for-3 { 0%, 66% { opacity: 0; translate: 0 6px; } 69%, 92% { opacity: 1; translate: 0 0; } 95%, 100% { opacity: 0; translate: 0 0; } }
/* Image Resizer: wide, square, then 640 × 420, each size's button picked as the box takes its shape and its file landing
   in the list; back to wide by 78%, before the one play on touch screens stops */
@keyframes ir-ar { 0%, 18% { --ar: 1.91; } 28%, 44% { --ar: 1; } 54%, 68% { --ar: 1.524; } 78%, 100% { --ar: 1.91; } }
@keyframes ir-s1 { 0%, 20%, 76%, 100% { border-color: var(--jsal-fill); background: var(--jsal-accent-soft); color: var(--jsal-accent); } 26%, 70% { border-color: var(--jsal-line); background: transparent; color: var(--jsal-ink); } }
@keyframes ir-s2 { 0%, 20%, 50%, 100% { border-color: var(--jsal-line); background: transparent; color: var(--jsal-ink); } 26%, 44% { border-color: var(--jsal-fill); background: var(--jsal-accent-soft); color: var(--jsal-accent); } }
@keyframes ir-s3 { 0%, 46%, 76%, 100% { border-color: var(--jsal-line); background: transparent; color: var(--jsal-ink); } 52%, 70% { border-color: var(--jsal-fill); background: var(--jsal-accent-soft); color: var(--jsal-accent); } }
@keyframes ir-r1 { 0%, 3% { opacity: 0; translate: -8px 0; } 12%, 88% { opacity: 1; translate: 0 0; } 100% { opacity: 0; translate: 0 0; } }
@keyframes ir-r2 { 0%, 30% { opacity: 0; translate: -8px 0; } 39%, 88% { opacity: 1; translate: 0 0; } 100% { opacity: 0; translate: 0 0; } }
@keyframes ir-r3 { 0%, 56% { opacity: 0; translate: -8px 0; } 65%, 88% { opacity: 1; translate: 0 0; } 100% { opacity: 0; translate: 0 0; } }
@keyframes ir-pill { 0%, 68% { opacity: 0; } 74%, 88% { opacity: 1; } 100% { opacity: 0; } }
/* Clean Paste, from the rest and back to it by 84% (where the one play on touch screens stops): the line moves
   right to show all the text (Text picked), sweeps left wiping it all into HTML (HTML picked), then returns to rest; it
   hides at the edges, and the switch's gold follows it */
@keyframes cp-tx { 0% { clip-path: inset(0 46% 0 0); } 14%, 30% { clip-path: inset(0); } 56%, 70% { clip-path: inset(0 100% 0 0); } 84%, 100% { clip-path: inset(0 46% 0 0); } }
@keyframes cp-line { 0% { left: 54%; opacity: 1; } 13% { left: 100%; opacity: 1; } 15%, 29% { left: 100%; opacity: 0; } 31% { left: 100%; opacity: 1; } 56% { left: 0; opacity: 1; } 58%, 69% { left: 0; opacity: 0; } 71% { left: 0; opacity: 1; } 84%, 100% { left: 54%; opacity: 1; } }
@keyframes cp-thumb { 0% { left: calc(54% + 3px); } 13%, 31% { left: calc(100% + 3px); } 56%, 71% { left: 3px; } 84%, 100% { left: calc(54% + 3px); } }
@keyframes cp-t { 0% { color: var(--jsal-muted); } 10%, 31% { color: var(--jsal-selected-ink); } 40%, 100% { color: var(--jsal-muted); } }
@keyframes cp-h { 0% { color: var(--jsal-selected-ink); } 10%, 31% { color: var(--jsal-muted); } 40%, 100% { color: var(--jsal-selected-ink); } }
@keyframes hi-type { 0% { clip-path: inset(0 100% 0 0); } 55%, 90% { clip-path: inset(0 0 0 0); opacity: 1; } 100% { clip-path: inset(0 0 0 0); opacity: 0; } }
/* Redirect Import: the rows are checked one at a time and each ready row's line lands in the file just after (the full
   address with the site's own domain left off); the row with a space gets its "!" and note and adds nothing, and the row left out its dash.
   All held to 97%, past where the one play on touch screens stops, then cleared for the next loop */
@keyframes ri-d1 { 0%, 4% { scale: 0; } 10% { scale: 1.25; } 14%, 97% { scale: 1; } 100% { scale: 0; } }
@keyframes ri-f1 { 0%, 12% { opacity: 0; translate: -10px 0; } 20%, 97% { opacity: 1; translate: 0 0; } 100% { opacity: 0; } }
@keyframes ri-d2 { 0%, 22% { scale: 0; } 28% { scale: 1.25; } 32%, 97% { scale: 1; } 100% { scale: 0; } }
@keyframes ri-f2 { 0%, 30% { opacity: 0; translate: -10px 0; } 38%, 97% { opacity: 1; translate: 0 0; } 100% { opacity: 0; } }
