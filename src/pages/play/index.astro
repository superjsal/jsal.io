<script is:inline>
document.getElementById('y').textContent = new Date().getFullYear();
// Backpack: hovering, focusing or tapping an item shows its tooltip. On a touch screen the first tap
// inspects, the second uses it. Using a social unlocks "Social butterfly".
const ITEMS = {
  email: { q: 'legendary', name: 'Sealed Letter of Inquiry', kind: 'Email · dev@jsal.io', use: 'Opens an email to me.', flavor: 'Questions, ideas for a tool, or just to talk SEO.' },
  discord: { q: 'epic', name: 'Amulet of Many Voices', kind: 'Discord · jsal', use: 'Copies my username.', flavor: 'Add me and say hi.' },
  steam: { q: 'rare', name: 'Aegis of the Backlog', kind: 'Steam · jsalx87', use: 'Opens my Steam profile.', flavor: 'Friend requests welcome.' },
  github: { q: 'uncommon', name: 'Tome of Open Source', kind: 'GitHub · superjsal', use: 'Opens the code behind these tools.', flavor: 'Every tool here, page by page.' },
  lantern: { q: 'rare', name: 'Lantern of the Night Owl', kind: 'Light or dark', use: 'Switches between light and dark.', flavor: 'For late raids and later bug fixes.' },
  watch: { q: 'uncommon', name: 'Pocket Watch of Recent Changes', kind: 'Changelog', use: 'Shows everything that changed, newest first.', flavor: 'Always a little ahead.' },
  hearth: { q: 'common', name: 'Hearthstone', bind: 'Binds when picked up', kind: 'jsal.io', use: 'Returns you to the top of the page.', flavor: 'Home is just a scroll away.' },
};
const PACK = Object.keys(ITEMS), SOCIAL = ['email', 'discord', 'steam', 'github'];
// Each achievement's trophy, dropped into the Trophies bag when it's earned
const TROPHIES = {
  first: { icon: 'inv_boots_03', q: 'uncommon', name: 'Worn Leather Boots', flavor: 'Every adventure starts with one step.' },
  explorer: { icon: 'inv_misc_spyglass_02', q: 'rare', name: 'Explorer’s Spyglass', flavor: 'Saw every tool from up here.' },
  night: { icon: 'ability_eyeoftheowl', q: 'rare', name: 'Eye of the Owl', flavor: 'Sees fine in the dark theme.' },
  pixel: { icon: 'inv_misc_gem_01', q: 'uncommon', name: 'Perfectly Cut Gem', flavor: 'Every facet the same size.' },
  spotless: { icon: 'inv_fabric_silk_01', q: 'uncommon', name: 'Bolt of Spotless Silk', flavor: 'Not a stray tag on it.' },
  decision: { icon: 'inv_misc_key_04', q: 'rare', name: 'Key That Fits', flavor: 'Opens exactly one door. Yours.' },
  compare: { icon: 'inv_misc_dice_01', q: 'uncommon', name: 'Fair Dice', flavor: 'Compared, not left to chance.' },
  twocents: { icon: 'inv_misc_coin_05', q: 'common', name: 'Two Copper Coins', flavor: 'Worth exactly what you think.' },
  opinion: { icon: 'inv_misc_eye_02', q: 'uncommon', name: 'Eye of Second Sight', flavor: 'Looked twice before choosing.' },
  share: { icon: 'inv_misc_horn_03', q: 'uncommon', name: 'Herald’s Horn', flavor: 'Heard from three zones away.' },
  batch: { icon: 'inv_crate_03', q: 'rare', name: 'Crate of Even Sizes', flavor: 'Ten in, ten out, none uploaded.' },
  blocks: { icon: 'inv_misc_scrollrolled04', q: 'uncommon', name: 'Scroll of Clean Blocks', flavor: 'Ready for the editor.' },
  social: { icon: 'inv_misc_flower_02', q: 'uncommon', name: 'Friendly Daisy', flavor: 'Butterflies love these.' },
  lost: { icon: 'inv_misc_questionmark', q: 'epic', name: 'Mark of the Lost', flavor: 'Page not found. You were.' },
  inspector: { icon: 'inv_misc_bag_07', q: 'epic', name: 'Inspector’s Satchel', flavor: 'You looked in every pocket.' },
  persistent: { icon: 'inv_gauntlets_04', q: 'epic', name: 'Gauntlet of Persistence', flavor: 'Ten clicks. Not one more.' },
  secret: { icon: 'inv_gizmo_02', q: 'legendary', name: 'Contraption of Secrets', flavor: 'You know the rest of the code.' },
  complete: { icon: 'inv_crown_01', q: 'legendary', name: 'Crown of the Completionist', flavor: 'Nothing left to unlock. For now.' },
};
const SPARE = { icon: 'inv_misc_bag_10', q: 'common', flavor: 'A keepsake.' };   // an achievement with no trophy of its own yet
// New loot glows until it's inspected; what's been seen is kept in this browser
const NEW = ['lantern', 'watch'];
const seen = new Set((() => { try { return JSON.parse(localStorage.getItem('jsal-bag-seen')) || []; } catch (e) { return []; } })());
const isNew = (id) => (NEW.includes(id) || id.startsWith('t-')) && !seen.has(id);
document.querySelectorAll('#bag-pack .slot[data-item]').forEach((sl) => sl.classList.toggle('new', isNew(sl.dataset.item)));
// "Bag inspector" (a secret): every item in the backpack looked at, on one visit
const inspected = new Set();
const bag = document.querySelector('.bag'), tip = document.getElementById('tip');
let shown = null, touch = false;
function inspect(sl) {
  const id = sl.dataset.item, i = ITEMS[id];
  document.querySelectorAll('.slot.on').forEach((x) => x.classList.remove('on'));
  sl.classList.add('on');
  shown = sl;
  inspected.add(id);
  if (PACK.every((k) => inspected.has(k)) && window.jsalAchieve) jsalAchieve('inspector');
  if (sl.classList.contains('new')) {
    sl.classList.remove('new');
    seen.add(id);
    try { localStorage.setItem('jsal-bag-seen', JSON.stringify([...seen])); } catch (e) {}
  }
  tip.innerHTML = `<div class="t" style="color: var(--q-${i.q})">${i.name}</div><div class="w">${i.bind || 'Binds when used'}</div><div class="s">${i.kind}</div>${i.use ? `<div class="u">Use: ${i.use}</div>` : ''}${i.ach ? `<div class="u">Achievement: ${i.ach}</div>` : ''}<div class="f">"${i.flavor}"</div>`;
  tip.hidden = false;
  // Below the item, or above it when the bag is too short (phones), kept inside the bag's width
  const b = bag.getBoundingClientRect(), r = sl.getBoundingClientRect();
  const left = Math.min(Math.max(r.left - b.left, 8), b.width - tip.offsetWidth - 8);
  const below = r.bottom - b.top + 12;
  tip.style.left = left + 'px';
  tip.style.top = (below + tip.offsetHeight <= b.height ? below : r.top - b.top - tip.offsetHeight - 12) + 'px';
}
function hide() { clearTimeout(hideTimer); tip.hidden = true; shown = null; document.querySelectorAll('.slot.on').forEach((x) => x.classList.remove('on')); }
// WCAG 1.4.13: the tooltip stays while the pointer moves from an item onto it (a short grace period), and
// Esc closes it without moving focus
let hideTimer = 0;
const hideSoon = () => { clearTimeout(hideTimer); hideTimer = setTimeout(hide, 200); };
tip.addEventListener('pointerenter', () => clearTimeout(hideTimer));
tip.addEventListener('pointerleave', (e) => { if (e.pointerType !== 'touch') { clearTimeout(handTimer); hideSoon(); } });
// The tooltip can cover other items: resting on one through it (or clicking there) switches to that item
let handTimer = 0;
const itemUnder = (e) => document.elementsFromPoint(e.clientX, e.clientY).find((x) => x.matches('.slot:not(.empty)') && x !== shown);
tip.addEventListener('pointermove', (e) => {
  clearTimeout(handTimer);
  const sl = itemUnder(e);
  if (sl) handTimer = setTimeout(() => inspect(sl), 250);
});
tip.addEventListener('click', (e) => { const sl = itemUnder(e); if (sl) { clearTimeout(handTimer); inspect(sl); } });
document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && shown) hide(); });
// Floating text over an item, as the game shows it
function float(sl, text, err) {
  const b = bag.getBoundingClientRect(), r = sl.getBoundingClientRect();
  const f = document.createElement('span');
  f.className = err ? 'float err' : 'float';
  f.setAttribute('aria-hidden', 'true');
  f.textContent = text;
  f.style.left = (r.left - b.left + r.width / 2) + 'px';
  f.style.top = (r.top - b.top - 20) + 'px';
  bag.append(f);
  setTimeout(() => f.remove(), 1400);
}
function bindSlot(sl) {
  sl.addEventListener('pointerdown', (e) => { touch = e.pointerType === 'touch'; });
  sl.addEventListener('pointerenter', (e) => { if (e.pointerType !== 'touch') { clearTimeout(hideTimer); inspect(sl); } });
  sl.addEventListener('pointerleave', (e) => { if (e.pointerType !== 'touch') hideSoon(); });
  sl.addEventListener('focus', () => inspect(sl));
  sl.addEventListener('blur', hide);
  sl.addEventListener('click', async (e) => {
    if (touch && shown !== sl) { e.preventDefault(); inspect(sl); return; }
    const id = sl.dataset.item;
    if (id === 'hearth') { hearth(sl); return; }
    if (id === 'lantern') { document.querySelector('[data-jsal-theme]').click(); return; }
    if (SOCIAL.includes(id) && window.jsalAchieve) jsalAchieve('social');
    if (id === 'discord') {
      let ok = true;
      try { await navigator.clipboard.writeText('jsal'); } catch (err) { ok = false; }
      inspect(sl);
      tip.querySelector('.u').textContent = ok ? 'Copied: jsal' : 'Username: jsal';
      if (ok) float(sl, 'Copied!');
    }
  });
}
document.querySelectorAll('#bag-pack .slot:not(.empty)').forEach(bindSlot);
document.addEventListener('pointerdown', (e) => { if (shown && !e.target.closest('.slot, #tip')) hide(); });
// The bag bar: two tabs, switched by click or the arrow keys
const tabs = [...document.querySelectorAll('.bagtab')];
function pick(t) {
  hide();
  tabs.forEach((x) => {
    const on = x === t;
    x.setAttribute('aria-selected', on);
    x.tabIndex = on ? 0 : -1;
    document.getElementById(x.getAttribute('aria-controls')).inert = !on;
  });
}
tabs.forEach((t, n) => {
  t.addEventListener('click', () => pick(t));
  t.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
    const next = tabs[(n + 1) % tabs.length];
    pick(next);
    next.focus();
  });
});
// The legendary letter shimmers once, when the bag first comes into view
if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
  const letter = document.querySelector('[data-item="email"]');
  const io = new IntersectionObserver((es) => {
    if (!es[0].isIntersecting) return;
    io.disconnect();
    letter.classList.add('shine');
    setTimeout(() => letter.classList.remove('shine'), 1300);
  }, { threshold: 0.6 });
  io.observe(bag);
}
// Hearthstone: a cast bar fills, the page goes back to the top, and the stone is on cooldown for a few seconds
const cast = document.getElementById('cast');
let cooling = false;
function hearth(sl) {
  if (!cast.hidden) return;
  if (cooling) { float(sl, 'Item is not ready yet.', true); return; }
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  hide();
  cast.hidden = false;
  cast.classList.add('go');
  setTimeout(() => {
    cast.hidden = true;
    cast.classList.remove('go');
    scrollTo({ top: 0, behavior: calm ? 'auto' : 'smooth' });
    cooling = true;
    sl.classList.add('cd');
    setTimeout(() => { cooling = false; sl.classList.remove('cd'); }, 10000);
  }, calm ? 300 : 1500);
}
// Trophies: a slot for each achievement, rounded up to whole rows; each earned one holds its trophy, in the
// order of the list
const when = (t) => new Date(t).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
function drawPouch(A, got) {
  const pouch = document.getElementById('bag-pouch'), earned = A.list.filter((a) => got[a.id]);
  const cols = getComputedStyle(pouch).gridTemplateColumns.split(' ').length, total = Math.ceil(A.list.length / cols) * cols;
  document.getElementById('pouch-count').textContent = `${earned.length}/${A.list.length}`;
  if (shown && pouch.contains(shown)) hide();
  pouch.innerHTML = earned.map((a) => {
    const t = TROPHIES[a.id] || { ...SPARE, name: a.name }, id = `t-${a.id}`;
    ITEMS[id] = { q: t.q, name: t.name, bind: 'Trophy', kind: `Earned ${when(got[a.id])}`, ach: a.name, flavor: t.flavor };
    return `<button class="slot${isNew(id) ? ' new' : ''}" type="button" style="--q: var(--q-${t.q})" data-item="${id}" aria-label="${t.name}, for ${a.name}"><img src="/img/wow/${t.icon}.jpg" width="56" height="56" alt=""></button>`;
  }).join('') + '<span class="slot empty" aria-hidden="true"></span>'.repeat(total - earned.length);
  pouch.querySelectorAll('.slot:not(.empty)').forEach(bindSlot);
}
// Achievements: drawn from /nav.js's list (it loads after this, so wait for it), redrawn on each unlock. Each sits
// under the tool it's earned in; one not listed here goes under Around the site, and every secret under Secrets.
const GROUP = { decision: 'cms', compare: 'cms', twocents: 'cms', opinion: 'cms', share: 'cms', pixel: 'ir', batch: 'ir', spotless: 'cp', blocks: 'cp' };
const GROUPS = [['cms', 'CMS Picker', '/img/icons/cms-picker.svg'], ['ir', 'Image Resizer', '/img/icons/image-resizer.svg'], ['cp', 'Clean Paste', '/img/icons/clean-paste.svg'], ['site', 'Around the site', '/img/icons/jsal-io.svg'], ['secret', 'Secrets']];
const LOCK = '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>';
const line = (p, s) => `<svg viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${p}</svg>`;
function drawAchievements() {
  const A = window.jsalAchievements;
  if (!A) return;
  const got = A.got(), n = A.list.filter((a) => got[a.id]).length;
  document.getElementById('ach-count').textContent = `${n} of ${A.list.length}`;
  document.getElementById('ach-bar').style.setProperty('--p', String(n / A.list.length));
  drawPouch(A, got);
  const where = (a) => (a.secret ? 'secret' : GROUP[a.id] || 'site');
  document.getElementById('ach-list').innerHTML = GROUPS.map(([k, name, img]) => {
    const xs = A.list.filter((a) => where(a) === k);
    if (!xs.length) return '';
    const g = xs.filter((a) => got[a.id]).length;
    return `<div class="ach-grp"><h3>${img ? `<img src="${img}" alt="" width="20" height="20">` : `<span class="lk">${line(LOCK, 13)}</span>`}${name}<span class="n">${g}/${xs.length}<span class="sr-only"> earned</span></span></h3><ul>${xs.map((a) => {
      const on = !!got[a.id], hidden = a.secret && !on;
      return `<li class="${on ? '' : 'locked'}"><span class="medal">${line(hidden ? LOCK : a.icon, 18)}</span><span><b>${hidden ? 'Secret' : a.name}</b><small>${on ? a.done : hidden ? 'Find it somewhere on the site' : a.todo}</small></span><span class="sr-only">${on ? ' (unlocked)' : ' (locked)'}</span></li>`;
    }).join('')}</ul></div>`;
  }).join('');
}
addEventListener('DOMContentLoaded', drawAchievements);
addEventListener('jsal-achievement', drawAchievements);
addEventListener('pageshow', drawAchievements);   // back from a tool: show what was unlocked there
</script>
</Page>
