</div>
<script is:inline>
// The list becomes tabs: a row shows its part's stage in place, and the arrow keys move along the list. The address
// keeps the choice (#pick-gear, which names no element, so opening the page on a part doesn't scroll down to it).
(() => {
  const list = document.querySelector('.slots'), tabs = [...list.querySelectorAll('.slot')], stages = [...document.querySelectorAll('.stage')];
  list.setAttribute('role', 'tablist');
  const wide = matchMedia('(min-width: 1280px)');
  const orient = () => list.setAttribute('aria-orientation', wide.matches ? 'vertical' : 'horizontal');
  orient(); wide.addEventListener('change', orient);
  stages.forEach((s, i) => { s.setAttribute('role', 'tabpanel'); s.setAttribute('aria-labelledby', tabs[i].id); });
  let cur = 0, rest = 0;
  const pick = (i, focus) => {
    cur = i;
    tabs.forEach((t, j) => { t.setAttribute('aria-selected', i === j ? 'true' : 'false'); t.tabIndex = i === j ? 0 : -1; });
    stages.forEach((s, j) => s.classList.toggle('on', i === j));
    if (focus) tabs[i].focus();
    // on a phone the list is a dock that slides sideways: bring the chosen part into it
    if (list.scrollWidth > list.clientWidth) list.scrollLeft = tabs[i].offsetLeft - 20;
  };
  tabs.forEach((t, i) => {
    t.setAttribute('role', 'tab'); t.setAttribute('aria-controls', stages[i].id);
    t.addEventListener('click', (e) => { e.preventDefault(); pick(i); history.replaceState(history.state, '', i ? `#pick-${stages[i].id}` : location.pathname + location.search); });
    t.addEventListener('keydown', (e) => {
      const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
      if (step) { e.preventDefault(); pick((i + step + tabs.length) % tabs.length, true); }
      if (e.key === ' ') { e.preventDefault(); pick(i); }
    });
  });
  // The mouse wheel over the list steps through it, one part a notch; past either end the page scrolls as usual
  list.addEventListener('wheel', (e) => {
    const to = cur + Math.sign(e.deltaY);
    if (e.ctrlKey || Math.abs(e.deltaY) <= Math.abs(e.deltaX) || to < 0 || to >= tabs.length) return;
    e.preventDefault();
    if (e.timeStamp < rest) return;   // a trackpad sends a stream of small moves: one step, then a short rest
    rest = e.timeStamp + 220;
    tabs[to].click();
  }, { passive: false });
  const at = stages.findIndex((s) => `#pick-${s.id}` === location.hash);
  pick(at < 0 ? 0 : at);
})();
// The scroll reveal: blocks below the fold wait, then rise into place once a sixth of them is in view; the numbers
// follow one another along their row.
if (matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window) {
  const groups = [['.numbers > div', 0.08], ['.band', 0], ['.little', 0], ['.install', 0]];
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    e.target.classList.add('in');
    io.unobserve(e.target);
  }), { threshold: 0.16 });
  for (const [sel, step] of groups) {
    document.querySelectorAll(sel).forEach((el, i) => {
      if (el.getBoundingClientRect().top < innerHeight) return;   // already on screen: shown as it is
      if (step) el.style.setProperty('--d', `${(i % 3) * step}s`);
      el.classList.add('rv');
      io.observe(el);
    });
  }
}
// The clips: each plays while a third of its frame is on screen and stops when it leaves, downloading only then
// (the frame, not the video, as phones show only a corner of the video). Its button says what a press does (Pause
// or Play), and a pause holds until the visitor plays it again. With reduced motion nothing starts by itself; Play
// still works. A page loaded ahead waits until it's shown.
function clips() {
  const calm = !matchMedia('(prefers-reduced-motion: no-preference)').matches;
  const watch = 'IntersectionObserver' in window && new IntersectionObserver((es) => es.forEach((e) => {
    const v = e.target.querySelector('video');
    if (e.isIntersecting && !v.dataset.held) v.play().catch(() => {});
    else if (!e.isIntersecting && !v.paused) v.pause();
  }), { threshold: 0.33 });
  document.querySelectorAll('.clip video').forEach((v) => {
    const btn = v.parentElement.querySelector('.clip-ctl button');
    const say = () => {
      btn.textContent = v.paused ? 'Play' : 'Pause';
      btn.setAttribute('aria-label', `${btn.textContent} the ${btn.dataset.name} clip`);
    };
    v.addEventListener('play', say);
    v.addEventListener('pause', say);
    say();
    btn.addEventListener('click', () => {
      if (v.paused) { delete v.dataset.held; v.play().catch(() => {}); }
      else { v.dataset.held = '1'; v.pause(); }
    });
    if (calm) v.dataset.held = '1';
    if (watch) watch.observe(v.parentElement);
  });
}
if (document.prerendering) document.addEventListener('prerenderingchange', clips, { once: true });
else clips();
</script>
</Page>
