<script is:inline>
// The list becomes tabs: a row shows its part's stage in place, and the arrow keys move along the list. The address
// keeps the choice (#pick-gear, which names no element, so opening the page on a part doesn't scroll down to it).
(() => {
  const list = document.querySelector('.slots'), tabs = [...list.querySelectorAll('.slot')], stages = [...document.querySelectorAll('.stage')];
  list.setAttribute('role', 'tablist');
  const wide = matchMedia('(min-width: 1280px)');
  const orient = () => list.setAttribute('aria-orientation', wide.matches ? 'vertical' : 'horizontal');
  orient(); wide.addEventListener('change', orient);
  stages.forEach((s, i) => { s.setAttribute('role', 'tabpanel'); s.setAttribute('aria-labelledby', tabs[i].id); });
  let cur = 0, rest = 0, live = false;
  const box = document.querySelector('.stages');
  // One gem for the whole list: it slides to the chosen row, half a turn each trip, and lands with a ring
  const gem = list.appendChild(Object.assign(document.createElement('i'), { className: 'gem' }));
  gem.setAttribute('aria-hidden', 'true');
  let turns = 0;
  const place = (i, moved) => {
    gem.style.setProperty('--y', `${tabs[i].offsetTop + tabs[i].offsetHeight / 2 - 6}px`);
    if (!moved) return;
    gem.style.setProperty('--r', `${45 + 180 * ++turns}deg`);
    gem.classList.remove('land'); void gem.offsetWidth; gem.classList.add('land');
  };
  addEventListener('resize', () => place(cur));
  // one height for every part: the tallest, measured at this width (not on a phone, where the parts are a list)
  const roomy = matchMedia('(min-width: 600px) and (not ((max-height: 500px) and (orientation: landscape)))');
  const fit = () => {
    box.style.minHeight = '';
    if (!roomy.matches) return;
    let tall = 0;
    stages.forEach((s) => { s.classList.add('measure'); tall = Math.max(tall, s.offsetHeight); s.classList.remove('measure'); });
    box.style.minHeight = `${Math.ceil(tall)}px`;
  };
  let soon = 0;
  const refit = () => { cancelAnimationFrame(soon); soon = requestAnimationFrame(fit); };
  addEventListener('resize', refit);
  addEventListener('load', refit);
  document.fonts?.ready.then(refit);
  const pick = (i, focus) => {
    // after the first, a pick says which way the list moved, so the new stage's parts arrive from there
    if (live && i !== cur) { box.style.setProperty('--dir', i < cur ? -1 : 1); box.classList.add('live'); }
    place(i, live && i !== cur);
    cur = i;
    tabs.forEach((t, j) => { t.setAttribute('aria-selected', i === j ? 'true' : 'false'); t.tabIndex = i === j ? 0 : -1; });
    stages.forEach((s, j) => s.classList.toggle('on', i === j));
    if (focus) tabs[i].focus();
    // on a phone the list is a dock that slides sideways: bring the chosen part into it
    if (list.scrollWidth > list.clientWidth) list.scrollLeft = tabs[i].offsetLeft - 20;
  };
  // where the list opens in place (a phone, or one held sideways), a tapped row is brought to the top of the screen
  // with its part open under it
  const listed = matchMedia('(max-width: 599px), (max-height: 500px) and (orientation: landscape)');
  const bringUp = (i) => {
    if (!listed.matches) return;
    requestAnimationFrame(() => tabs[i].scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' }));
  };
  tabs.forEach((t, i) => {
    t.setAttribute('role', 'tab'); t.setAttribute('aria-controls', stages[i].id);
    t.addEventListener('click', (e) => { e.preventDefault(); pick(i); bringUp(i); history.replaceState(history.state, '', i ? `#pick-${stages[i].id}` : location.pathname + location.search); });
    t.addEventListener('keydown', (e) => {
      const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
      if (step) { e.preventDefault(); pick((i + step + tabs.length) % tabs.length, true); }
      if (e.key === ' ') { e.preventDefault(); pick(i); }
    });
  });
  // The mouse wheel over the list steps through it, one part a notch; past either end the page scrolls as usual
  list.addEventListener('wheel', (e) => {
    const to = cur + Math.sign(e.deltaY);
    if (e.ctrlKey || Math.abs(e.deltaY) <= Math.abs(e.deltaX) || to < 0 || to >= tabs.length) return;
    e.preventDefault();
    if (e.timeStamp < rest) return;   // a trackpad sends a stream of small moves: one step, then a short rest
    rest = e.timeStamp + 220;
    tabs[to].click();
  }, { passive: false });
  const at = stages.findIndex((s) => `#pick-${s.id}` === location.hash);
  pick(at < 0 ? 0 : at);
  live = true;
  // A first visit, on a wide screen, with motion welcome and nothing picked yet: the gem leans toward the next row
  try {
    if (wide.matches && matchMedia('(prefers-reduced-motion: no-preference)').matches && !localStorage.getItem('jsal-pick-hint')) {
      setTimeout(() => {
        if (box.classList.contains('live')) return;
        localStorage.setItem('jsal-pick-hint', '1');
        gem.classList.add('peek');
        gem.addEventListener('animationend', () => gem.classList.remove('peek'), { once: true });
      }, 1500);
    }
  } catch (e) {}
  // The tour: on a screen wide enough for the list beside or above the stage, with motion welcome, the parts take
  // turns by themselves, round and round. A part picked by hand ends it; Pause rests it; once it has ended, Play
  // the tour starts it again from the part that's showing.
  const pickEl = document.querySelector('.pick'), btn = document.querySelector('.tour-btn');
  if (matchMedia('(min-width: 700px) and (not ((max-height: 500px) and (orientation: landscape)))').matches && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const say = (label, pressed) => { btn.textContent = label; btn.setAttribute('aria-pressed', String(pressed)); };
    const end = () => { pickEl.classList.remove('tour', 'rested'); pickEl.classList.add('toured'); say('Play the tour', false); };
    const start = () => {
      pickEl.classList.add('tour');
      list.addEventListener('animationend', (e) => {
        if (!pickEl.classList.contains('tour') || e.animationName !== 'turn') return;
        pick((cur + 1) % tabs.length);
      });
      ['click', 'keydown', 'wheel'].forEach((type) => list.addEventListener(type, (e) => { if (e.isTrusted) end(); }, { capture: true }));
      btn.addEventListener('click', () => {
        // after it has ended: round again, starting from what's showing
        if (pickEl.classList.contains('toured')) { pickEl.classList.remove('toured'); pickEl.classList.add('tour'); say('Pause the tour', false); return; }
        const resting = pickEl.classList.toggle('rested');
        pickEl.classList.toggle('tour', !resting);
        say(resting ? 'Play the tour' : 'Pause the tour', resting);
      });
      // a sixth in view counts: on a phone held sideways the list and stage are far taller than the screen
      const away = new IntersectionObserver(([e]) => pickEl.classList.toggle('away', !e.isIntersecting), { threshold: 0.15 });
      away.observe(pickEl);
    };
    if (document.prerendering) document.addEventListener('prerenderingchange', start, { once: true }); else start();
  }
})();
// The Pals stage: one pal's life, played with the addon's own pictures. A press hatches the egg, the next two
// grow it (gold motes gather into a ball of light, it changes underneath, the ball bursts), timed as the addon
// times them. The game steps from picture to picture; here each one melts into the next, the ball of light swells
// and breathes instead of flickering, and the pal lands with a small hop, so it reads as one smooth move. Nothing
// plays by itself; with reduced motion a press simply shows the next form.
(() => {
  const fig = document.querySelector('.family');
  if (!fig) return;
  const names = [...fig.querySelectorAll('li')], say = fig.querySelector('figcaption');
  const cv = document.createElement('canvas');
  // the scene in the art's pixels (on a phone, its middle, so the pal shows larger); where the pal stands; its size
  const W = matchMedia('(max-width: 599px)').matches ? 150 : 220, H = 100, X = (220 - W) / 2, CX = W / 2, CY = 60, S = 0.75;
  const btn = Object.assign(document.createElement('button'), { type: 'button', className: 'icon-btn go' });
  const box = Object.assign(document.createElement('div'), { className: 'pal' });
  cv.setAttribute('role', 'img');
  const scene = Object.assign(document.createElement('button'), { type: 'button', className: 'icon-btn' });
  // the buttons' icons, drawn as plain lines in the button's ink
  const ICON = {
    egg: '<path d="M10 3c3 0 5 4.5 5 8a5 5 0 0 1-10 0c0-3.5 2-8 5-8z"/>',
    grow: '<path d="M10 17v-6"/><path d="M10 11c0-3 2-5 5-5 0 3-2 5-5 5z"/><path d="M10 13c0-2.5-1.8-4-4.5-4 0 2.5 1.8 4 4.5 4z"/>',
    again: '<path d="M4 10a6 6 0 1 0 2-4.5"/><path d="M4 3v3.5h3.5"/>',
    scene: '<rect x="3" y="4" width="14" height="12" rx="2"/><path d="M3 13l4-4 3 3 2-2 5 5"/><circle cx="13.5" cy="7.5" r="1.2"/>',
  };
  const face = (b, icon, name) => {
    b.innerHTML = `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON[icon]}</svg>`;
    b.setAttribute('aria-label', name); b.title = name;
  };
  box.append(btn, scene); fig.classList.add('play');
  const pen = fig.closest('.stage').querySelector('.win');
  if (pen) pen.append(cv, box); else fig.prepend(cv, box);
  say.classList.add('on-pen'); box.append(say);
  cv.width = W; cv.height = H; cv.style.aspectRatio = `${W} / ${H}`;
  const ctx = cv.getContext('2d');
  const load = (src) => Object.assign(new Image(), { src });
  const SCENES = JSON.parse(fig.dataset.scenes), pics = {};
  let place = 0;
  const night = () => document.documentElement.dataset.theme === 'dark' || (document.documentElement.dataset.theme !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
  const backdrop = () => {
    const src = SCENES[place][night() ? 2 : 1];
    if (!pics[src]) { pics[src] = load(src); pics[src].addEventListener('load', () => draw()); }
    return pics[src];
  };
  const hatch = load(fig.dataset.hatch), light = load(fig.dataset.grow), bodies = [null, null, ...fig.dataset.forms.split(' ').map(load)];
  const SAY = ['A Toadstool egg.', 'It hatched: a Capling.', 'It grew into a Lanternshell.', 'Fully grown: a Bloomsage.'];
  const calm = matchMedia('(prefers-reduced-motion: reduce)');
  // frame and cell may sit between two pictures (3.7 is most of the way from the fourth to the fifth); lift and
  // size move the pal itself (a hop, a landing), swell sizes the ball of light
  let at = 0, busy = false, frame = 0, cell = -1, lift = 0, size = 1, swell = 1;
  // a picture holds for the first half of its time, then melts into the next
  const melt = (x) => { const t = Math.max(0, (x % 1) * 2 - 1); return t * t * (3 - 2 * t); };
  const hatchAt = (n, a) => { ctx.globalAlpha = a; ctx.drawImage(hatch, n * 96, 0, 96, 96, -48, -48, 96, 96); };
  const lightAt = (n, a) => { ctx.globalAlpha = a; ctx.drawImage(light, (n % 8) * 128, (n >> 3) * 128, 128, 128, -64, -64, 128, 128); };
  const draw = () => {
    ctx.imageSmoothingEnabled = false;
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, W, H);
    const bg = backdrop();
    if (bg.naturalWidth) ctx.drawImage(bg, X, 0, W, H, 0, 0, W, H);
    ctx.setTransform(size * S, 0, 0, size * S, CX, CY - lift);
    if (at < 2) {
      const n = Math.min(9, Math.floor(frame)), t = n < 9 ? melt(frame) : 0;
      hatchAt(n, 1 - t); if (t) hatchAt(n + 1, t);
    } else if (bodies[at].naturalWidth) {
      ctx.globalAlpha = 1;
      ctx.drawImage(bodies[at], -bodies[at].naturalWidth / 2, -bodies[at].naturalHeight / 2);
    }
    if (cell >= 0) {
      ctx.setTransform(swell * S, 0, 0, swell * S, CX, CY);
      const n = Math.min(15, Math.floor(cell)), t = n < 15 ? melt(cell) : 0;
      lightAt(n, 1 - t); if (t) lightAt(n + 1, t);
    }
    ctx.globalAlpha = 1;
  };
  // a soft landing: past the mark, back to it
  const settle = (x) => { const t = Math.min(1, Math.max(0, x)) - 1; return 1 + 2.7 * t * t * t + 1.7 * t * t; };
  const show = () => {
    names.forEach((n, i) => (i === at ? n.setAttribute('aria-current', 'step') : n.removeAttribute('aria-current')));
    face(btn, ['egg', 'grow', 'grow', 'again'][at], ['Hatch the egg', 'Grow', 'Grow', 'Start again'][at]);
    btn.disabled = false;
    cv.setAttribute('aria-label', SAY[at]);
    say.textContent = SAY[at];
    draw();
  };
  const run = (length, step, done) => {
    busy = true; btn.disabled = true;
    const from = performance.now();
    const tick = (now) => {
      const clock = (now - from) / 1000;
      step(Math.min(clock, length)); draw();
      if (clock < length) requestAnimationFrame(tick);
      else { busy = false; done(); show(); }
    };
    requestAnimationFrame(tick);
  };
  btn.addEventListener('click', () => {
    if (busy) return;
    if (at === 3) { at = 0; frame = 0; show(); return; }
    const next = at + 1;
    if (calm.matches) { at = next; frame = 9; show(); return; }
    if (at === 0) {
      btn.setAttribute('aria-label', 'Hatching…'); btn.title = 'Hatching…';
      // out of the shell by 1.8 seconds, then a small hop
      run(2.3, (c) => {
        frame = Math.min(9, c / 0.2);
        lift = c > 1.8 ? 7 * Math.sin(Math.PI * Math.min(1, (c - 1.8) / 0.45)) : 0;
      }, () => { at = 1; frame = 9; lift = 0; });
    } else {
      btn.setAttribute('aria-label', 'Growing…'); btn.title = 'Growing…';
      run(3.2, (c) => {
        // the ball gathers, holds while it breathes (the game flickers between two pictures here), then bursts
        cell = c < 1.4 ? c / 0.2 : c < 2 ? 7 : Math.min(15, 8 + (c - 2) / 0.12);
        swell = c >= 1.4 && c < 2 ? 1 + 0.045 * Math.sin((c - 1.4) / 0.3 * 2 * Math.PI) : 1;
        if (c >= 1.7) at = next;   // it's the new form once the light has closed over it
        size = c >= 2 ? 0.82 + 0.18 * settle((c - 2) / 0.6) : 1;   // and it lands as the light clears
      }, () => { cell = -1; at = next; size = 1; swell = 1; });
    }
  });
  [hatch, light, ...bodies.slice(2)].forEach((img) => img.addEventListener('load', draw));
  // a press moves the pal to the next scene; the theme switch turns day to night and back
  const named = () => face(scene, 'scene', `Change the scene (now ${SCENES[place][0]})`);
  scene.addEventListener('click', () => { place = (place + 1) % SCENES.length; named(); draw(); });
  named();
  new MutationObserver(() => draw()).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => draw());
  show();
})();
// The clips: each plays while a third of its frame is on screen and stops when it leaves, downloading only then
// (the frame, not the video, as phones show only a corner of the video). Its button says what a press does (Pause
// or Play), and a pause holds until the visitor plays it again. With reduced motion nothing starts by itself; Play
// still works. A page loaded ahead waits until it's shown.
function clips() {
  const calm = !matchMedia('(prefers-reduced-motion: no-preference)').matches;
  const watch = 'IntersectionObserver' in window && new IntersectionObserver((es) => es.forEach((e) => {
    const v = e.target.querySelector('video');
    if (e.isIntersecting && !v.dataset.held) v.play().catch(() => {});
    else if (!e.isIntersecting && !v.paused) v.pause();
  }), { threshold: 0.33 });
  document.querySelectorAll('.clip video').forEach((v) => {
    const btn = v.parentElement.querySelector('.clip-ctl button');
    const say = () => {
      btn.textContent = v.paused ? 'Play' : 'Pause';
      btn.setAttribute('aria-label', `${btn.textContent} the ${btn.dataset.name} clip`);
    };
    v.addEventListener('play', say);
    v.addEventListener('pause', say);
    say();
    btn.addEventListener('click', () => {
      if (v.paused) { delete v.dataset.held; v.play().catch(() => {}); }
      else { v.dataset.held = '1'; v.pause(); }
    });
    if (calm) v.dataset.held = '1';
    if (watch) watch.observe(v.parentElement);
  });
}
if (document.prerendering) document.addEventListener('prerenderingchange', clips, { once: true });
else clips();
</script>
</Page>
