---
// jsal.ui, John's free WoW Forever addon: what it does, where to get it and how to install it. The page is laid
// out like the addon's own dashboard (John, 20 Nov 2026, his pick of the "pick one" mockups): a list of its parts
// down the left (Home, then Plan, Craft and Play), and the chosen part's window on the stage beside it, in the
// addon's own font (Outfit) and the site's colours. Each part says whether it's for leveling or useful at any
// level. Under it: three numbers, the latest release, the Discord, the small helpers and Install. The parts, their
// words and windows are in src/lib/jsal-ui.mjs. The version line and the Latest release card read
// src/data/jsal-ui-release.json, which .github/workflows/jsal-ui-version.yml keeps on jsal.ui's latest release
// hourly. The addon's code and releases are on GitHub (superjsal/jsal-ui). First shipped at /jsal.ui/ and moved
// to /jsal-ui/ the same day to match the repo's name; site/_redirects sends the old address here.
import Page from "../../layouts/Page.astro";
import TopBar from "../../components/TopBar.astro";
import { v } from "../../lib/v.mjs";
import { HOME_PART, GROUPS, LITTLE } from "../../lib/jsal-ui.mjs";
import RELEASE from "../../data/jsal-ui-release.json";
const RELEASES = "https://github.com/superjsal/jsal-ui/releases/latest";
const ALL_RELEASES = "https://github.com/superjsal/jsal-ui/releases";
const REPO = "https://github.com/superjsal/jsal-ui";
// The same releases on the two addon stores, for their apps' one-click installs and updates.
const CURSEFORGE = "https://www.curseforge.com/wow/addons/jsal-ui";
const WAGO = "https://addons.wago.io/addons/jsal-ui";
// jsal.ui's Discord server, for bug reports, ideas and help: an invite that never expires.
const DISCORD = "https://discord.gg/BfUKeCjNeZ";
// The list: Home on its own, then each group's parts under the group's name
const LIST = [{ name: null, parts: [HOME_PART] }, ...GROUPS];
const ALL = LIST.flatMap((g) => g.parts);
// A part whose picture is narrow (the pals) sits beside its words; a wide window sits under them
const side = (p) => !p.clip && p.shot.w < 600;
const released = new Date(`${RELEASE.date}T12:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---
<Page
  title="jsal.ui: a free WoW Forever addon | jsal.io"
  description="jsal.ui is a free WoW Forever addon: your character in one dashboard. Training, talents, gear, dungeons and professions, plus a journal, guild crafting orders and daily games."
  path="/jsal-ui/"
  ogDescription="A free WoW Forever addon: your character in one dashboard. Training, talents, gear, dungeons and professions, with a journal and daily games for your guild."
  outfit
>
<style is:inline slot="head">
/* A window from the game keeps the addon's own dark in both themes; its shadow is softer on the light page */
:root {
  --win-fill: #191c23;
  --win-shadow: 0 24px 60px rgb(0 0 0 / 0.16), 0 2px 8px rgb(0 0 0 / 0.08);
  --f: "Outfit", "Segoe UI", system-ui, -apple-system, sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) { --win-shadow: 0 24px 60px rgb(0 0 0 / 0.55); }
}
:root[data-theme="dark"] { --win-shadow: 0 24px 60px rgb(0 0 0 / 0.55); }

* { box-sizing: border-box; }
body { margin: 0; color: var(--jsal-ink); font: 15px/1.6 var(--f); -webkit-font-smoothing: antialiased; }
.wrap { max-width: calc(var(--jsal-col) + 40px); margin: 0 auto; padding: 0 max(var(--jsal-gutter), env(safe-area-inset-right, 0px)) var(--jsal-page-end) max(var(--jsal-gutter), env(safe-area-inset-left, 0px)); }
h1, h2 { text-wrap: balance; }
p { text-wrap: pretty; }
main a:not(.jsal-btn, .slot) { color: var(--jsal-accent); text-underline-offset: 2px; }
a:focus-visible { outline: 2px solid var(--jsal-accent); outline-offset: 3px; border-radius: var(--jsal-radius); }
code { font: 500 13px "JetBrains Mono", Consolas, monospace; }

/* Top bar: the shared one (/shell.css), with section links, as on the home page */
.jsal-top nav { display: flex; gap: var(--jsal-space-2); font-size: 14px; }
.jsal-top nav a { padding: var(--jsal-space-8) var(--jsal-space-8); line-height: 20px; color: var(--jsal-muted); text-decoration: none; border-radius: var(--jsal-radius); }
.jsal-top nav a:hover { color: var(--jsal-ink); }
@media (pointer: coarse) {
  .jsal-top nav a { position: relative; }
  .jsal-top nav a::after { content: ""; position: absolute; inset: -4px 0; }   /* 36px drawn, 44px to tap */
}
/* The narrowest phones keep the bar on one row: Off the clock goes (the logo menu has it), Install stays */
@media (max-width: 339px) { .jsal-top nav a[href="/play/"] { display: none; } }

.eyebrow { margin: 0; font: 600 12px/1.5 var(--f); letter-spacing: 0.08em; text-transform: uppercase; color: var(--jsal-accent); }

/* Pick a part: the list on the left is the addon's own menu and never moves; the stage beside it is the chosen
   part, with its window from the game */
.pick { display: grid; grid-template-columns: 272px minmax(0, 1fr); align-items: start; margin-top: var(--jsal-page-top); }
/* The list runs to the stage's edge, so the chosen row joins its stage; everything else in the rail stops short */
.rail > :not(.slots) { margin-right: var(--jsal-space-24); }
.rail h1 { margin: 0; font: 700 30px/1.1 var(--f); letter-spacing: -0.02em; }
.rail h1 em { font-style: normal; color: var(--jsal-accent); }
.get { display: flex; flex-wrap: wrap; align-items: center; gap: var(--jsal-space-12); margin-top: var(--jsal-space-20); }
.jsal-btn.dl { min-height: 44px; padding: 0 var(--jsal-space-20); font: 700 15px/1 var(--f); }
.meta { flex: 1 1 100%; margin: 0; color: var(--jsal-muted); font-size: 13px; line-height: 1.45; }
.slots { margin-top: var(--jsal-space-24); }
.grp { margin: var(--jsal-space-16) 0 var(--jsal-space-4); color: var(--jsal-muted); font: 600 12px/1.5 var(--f); letter-spacing: 0.08em; text-transform: uppercase; }
.slot { display: flex; align-items: center; justify-content: space-between; gap: var(--jsal-space-8); position: relative; padding: var(--jsal-space-4) var(--jsal-space-20) var(--jsal-space-4) var(--jsal-space-12); border-radius: var(--jsal-radius-lg) 0 0 var(--jsal-radius-lg); color: inherit; text-decoration: none; transition: background-color var(--jsal-quick); }
.slot:hover { background: var(--jsal-sunk); }
.slot b { font: 600 15px/1.6 var(--f); }
.slot i { color: var(--jsal-muted); font: 600 12px/1.5 var(--f); font-style: normal; letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; }
/* The chosen part's row takes the stage's fill and runs into it as one piece, and the logo's gold gem marks it */
.slot[aria-selected="true"] { background: var(--jsal-sunk); }   /* style: allow (the chosen part's row is the same piece as its stage, so it wears the stage's fill) */
.slot[aria-selected="true"]::before { content: ""; position: absolute; left: -16px; top: 50%; width: 10px; height: 10px; background: var(--jsal-fill); translate: 0 -50%; rotate: 45deg; }   /* style: allow (the logo's gem as a marker beside the row, not a selected fill) */

/* A stage: the part's name very large, what it does, when it's useful, and its window. Without scripts every
   part's stage shows, one under the other. */
.stages { display: grid; gap: var(--jsal-space-24); min-width: 0; }
.stage { container-type: inline-size; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--jsal-space-24) var(--jsal-space-32); align-items: start; padding: var(--jsal-space-32); border-radius: 0 var(--jsal-radius-tile) var(--jsal-radius-tile) 0; background: var(--jsal-sunk); }
.ui-js .stage:not(.on) { display: none; }
.head { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--jsal-space-12); }
.stage h2 { margin: 0; font: 800 clamp(40px, 10cqi, 88px)/0.95 var(--f); letter-spacing: -0.03em; }   /* style: allow (the stage's name: the page's one very large line) */
.lv { padding: var(--jsal-pad-tag); border-radius: var(--jsal-radius-sm); background: var(--jsal-surface); color: var(--jsal-ink-2); font: 600 12px/1.5 var(--f); letter-spacing: 0.08em; text-transform: uppercase; }
.lead { margin: 0; font: 600 20px/1.3 var(--f); }
.lead + p { margin: var(--jsal-space-8) 0 0; color: var(--jsal-ink-2); }
.facts { display: grid; gap: var(--jsal-space-8); margin: 0; padding: 0; list-style: none; line-height: 1.4; }
.facts li { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: var(--jsal-space-12); }
.facts svg { width: 20px; height: 20px; color: var(--jsal-accent); }
/* A narrow window (the pals) sits beside its words; a wide one runs across the stage under them */
.stage.side { grid-template-columns: minmax(0, 5fr) minmax(0, 4fr); }
.stage.side .say { display: grid; gap: var(--jsal-space-24); }
.stage.side .win { grid-column: 2; }
.stage:not(.side) .win { grid-column: 1 / -1; }

/* A window from the game: straight, framed and lifted. A small one (the pals) keeps its own size, so it never blurs. */
.win { position: relative; margin: 0; }
.win :is(img, video) { display: block; width: 100%; max-width: var(--w); height: auto; margin-inline: auto; border: 1px solid var(--jsal-line-hi); border-radius: var(--jsal-radius-xl); background: var(--win-fill); box-shadow: var(--win-shadow); }
/* A clip plays in place of a still while it's on screen, and keeps a Pause button (in the dark theme's colours, on
   the game) in its corner, so nothing moves without a way to stop it */
.clip-ctl { position: absolute; right: var(--jsal-space-12); bottom: var(--jsal-space-12); z-index: 1; }

/* Three numbers under the stage */
.numbers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: var(--jsal-space-64) 0 0; border-bottom: 1px solid var(--jsal-line); }
.numbers div { padding: 0 var(--jsal-space-24) var(--jsal-space-32); }
.numbers div:first-child { padding-left: 0; }
.numbers div + div { border-left: 1px solid var(--jsal-line); }
.numbers dt { font: 700 30px/1.1 var(--f); }
.numbers dd { margin: var(--jsal-space-4) 0 0; color: var(--jsal-muted); }
.band h2:not(.eyebrow), .little h2, .install h2 { margin: 0; font: 700 24px/1.2 var(--f); letter-spacing: -0.01em; }

/* The latest release, and the Discord */
.band { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: var(--jsal-space-48); margin-top: var(--jsal-space-64); padding: var(--jsal-space-32); border-radius: var(--jsal-radius-xl); background: var(--jsal-surface); }
.ver { display: flex; align-items: baseline; gap: var(--jsal-space-12); margin: var(--jsal-space-8) 0 0; }
.ver b { font: 700 30px/1.1 var(--f); }
.tag { padding: var(--jsal-pad-tag); border-radius: var(--jsal-radius-pill); background: var(--jsal-fill); color: var(--jsal-on-fill); font: 600 12px/1.5 var(--f); letter-spacing: 0.06em; text-transform: uppercase; }
.when { margin: var(--jsal-space-4) 0 0; color: var(--jsal-muted); }
.band ul { margin: 0; padding-left: 1.2em; }
.band li + li { margin-top: var(--jsal-space-8); }
.more { margin: var(--jsal-space-16) 0 0; }
.band.discord { grid-template-columns: minmax(0, 1fr) auto; align-items: center; margin-top: var(--jsal-space-20); }
.band.discord p { margin: var(--jsal-space-4) 0 0; color: var(--jsal-ink-2); }

/* The small helpers, two columns of name and line */
.little, .install { margin-top: var(--jsal-space-64); }
.little > p { margin: var(--jsal-space-8) 0 var(--jsal-space-16); color: var(--jsal-ink-2); }
.little dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--jsal-space-48); margin: 0; }
.little dl div { padding: var(--jsal-space-12) 0; border-top: 1px solid var(--jsal-line); }
.little dt { font-weight: 600; }
.little dd { margin: 0; color: var(--jsal-ink-2); }

/* Install: a card with the steps, and the one question people ask beside them */
.install { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--jsal-space-48); padding: var(--jsal-space-32); border-radius: var(--jsal-radius-xl); background: var(--jsal-surface); }
.install h2 { margin-bottom: var(--jsal-space-12); }
.install h3 { margin: 0 0 var(--jsal-space-4); font: 700 17px/1.4 var(--f); }
.install p, .install li { color: var(--jsal-ink-2); }
.install code { overflow-wrap: anywhere; }   /* the AddOns folder's long path breaks on the narrowest phones */
.install ol { margin: 0 0 var(--jsal-flow); padding-left: 1.3em; }
.install li + li { margin-top: var(--jsal-space-8); }
.install p { margin: 0 0 var(--jsal-flow); }
.install > div > :last-child { margin-bottom: 0; }
.credit { margin: var(--jsal-space-16) 0 0; font-size: 13px; color: var(--jsal-muted); }

/* Scrolling down, each block rises a little and fades in as it comes into view; a part's window follows its words,
   and cards and numbers follow one another along the row. Only what starts below the fold waits (.rv), and only
   when the page's script runs and motion is welcome; printed, everything shows. */
.rv { opacity: 0; transform: translateY(var(--jsal-space-24)); }
.rv.in { opacity: 1; transform: none; transition: opacity 0.6s var(--jsal-ease-out) var(--d, 0s), transform 0.6s var(--jsal-ease-out) var(--d, 0s); }   /* style: allow (a scroll reveal: slower than a state change, so it reads as arriving) */
@media (prefers-reduced-motion: reduce) { .rv { opacity: 1; transform: none; } }
@media print { .rv { opacity: 1; transform: none; } }

/* A small laptop or a tablet: the headline and Download, then the list as rows of parts, then the stage */
@media (max-width: 1279px) {
  .pick { grid-template-columns: minmax(0, 1fr); gap: var(--jsal-space-24); }
  .rail > :not(.slots) { margin-right: 0; }
  .stage { border-radius: var(--jsal-radius-tile); }
  /* here the gem sits inside the row, before its name */
  .slot[aria-selected="true"]::before { position: static; flex: none; translate: none; }
  .slot { justify-content: flex-start; }
  .slots { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--jsal-space-4); }
  .grp { display: none; }
  .slot { padding: var(--jsal-space-8) var(--jsal-space-12); border: 1px solid var(--jsal-line); border-radius: var(--jsal-radius-lg); }
  .slot i { display: none; }
}
@media (max-width: 899px) {
  .install, .band { grid-template-columns: minmax(0, 1fr); gap: var(--jsal-space-24); }
  .little dl { grid-template-columns: minmax(0, 1fr); }
  .stage, .stage.side { grid-template-columns: minmax(0, 1fr); }
  .stage.side .win { grid-column: 1; }
}
/* Upright phones: the list becomes a dock that slides sideways and stays at the foot of the screen while the stage
   is in view. A whole window would be too small to read, so each shows its top corner at a readable size, cut off
   by its frame, past the dashboard's menu and title bar */
@media (max-width: 599px) {
  .pick { gap: var(--jsal-space-16); }
  .rail { display: contents; }
  .get { margin-top: 0; }
  .stages { order: 1; }
  .slots { order: 2; position: sticky; bottom: 0; z-index: 2; display: flex; gap: var(--jsal-space-4); overflow-x: auto; margin: 0 calc(var(--jsal-gutter) * -1); padding: var(--jsal-space-8) var(--jsal-gutter) max(var(--jsal-space-8), env(safe-area-inset-bottom, 0px)); background: var(--jsal-bg); border-top: 1px solid var(--jsal-line); }
  .slot { flex: none; min-height: 44px; }
  .stage { padding: var(--jsal-space-20); }
  .win:not(.narrow) { position: relative; overflow: hidden; aspect-ratio: 4 / 3; border: 1px solid var(--jsal-line-hi); border-radius: var(--jsal-radius-xl); background: var(--win-fill); box-shadow: var(--win-shadow); }
  .win.home { aspect-ratio: 4 / 5; }   /* taller, so Home's plans show under the trainer visit */
  .win:not(.narrow) :is(img, video) { width: var(--pw, 760px); max-width: none; margin: 0; border: 0; border-radius: 0; box-shadow: none; transform: translate(calc(var(--cx) * -1%), calc(var(--cy) * -1%)); }
  /* one card of three rows, each number in its own column so the words line up */
  .numbers { grid-template-columns: minmax(0, 1fr); margin-top: var(--jsal-space-48); padding: var(--jsal-space-4) var(--jsal-space-20); border: 0; border-radius: var(--jsal-radius-xl); background: var(--jsal-surface); }
  .numbers div { display: grid; grid-template-columns: 72px minmax(0, 1fr); align-items: baseline; gap: var(--jsal-space-12); padding: var(--jsal-space-12) 0; border-top: 1px solid var(--jsal-line); }
  .numbers div:first-child { border-top: 0; }
  .numbers dt { font-size: 24px; }
  .numbers div + div { border-left: 0; }
  .numbers dd { margin: 0; }
  .band.discord { grid-template-columns: minmax(0, 1fr); }
}
@media (max-width: 520px) {
  .install, .band { padding: var(--jsal-space-20); }
}
@media (prefers-reduced-motion: reduce) { .slot { transition: none; } }
</style>
<div class="wrap">
  <TopBar><nav aria-label="Sections"><a href="/play/" data-jsal-nav>Off the clock</a><a href="#install">Install</a></nav></TopBar>
<main>
  <!-- Pick a part: each row of the list is a link to its part's stage below; with scripts the rows become tabs and
       one stage shows at a time -->
  <div class="pick">
    <script is:inline>document.documentElement.classList.add('ui-js');</script>
    <div class="rail">
      <h1>Your WoW Forever character, <em>in one dashboard.</em></h1>
      <div class="get">
        <a class="jsal-btn primary dl" href={RELEASES}>Download jsal.ui</a>
        <a class="jsal-btn" href="#install">How to install</a>
        <p class="meta">Version {RELEASE.version} · free, with its code <a href={REPO}>on GitHub</a> · also on <a href={CURSEFORGE}>CurseForge</a> and <a href={WAGO}>Wago</a></p>
      </div>
      <div class="slots" aria-label="jsal.ui's parts">
        {LIST.map((g) => (
          <Fragment>
            {g.name && <p class="grp" aria-hidden="true">{g.name}</p>}
            {g.parts.map((p) => <a class="slot" href={`#${p.key}`} id={`tab-${p.key}`} aria-selected={p.key === "home" ? "true" : "false"}><b>{p.label}</b><i>{p.when === "any" ? "Any level" : "1 to 60"}</i></a>)}
          </Fragment>
        ))}
      </div>
    </div>
    <div class="stages">
      {ALL.map((p) => (
        <section class={`stage${side(p) ? " side" : ""}${p.key === "home" ? " on" : ""}`} id={p.key} aria-labelledby={`${p.key}-h`}>
          <div class="head">
            <h2 id={`${p.key}-h`}>{p.label}</h2>
            <span class="lv">{p.when === "any" ? "Useful at any level" : "For leveling, 1 to 60"}</span>
          </div>
          <div class="say">
            <div>
              <p class="lead">{p.name}</p>
              <p>{p.line}</p>
            </div>
            {side(p) && <ul class="facts">{p.points.map((x) => <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l3.8 3.8 8-8.6"/></svg><span>{x}</span></li>)}</ul>}
          </div>
          {!side(p) && <ul class="facts">{p.points.map((x) => <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l3.8 3.8 8-8.6"/></svg><span>{x}</span></li>)}</ul>}
          {p.clip ? (
            <figure class="win clip" style={`--w: ${p.clip.w}px; --pw: ${p.clip.pw}px; --cx: ${p.clip.cx}; --cy: ${p.clip.cy}`}>
              <video muted loop playsinline preload="none" poster={v(p.clip.poster)} width={p.clip.w} height={p.clip.h} aria-label={p.clip.alt}><source src={v(p.clip.src)} type="video/mp4"></video>
              <span class="clip-ctl jsal-dark"><button type="button" class="jsal-btn small" data-name={p.label}>Play</button></span>
            </figure>
          ) : (
            <figure class={`win${p.shot.w < 600 ? " narrow" : ""}${p.key === "home" ? " home" : ""}`} style={`--w: ${p.shot.w}px; --cx: ${p.shot.cx}; --cy: ${p.shot.cy}`}><img src={v(p.shot.src)} width={p.shot.w} height={p.shot.h} alt={p.shot.alt} loading={p.key === "home" ? "eager" : "lazy"} decoding="async"></figure>
          )}
        </section>
      ))}
    </div>
  </div>
    <dl class="numbers">
      <div><dt>36</dt><dd>parts, each with its own switch</dd></div>
      <div><dt>3</dt><dd>groups: Plan, Craft and Play</dd></div>
      <div><dt>100%</dt><dd>free, with no subscription</dd></div>
    </dl>
    <section class="band" aria-labelledby="release-h">
      <div>
        <h2 id="release-h" class="eyebrow">Latest release</h2>
        <p class="ver"><b>{RELEASE.version}</b><span class="tag">Latest</span></p>
        <p class="when">{released}</p>
      </div>
      <div>
        <ul>{RELEASE.notes.map((n) => <li>{n}</li>)}</ul>
        <p class="more"><a href={ALL_RELEASES}>Every release's notes</a></p>
      </div>
    </section>
    <section class="band discord" aria-labelledby="discord-h">
      <div>
        <h2 id="discord-h">Join the jsal.ui Discord</h2>
        <p>Bug reports, ideas and help, and the first word on what's coming.</p>
      </div>
      <a class="jsal-btn primary" href={DISCORD}>Join the Discord</a>
    </section>
    <section class="little" aria-labelledby="little-h">
      <h2 id="little-h">And the little things</h2>
      <p>Smaller helpers around the game, each with its own switch in Settings.</p>
      <dl>{LITTLE.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}</dl>
    </section>
    <section class="install" id="install" aria-labelledby="install-h">
      <div>
        <h2 id="install-h">Install</h2>
        <ol>
          <li><a href={RELEASES}>Download jsal.ui</a> and unzip it into <code>World of Warcraft\_forever_\Interface\AddOns</code>, so you have an <code>AddOns\jsalUI</code> folder. Or get it from <a href={CURSEFORGE}>CurseForge</a> or <a href={WAGO}>Wago</a>, whose apps keep it up to date.</li>
          <li>Log in, or restart the game if it was running, then type <code>/jsal</code> or click the minimap button.</li>
        </ol>
        <p>Every part has a switch in <code>/jsal settings</code>, so turn off anything you don't want. It works on its own, or alongside <a href="https://www.curseforge.com/wow/addons/ellesmereui">EllesmereUI</a> if you use it.</p>
      </div>
      <div>
        <h3>Is it really free?</h3>
        <p>Yes, all of it, with no subscription or Patreon tier. Its code is <a href={REPO}>on GitHub</a>.</p>
