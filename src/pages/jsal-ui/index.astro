<div class="wrap">
  <TopBar><nav aria-label="Sections"><a href="/play/" data-jsal-nav>Off the clock</a><a href="#install">Install</a></nav></TopBar>
<main>
  <!-- Pick a part: each row of the list is a link to its part's stage below; with scripts the rows become tabs and
       one stage shows at a time -->
  <header class="hello">
    <h1>From level 1 to raid night, <em>planned.</em></h1>
    <div>
      <div class="get">
        <a class="jsal-btn primary dl" href={RELEASES}>Download jsal.ui</a>
        <a class="jsal-btn" href="#install">How to install</a>
        <p class="meta"><a href={UPDATES}>Version {RELEASE.version}</a> · free, with its code <a href={REPO}>on GitHub</a> · also on <a href={CURSEFORGE}>CurseForge</a> and <a href={WAGO}>Wago</a> · For WoW Forever 1.60.1 · works on its own</p>
      </div>
    </div>
  </header>
  <div class="pick">
    <script is:inline>document.documentElement.classList.add('ui-js');</script>
    <div class="rail">
      <div class="slots" aria-label="jsal.ui's parts">
        {LIST.map((g) => (
          <Fragment>
            {g.name && <p class="grp" aria-hidden="true" style={`--o: ${ORDER[`g:${g.name}`]}`}>{g.name}</p>}
            {g.parts.map((p) => <a class="slot" style={`--o: ${ORDER[p.key]}`} href={`#${p.key}`} id={`tab-${p.key}`} aria-selected={p.key === "home" ? "true" : "false"}><b>{p.label}</b><i>{WHEN[p.when][0]}</i></a>)}
          </Fragment>
        ))}
      </div>
      <button class="jsal-btn small tour-btn" type="button" aria-pressed="false">Pause the tour</button>
    </div>
    <div class="stages">
      {ALL.map((p) => (
        <section class={`stage${side(p) ? " side" : ""}${p.key === "home" ? " on" : ""}`} style={`--o: ${ORDER[p.key] + 1}`} id={p.key} aria-labelledby={`${p.key}-h`}>
          <div class="head">
            <h2 id={`${p.key}-h`}>{p.label}</h2>
            <span class="lv">{WHEN[p.when][1]}</span>
          </div>
          <div class="say">
            <div>
              <p class="lead">{p.name}</p>
              <p>{p.line}</p>
              {PAGES[p.key] && <a class="to-page" href={`/jsal-ui/${p.key}/`}>{PAGES[p.key].more} <span aria-hidden="true">›</span></a>}
            </div>
            {side(p) && <ul class="facts">{p.points.map((x) => <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l3.8 3.8 8-8.6"/></svg><span>{x}</span></li>)}</ul>}
            {p.family && (
              <figure class="family" data-scenes={JSON.stringify(SCENES)} data-hatch={v(`/img/jsal-ui/pals/${p.family.hatch}.png`)} data-grow={v(`/img/jsal-ui/pals/${p.family.grow}.png`)} data-forms={p.family.forms.slice(2).map(([file]) => v(`/img/jsal-ui/pals/${file}.png`)).join(" ")}>
                <ol>{p.family.forms.map(([file, name, px]) => <li><img src={v(`/img/jsal-ui/pals/${file}.png`)} alt="" width={px * 2} height={px * 2} loading="lazy" decoding="async"><span>{name}</span></li>)}</ol>
                <figcaption aria-live="polite">{p.family.say}</figcaption>
              </figure>
            )}
          </div>
          {!side(p) && <ul class="facts">{p.points.map((x) => <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l3.8 3.8 8-8.6"/></svg><span>{x}</span></li>)}{PAGES[p.key] && <li class="to-page"><a href={`/jsal-ui/${p.key}/`}>{PAGES[p.key].more} <span aria-hidden="true">›</span></a></li>}</ul>}
          {p.family ? (
            <figure class="win pen" aria-label="The pal's pen"></figure>
          ) : p.clip ? (
            <figure class="win clip" style={`--w: ${p.clip.w}px; --pw: ${p.clip.pw}px; --cx: ${p.clip.cx}; --cy: ${p.clip.cy}`}>
              <video muted loop playsinline preload="none" poster={v(p.clip.poster)} width={p.clip.w} height={p.clip.h} aria-label={p.clip.alt}><source src={v(p.clip.src)} type="video/mp4"></video>
              <span class="clip-ctl jsal-dark"><button type="button" class="jsal-btn small" data-name={p.label}>Play</button></span>
            </figure>
          ) : (
            <figure class={`win${p.key === "home" ? " home" : ""}`} style={`--w: ${p.shot.w}px; --cx: ${p.shot.cx}; --cy: ${p.shot.cy}`}><img src={v(p.shot.src)} width={p.shot.w} height={p.shot.h} alt={p.shot.alt} loading={p.key === "home" ? "eager" : "lazy"} decoding="async"></figure>
          )}
