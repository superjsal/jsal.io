---
// jsal.ui, John's free WoW Forever addon: what it does, where to get it and how to install it. A product page
// after EllesmereUI's site (John, 18 Nov 2026: "make it look and feel more like ellesmereui.com", mockup D of two)
// in jsal.io's own type and gold: a dark stage of the game (one of John's screenshots, blurred and darkened so no
// chat or names can be read) with the words and the Home window on it; three numbers; five parts as big rows that
// swap sides, the rest as cards; the latest release; the Discord; the small helpers and Install. The parts, their
// words and windows are in src/lib/jsal-ui.mjs. The version line and the Latest release card read
// src/data/jsal-ui-release.json, which .github/workflows/jsal-ui-version.yml keeps on jsal.ui's latest release
// hourly. The addon's code and releases are on GitHub (superjsal/jsal-ui). First shipped at /jsal.ui/ and moved
// to /jsal-ui/ the same day to match the repo's name; site/_redirects sends the old address here.
import Page from "../../layouts/Page.astro";
import TopBar from "../../components/TopBar.astro";
import { v } from "../../lib/v.mjs";
import { HOME, GROUPS, LITTLE } from "../../lib/jsal-ui.mjs";
import RELEASE from "../../data/jsal-ui-release.json";
const RELEASES = "https://github.com/superjsal/jsal-ui/releases/latest";
const ALL_RELEASES = "https://github.com/superjsal/jsal-ui/releases";
const REPO = "https://github.com/superjsal/jsal-ui";
// The same releases on the two addon stores, for their apps' one-click installs and updates.
const CURSEFORGE = "https://www.curseforge.com/wow/addons/jsal-ui";
const WAGO = "https://addons.wago.io/addons/jsal-ui";
// jsal.ui's Discord server, for bug reports, ideas and help: an invite that never expires.
const DISCORD = "https://discord.gg/BfUKeCjNeZ";
// The five parts shown large, and the rest as cards; each keeps its group's name over it
const PARTS = Object.fromEntries(GROUPS.flatMap((g) => g.parts.map((p) => [p.key, { ...p, group: g.name }])));
const BIG = ["training", "gear", "professions", "journal", "pals"].map((k) => PARTS[k]);
const REST = ["build", "dungeons", "crafts", "profit", "games", "guild"].map((k) => PARTS[k]);
const win = (s) => `win${s.w < 600 ? " narrow" : ""}${s.menu ? " menu" : ""}`;
const released = new Date(`${RELEASE.date}T12:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
let row = 0;
---
<Page
  title="jsal.ui: a free WoW Forever addon | jsal.io"
  description="jsal.ui is a free WoW Forever addon that plans your road to 60: training, talents, gear, dungeons and professions in one dashboard, plus a journal, guild crafting orders and daily games."
  path="/jsal-ui/"
  ogDescription="A free WoW Forever addon: your road to 60, planned. Training, talents, gear, dungeons and professions in one dashboard, with a journal and daily games for your guild."
>
<style is:inline slot="head">
/* The stage keeps the game's own dark in both themes, so its words keep the dark theme's colours; the shadows
   under each window from the game */
:root {
  --stage-ink: #ece6d6; --stage-ink-2: #d6cfbd; --stage-gold: #e3b04b; --stage-base: #111318; --stage-edge: #3d424e;
  --win-fill: #191c23;
  --win-shadow: 0 24px 60px rgb(0 0 0 / 0.16), 0 2px 8px rgb(0 0 0 / 0.08);
  --stage-shadow: 0 30px 80px rgb(0 0 0 / 0.6);
  /* How far down the top bar reaches (shell.css: its padding above one 36px row), so the stage can start behind it */
  --bar-h: calc(40px - (36px - 18px * 1.65) / 2 + 36px);
}
@media (max-width: 520px) { :root { --bar-h: calc(var(--jsal-space-12) + 36px); } }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) { --win-shadow: 0 24px 60px rgb(0 0 0 / 0.55); }
}
:root[data-theme="dark"] { --win-shadow: 0 24px 60px rgb(0 0 0 / 0.55); }

* { box-sizing: border-box; }
body { margin: 0; color: var(--jsal-ink); font: 15px/1.6 var(--jsal-font); -webkit-font-smoothing: antialiased; }
.wrap { max-width: calc(var(--jsal-col) + 40px); margin: 0 auto; padding: 0 max(var(--jsal-gutter), env(safe-area-inset-right, 0px)) 0 max(var(--jsal-gutter), env(safe-area-inset-left, 0px)); }
.wrap.end { padding-bottom: var(--jsal-page-end); }
h1, h2 { text-wrap: balance; }
p { text-wrap: pretty; }
main a:not(.jsal-btn) { color: var(--jsal-accent); text-underline-offset: 2px; }
code { font: 500 13px "JetBrains Mono", Consolas, monospace; }

/* Top bar: the shared one (/shell.css), with section links, as on the home page */
.jsal-top nav { display: flex; gap: var(--jsal-space-2); font-size: 14px; }
.jsal-top nav a { padding: var(--jsal-space-8) var(--jsal-space-8); line-height: 20px; color: var(--jsal-muted); text-decoration: none; border-radius: var(--jsal-radius); }
.jsal-top nav a:hover { color: var(--jsal-ink); }
@media (pointer: coarse) {
  .jsal-top nav a { position: relative; }
  .jsal-top nav a::after { content: ""; position: absolute; inset: -4px 0; }   /* 36px drawn, 44px to tap */
}
/* The narrowest phones keep the bar on one row: Off the clock goes (the logo menu has it), Install stays */
@media (max-width: 339px) { .jsal-top nav a[href="/play/"] { display: none; } }

.eyebrow { margin: 0; font: 500 12px/1.5 "JetBrains Mono", Consolas, monospace; letter-spacing: 0.06em; text-transform: uppercase; color: var(--jsal-accent); }

/* The stage: the game behind, blurred and darkened, from the very top of the page, so the top bar sits on it; the
   bar and the stage both take the dark theme's colours in either theme (.jsal-dark), so the buttons read on the
   game too. The words and the Home window sit sharp on top. */
.topwrap { position: relative; z-index: 2; color: var(--jsal-ink); }
.stage { position: relative; margin-top: calc(var(--bar-h) * -1); padding: calc(var(--bar-h) + var(--jsal-space-48)) 0 var(--jsal-space-64); background: var(--stage-base) var(--stage-bg) center 30% / cover; color: var(--stage-ink); }
.stage::before { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(0 0 0 / 0.72) 0%, rgb(0 0 0 / 0.38) 45%, rgb(0 0 0 / 0.62) 100%); }
.stage > .wrap { position: relative; }
.stage-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: var(--jsal-space-48); align-items: start; }
/* The description starts level with the headline's first line: past the eyebrow and its gap */
.stage-head > div + div { padding-top: var(--jsal-space-32); }
.stage .eyebrow { color: var(--stage-gold); }
.stage h1 { margin: var(--jsal-space-12) 0 0; font: 700 46px/1.05 "Lora", Georgia, serif; letter-spacing: -0.02em; }
.stage h1 em { display: block; font-weight: 600; color: var(--stage-gold); }
.lead { margin: 0; font-size: 17px; color: var(--stage-ink-2); }
.actions { display: flex; flex-wrap: wrap; gap: var(--jsal-space-8); margin-top: var(--jsal-space-24); }
.meta { margin: var(--jsal-space-12) 0 0; font-size: 13px; color: var(--stage-ink-2); }
.stage .meta a { color: var(--stage-ink); }
.homewin { margin: var(--jsal-space-48) auto 0; max-width: 1040px; }
.homewin img { display: block; width: 100%; height: auto; border: 1px solid var(--stage-edge); border-radius: var(--jsal-radius-xl); box-shadow: var(--stage-shadow); }

/* Three numbers under the stage */
.numbers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: var(--jsal-space-40) 0 0; border-bottom: 1px solid var(--jsal-line); }
.numbers div { padding: 0 var(--jsal-space-24) var(--jsal-space-32); }
.numbers div:first-child { padding-left: 0; }
.numbers div + div { border-left: 1px solid var(--jsal-line); }
.numbers dt { font: 700 30px/1.1 "Lora", Georgia, serif; }
.numbers dd { margin: var(--jsal-space-4) 0 0; color: var(--jsal-muted); }

/* A window from the game: straight, framed and lifted. A small one (the pals) keeps its own size, so it never blurs. */
.win { position: relative; margin: 0; }
.win :is(img, video) { display: block; width: 100%; height: auto; border: 1px solid var(--jsal-line-hi); border-radius: var(--jsal-radius-xl); box-shadow: var(--win-shadow); }
.win.narrow img { max-width: var(--w); margin-inline: auto; }
/* A clip plays in place of a still while it's on screen, and keeps a Pause button (in the dark theme's colours, on
   the game) in its corner, so nothing moves without a way to stop it */
.clip-ctl { position: absolute; right: var(--jsal-space-12); bottom: var(--jsal-space-12); z-index: 1; }

/* A big part: its words beside its window, swapping sides each row */
.part { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: var(--jsal-space-48); align-items: center; padding: var(--jsal-space-48) 0; }
.part + .part { border-top: 1px solid var(--jsal-line); }
.part.flip { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); }
.part.flip .txt { order: 2; }
.label { margin: 0; font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--jsal-muted); }
.part h2 { margin: var(--jsal-space-8) 0 0; font: 700 30px/1.15 "Lora", Georgia, serif; letter-spacing: -0.01em; }
.part .txt > p:not(.label) { margin: var(--jsal-space-12) 0 0; font-size: 17px; color: var(--jsal-ink-2); }
.part ul { list-style: none; margin: var(--jsal-space-16) 0 0; padding: 0; }
.part li { position: relative; padding-left: var(--jsal-space-20); font-weight: 500; }
.part li + li { margin-top: var(--jsal-space-4); }
.part li::before { content: ""; position: absolute; left: 0; top: 0.6em; width: 8px; height: 8px; border-radius: 50%; background: var(--jsal-fill); }

/* The rest: cards, each ending in its window's top corner */
.rest { margin-top: var(--jsal-space-24); padding-top: var(--jsal-space-48); border-top: 1px solid var(--jsal-line); }
.rest > h2, .band h2:not(.eyebrow), .little h2, .install h2 { margin: 0; font: 700 24px/1.2 "Lora", Georgia, serif; }
.rest > p { margin: var(--jsal-space-8) 0 var(--jsal-space-24); color: var(--jsal-ink-2); }
.cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--jsal-space-20); }
.card { display: flex; flex-direction: column; overflow: hidden; padding: var(--jsal-space-20) var(--jsal-space-20) 0; border: 1px solid var(--jsal-line); border-radius: var(--jsal-radius-xl); background: var(--jsal-surface); }
.card h3 { margin: var(--jsal-space-4) 0 0; font: 700 17px/1.35 var(--jsal-font); }
.card > p:not(.label) { margin: var(--jsal-space-4) 0 var(--jsal-space-20); color: var(--jsal-ink-2); }
.card .crop { position: relative; overflow: hidden; flex: none; height: 210px; margin: auto calc(var(--jsal-space-20) * -1) 0; border-top: 1px solid var(--jsal-line-hi); background: var(--win-fill); }
/* Every crop starts at the page's own content, under the title bar and past the dashboard's menu (--cx, --cy) */
.card .crop :is(img, video) { position: absolute; left: 0; top: 0; width: 640px; max-width: none; height: auto; transform: translate(calc(var(--cx) * -1%), calc(var(--cy) * -1%)); }

/* The latest release, and the Discord */
.band { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: var(--jsal-space-48); margin-top: var(--jsal-space-64); padding: var(--jsal-space-32); border: 1px solid var(--jsal-line); border-radius: var(--jsal-radius-xl); background: var(--jsal-surface); }
.ver { display: flex; align-items: baseline; gap: var(--jsal-space-12); margin: var(--jsal-space-8) 0 0; }
.ver b { font: 700 30px/1.1 "Lora", Georgia, serif; }
.tag { padding: var(--jsal-pad-tag); border-radius: var(--jsal-radius-pill); background: var(--jsal-fill); color: var(--jsal-on-fill); font: 600 12px/1.5 var(--jsal-font); letter-spacing: 0.06em; text-transform: uppercase; }
.when { margin: var(--jsal-space-4) 0 0; color: var(--jsal-muted); }
.band ul { margin: 0; padding-left: 1.2em; }
.band li + li { margin-top: var(--jsal-space-8); }
.more { margin: var(--jsal-space-16) 0 0; }
.band.discord { grid-template-columns: minmax(0, 1fr) auto; align-items: center; margin-top: var(--jsal-space-20); }
.band.discord p { margin: var(--jsal-space-4) 0 0; color: var(--jsal-ink-2); }

/* The small helpers, two columns of name and line */
.little, .install { margin-top: var(--jsal-space-64); }
.little > p { margin: var(--jsal-space-8) 0 var(--jsal-space-16); color: var(--jsal-ink-2); }
.little dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--jsal-space-48); margin: 0; }
.little dl div { padding: var(--jsal-space-12) 0; border-top: 1px solid var(--jsal-line); }
.little dt { font-weight: 600; }
.little dd { margin: 0; color: var(--jsal-ink-2); }

/* Install: a card with the steps, and the one question people ask beside them */
.install { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--jsal-space-48); padding: var(--jsal-space-32); border: 1px solid var(--jsal-line); border-radius: var(--jsal-radius-xl); background: var(--jsal-surface); }
.install h2 { margin-bottom: var(--jsal-space-12); }
.install h3 { margin: 0 0 var(--jsal-space-4); font: 700 17px/1.4 var(--jsal-font); }
.install p, .install li { color: var(--jsal-ink-2); }
.install code { overflow-wrap: anywhere; }   /* the AddOns folder's long path breaks on the narrowest phones */
.install ol { margin: 0 0 var(--jsal-flow); padding-left: 1.3em; }
.install li + li { margin-top: var(--jsal-space-8); }
.install p { margin: 0 0 var(--jsal-flow); }
.install > div > :last-child { margin-bottom: 0; }
.credit { margin: var(--jsal-space-16) 0 0; font-size: 13px; color: var(--jsal-muted); }

/* Scrolling down, each block rises a little and fades in as it comes into view; a part's window follows its words,
   and cards and numbers follow one another along the row. Only what starts below the fold waits (.rv), and only
   when the page's script runs and motion is welcome; printed, everything shows. */
.rv { opacity: 0; transform: translateY(var(--jsal-space-24)); }
.rv.in { opacity: 1; transform: none; transition: opacity 0.6s var(--jsal-ease-out) var(--d, 0s), transform 0.6s var(--jsal-ease-out) var(--d, 0s); }   /* style: allow (a scroll reveal: slower than a state change, so it reads as arriving) */
@media (prefers-reduced-motion: reduce) { .rv { opacity: 1; transform: none; } }
@media print { .rv { opacity: 1; transform: none; } }

/* Under 900px: one column; each part's words over its window, two cards a row */
@media (max-width: 899px) {
  .stage-head, .part, .part.flip, .install, .band { grid-template-columns: minmax(0, 1fr); gap: var(--jsal-space-24); }
  .stage-head > div + div { padding-top: 0; }
  .part.flip .txt { order: 0; }
  .part { padding: var(--jsal-space-40) 0; }
  .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .little dl { grid-template-columns: minmax(0, 1fr); }
}
/* Upright phones: a whole window would be too small to read, so each shows its top corner at a readable size,
   cut off by its frame, past the dashboard's menu and title bar */
@media (max-width: 599px) {
  .stage { padding: calc(var(--bar-h) + var(--jsal-space-32)) 0 var(--jsal-space-40); }
  .homewin, .win:not(.narrow) { position: relative; overflow: hidden; aspect-ratio: 4 / 3; border: 1px solid var(--jsal-line-hi); border-radius: var(--jsal-radius-xl); background: var(--win-fill); box-shadow: var(--win-shadow); }
  .homewin { border-color: var(--stage-edge); }
  .homewin img, .win:not(.narrow) :is(img, video) { width: 760px; max-width: none; border: 0; border-radius: 0; box-shadow: none; transform: translate(calc(var(--cx) * -1%), calc(var(--cy) * -1%)); }
  .numbers { grid-template-columns: minmax(0, 1fr); border: 0; }
  .numbers div { display: flex; align-items: baseline; gap: var(--jsal-space-12); padding: var(--jsal-space-12) 0; border-bottom: 1px solid var(--jsal-line); }
  .numbers div + div { border-left: 0; }
  .numbers dd { margin: 0; }
  .cards, .band.discord { grid-template-columns: minmax(0, 1fr); }
}
@media (max-width: 520px) {
  .stage h1 { font-size: 40px; }
  .part h2 { font-size: 24px; }
  .install, .band { padding: var(--jsal-space-20); }
}
</style>
<div class="wrap topwrap jsal-dark">
  <TopBar><nav aria-label="Sections"><a href="/play/" data-jsal-nav>Off the clock</a><a href="#install">Install</a></nav></TopBar>
</div>
<main>
  <section class="stage jsal-dark" style={`--stage-bg: url(${v("/img/jsal-ui/ui/stage.webp")})`} aria-labelledby="top-h">
    <div class="wrap">
      <div class="stage-head">
        <div>
          <p class="eyebrow">jsal.ui · free for WoW Forever</p>
          <h1 id="top-h">Your road to 60, <em>planned.</em></h1>
          <div class="actions">
            <a class="jsal-btn primary" href={RELEASES}>Download jsal.ui</a>
            <a class="jsal-btn" href="#install">How to install</a>
          </div>
        </div>
        <div>
          <p class="lead">Training, talents, gear, dungeons and professions in one dashboard, with a journal of your adventure and daily games for your guild.</p>
          <p class="meta">Version {RELEASE.version} · free, with its code <a href={REPO}>on GitHub</a> · also on <a href={CURSEFORGE}>CurseForge</a> and <a href={WAGO}>Wago</a></p>
        </div>
      </div>
      <figure class="homewin" style={`--cx: ${HOME.cx}; --cy: ${HOME.cy}`}><img src={v(HOME.src)} width={HOME.w} height={HOME.h} alt={HOME.alt} decoding="async"></figure>
    </div>
  </section>
  <div class="wrap end">
    <dl class="numbers">
      <div><dt>36</dt><dd>parts, each with its own switch</dd></div>
      <div><dt>35</dt><dd>dungeons and raids, every boss's loot</dd></div>
      <div><dt>100%</dt><dd>free, with no subscription</dd></div>
    </dl>
    {BIG.map((p) => (
      <article class={`part${row++ % 2 ? " flip" : ""}`} aria-labelledby={`${p.key}-h`}>
        <div class="txt">
          <p class="label">{p.group} · {p.label}</p>
          <h2 id={`${p.key}-h`}>{p.name}</h2>
          <p>{p.line}</p>
          <ul>{p.points.map((x) => <li>{x}</li>)}</ul>
        </div>
        {p.clip ? (
          <figure class="win clip" style={`--w: ${p.clip.w}px; --cx: ${p.clip.cx}; --cy: ${p.clip.cy}`}>
            <video muted loop playsinline preload="none" poster={v(p.clip.poster)} width={p.clip.w} height={p.clip.h} aria-label={p.clip.alt}><source src={v(p.clip.src)} type="video/mp4"></video>
            <span class="clip-ctl jsal-dark"><button type="button" class="jsal-btn small" data-name={p.label}>Play</button></span>
          </figure>
        ) : (
          <figure class={win(p.shot)} style={`--w: ${p.shot.w}px; --cx: ${p.shot.cx}; --cy: ${p.shot.cy}`}><img src={v(p.shot.src)} width={p.shot.w} height={p.shot.h} alt={p.shot.alt} loading="lazy" decoding="async"></figure>
        )}
      </article>
    ))}
    <section class="rest" aria-labelledby="rest-h">
      <h2 id="rest-h">And there's more in the dashboard</h2>
      <p>Each one a page of its own, a click away from Home.</p>
      <div class="cards">
        {REST.map((p) => (
          <article class="card" aria-labelledby={`${p.key}-h`}>
            <p class="label">{p.group}</p>
            <h3 id={`${p.key}-h`}>{p.label}: {p.name.charAt(0).toLowerCase() + p.name.slice(1)}</h3>
            <p>{p.line}</p>
            {p.clip ? (
              <div class="crop clip" style={`--cx: ${p.clip.cx}; --cy: ${p.clip.cy}`}>
                <video muted loop playsinline preload="none" poster={v(p.clip.poster)} width={p.clip.w} height={p.clip.h} aria-label={p.clip.alt}><source src={v(p.clip.src)} type="video/mp4"></video>
                <span class="clip-ctl jsal-dark"><button type="button" class="jsal-btn small" data-name={p.label}>Play</button></span>
              </div>
            ) : (
              <div class="crop" style={`--cx: ${p.shot.cx}; --cy: ${p.shot.cy}`}><img src={v(p.shot.src)} width={p.shot.w} height={p.shot.h} alt={p.shot.alt} loading="lazy" decoding="async"></div>
            )}
          </article>
        ))}
      </div>
    </section>
    <section class="band" aria-labelledby="release-h">
      <div>
        <h2 id="release-h" class="eyebrow">Latest release</h2>
        <p class="ver"><b>{RELEASE.version}</b><span class="tag">Latest</span></p>
        <p class="when">{released}</p>
      </div>
      <div>
        <ul>{RELEASE.notes.map((n) => <li>{n}</li>)}</ul>
        <p class="more"><a href={ALL_RELEASES}>Every release's notes</a></p>
      </div>
    </section>
    <section class="band discord" aria-labelledby="discord-h">
      <div>
        <h2 id="discord-h">Join the jsal.ui Discord</h2>
        <p>Bug reports, ideas and help, and the first word on what's coming.</p>
      </div>
      <a class="jsal-btn" href={DISCORD}>Join the Discord</a>
    </section>
    <section class="little" aria-labelledby="little-h">
      <h2 id="little-h">And the little things</h2>
      <p>Smaller helpers around the game, each with its own switch in Settings.</p>
      <dl>{LITTLE.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}</dl>
    </section>
    <section class="install" id="install" aria-labelledby="install-h">
      <div>
        <h2 id="install-h">Install</h2>
        <ol>
          <li><a href={RELEASES}>Download jsal.ui</a> and unzip it into <code>World of Warcraft\_forever_\Interface\AddOns</code>, so you have an <code>AddOns\jsalUI</code> folder. Or get it from <a href={CURSEFORGE}>CurseForge</a> or <a href={WAGO}>Wago</a>, whose apps keep it up to date.</li>
          <li>Log in, or restart the game if it was running, then type <code>/jsal</code> or click the minimap button.</li>
        </ol>
        <p>Every part has a switch in <code>/jsal settings</code>, so turn off anything you don't want. It works on its own, or alongside <a href="https://www.curseforge.com/wow/addons/ellesmereui">EllesmereUI</a> if you use it.</p>
      </div>
      <div>
        <h3>Is it really free?</h3>
