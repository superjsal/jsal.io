---
// jsal.ui, John's free WoW Forever addon: what it does, where to get it and how to install it. A product page in the
// look of its store cards (John, 18 Nov 2026: mockup A of three, "a bit more professional" than the bento it
// replaced): the intro beside the Home window, then the parts in the stores' three groups (Plan, Craft, Play), one
// row each, its words beside a straight window from the game that swaps sides each row; then the small helpers and
// Install. The parts, their words and windows are in src/lib/jsal-ui.mjs. The addon's code and releases are on
// GitHub (superjsal/jsal-ui). First shipped at /jsal.ui/ and moved to /jsal-ui/ the same day to match the repo's
// name; site/_redirects sends the old address here. The "Version x.y.z" line below follows jsal.ui's latest release
// by itself: .github/workflows/jsal-ui-version.yml checks hourly.
import Page from "../../layouts/Page.astro";
import TopBar from "../../components/TopBar.astro";
import { v } from "../../lib/v.mjs";
import { HOME, GROUPS, LITTLE } from "../../lib/jsal-ui.mjs";
const RELEASES = "https://github.com/superjsal/jsal-ui/releases/latest";
const REPO = "https://github.com/superjsal/jsal-ui";
// The same releases on the two addon stores, for their apps' one-click installs and updates.
const CURSEFORGE = "https://www.curseforge.com/wow/addons/jsal-ui";
const WAGO = "https://addons.wago.io/addons/jsal-ui";
// jsal.ui's Discord server, for bug reports, ideas and help: an invite that never expires.
const DISCORD = "https://discord.gg/BfUKeCjNeZ";
// Every part in order, so the rows can swap sides down the whole page rather than within a group
let row = 0;
const win = (s) => `win${s.w < 600 ? " narrow" : ""}${s.menu ? " menu" : ""}`;
---
<Page
  title="jsal.ui: a free WoW Forever addon | jsal.io"
  description="jsal.ui is a free WoW Forever addon that plans your road to 60: training, talents, gear, dungeons and professions in one dashboard, plus a journal, guild crafting orders and daily games."
  path="/jsal-ui/"
  ogDescription="A free WoW Forever addon: your road to 60, planned. Training, talents, gear, dungeons and professions in one dashboard, with a journal and daily games for your guild."
>
<style is:inline slot="head">
/* The shadow under each window from the game */
:root { --win-shadow: 0 24px 60px rgb(20 14 6 / 0.18), 0 2px 8px rgb(20 14 6 / 0.08); }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) { --win-shadow: 0 24px 60px rgb(0 0 0 / 0.55); }
}
:root[data-theme="dark"] { --win-shadow: 0 24px 60px rgb(0 0 0 / 0.55); }

* { box-sizing: border-box; }
body { margin: 0; color: var(--jsal-ink); font: 15px/1.6 var(--jsal-font); -webkit-font-smoothing: antialiased; }
.wrap { max-width: calc(var(--jsal-col) + 40px); margin: 0 auto; padding: 0 max(var(--jsal-gutter), env(safe-area-inset-right, 0px)) var(--jsal-page-end) max(var(--jsal-gutter), env(safe-area-inset-left, 0px)); }
h1, h2 { text-wrap: balance; }
p { text-wrap: pretty; }
main a:not(.jsal-btn) { color: var(--jsal-accent); text-underline-offset: 2px; }
code { font: 500 13px "JetBrains Mono", Consolas, monospace; }

/* Top bar: the shared one (/shell.css), with section links, as on the home page */
.jsal-top nav { display: flex; gap: var(--jsal-space-2); font-size: 14px; }
.jsal-top nav a { padding: var(--jsal-space-8) var(--jsal-space-8); line-height: 20px; color: var(--jsal-muted); text-decoration: none; border-radius: var(--jsal-radius); }
.jsal-top nav a:hover { color: var(--jsal-ink); }
@media (pointer: coarse) {
  .jsal-top nav a { position: relative; }
  .jsal-top nav a::after { content: ""; position: absolute; inset: -4px 0; }   /* 36px drawn, 44px to tap */
}

.eyebrow { margin: 0; font: 500 12px/1.5 "JetBrains Mono", Consolas, monospace; letter-spacing: 0.06em; text-transform: uppercase; color: var(--jsal-accent); }

/* The intro beside the Home window, at the shared distance under the top bar */
.hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--jsal-space-48); align-items: start; margin-top: var(--jsal-page-top); }
.hero h1 { margin: var(--jsal-space-12) 0 0; font: 700 46px/1.05 "Lora", Georgia, serif; letter-spacing: -0.02em; }
.hero h1 em { font-weight: 600; color: var(--jsal-accent); }
.lead { margin: var(--jsal-space-16) 0 0; font-size: 17px; color: var(--jsal-ink-2); }
.lead strong { color: var(--jsal-ink); }
.actions { display: flex; flex-wrap: wrap; gap: var(--jsal-space-8); margin-top: var(--jsal-space-24); }
.meta { margin: var(--jsal-space-12) 0 0; font-size: 13px; color: var(--jsal-muted); }

/* A window from the game: straight, framed and lifted. A small one (the pals) keeps its own size, so it never blurs. */
.win { margin: 0; }
.win img { display: block; width: 100%; height: auto; border: 1px solid var(--jsal-line-hi); border-radius: var(--jsal-radius-xl); box-shadow: var(--win-shadow); }
.win.narrow img { max-width: var(--w); margin-inline: auto; }

/* Each group: its name and one line over a rule, then its parts */
.group { margin-top: var(--jsal-space-64); }
.group-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--jsal-space-4) var(--jsal-space-16); padding-bottom: var(--jsal-space-12); border-bottom: 1px solid var(--jsal-line); }
.group-head p:last-child { margin: 0; color: var(--jsal-muted); }

/* A part: its words beside its window, swapping sides each row */
.part { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: var(--jsal-space-48); align-items: center; padding: var(--jsal-space-48) 0; }
.part + .part { border-top: 1px solid var(--jsal-line); }
.part.flip { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); }
.part.flip .txt { order: 2; }
.label { margin: 0; font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--jsal-muted); }
.part h2 { margin: var(--jsal-space-8) 0 0; font: 700 30px/1.15 "Lora", Georgia, serif; letter-spacing: -0.01em; }
.part .txt > p:not(.label) { margin: var(--jsal-space-12) 0 0; font-size: 17px; color: var(--jsal-ink-2); }
.part ul { list-style: none; margin: var(--jsal-space-16) 0 0; padding: 0; }
.part li { position: relative; padding-left: var(--jsal-space-20); font-weight: 500; }
.part li + li { margin-top: var(--jsal-space-4); }
.part li::before { content: ""; position: absolute; left: 0; top: 0.6em; width: 8px; height: 8px; border-radius: 50%; background: var(--jsal-fill); }

/* The small helpers, two columns of name and line */
.little, .install { margin-top: var(--jsal-space-64); }
.little h2, .install h2 { margin: 0; font: 700 24px/1.2 "Lora", Georgia, serif; }
.little > p { margin: var(--jsal-space-8) 0 var(--jsal-space-16); color: var(--jsal-ink-2); }
.little dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--jsal-space-48); margin: 0; }
.little dl div { padding: var(--jsal-space-12) 0; border-top: 1px solid var(--jsal-line); }
.little dt { font-weight: 600; }
.little dd { margin: 0; color: var(--jsal-ink-2); }

/* Install: a card with the steps, and the one question people ask beside them */
.install { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--jsal-space-48); padding: var(--jsal-space-32); border: 1px solid var(--jsal-line); border-radius: var(--jsal-radius-xl); background: var(--jsal-surface); }
.install h2 { margin-bottom: var(--jsal-space-12); }
.install h3 { margin: 0 0 var(--jsal-space-4); font: 700 17px/1.4 var(--jsal-font); }
.install p, .install li { color: var(--jsal-ink-2); }
.install ol { margin: 0 0 var(--jsal-flow); padding-left: 1.3em; }
.install li + li { margin-top: var(--jsal-space-8); }
.install p { margin: 0 0 var(--jsal-flow); }
.install > div > :last-child { margin-bottom: 0; }
.credit { margin: var(--jsal-space-16) 0 0; font-size: 13px; color: var(--jsal-muted); }

/* Under 900px: one column, each part's words over its window */
@media (max-width: 899px) {
  .hero, .part, .part.flip, .install { grid-template-columns: minmax(0, 1fr); gap: var(--jsal-space-24); }
  .part.flip .txt { order: 0; }
  .part { padding: var(--jsal-space-40) 0; }
  .little dl { grid-template-columns: minmax(0, 1fr); }
}
/* Upright phones: a whole window would be too small to read, so each shows its top corner at a readable size,
   cut off by its frame; the dashboard's menu is skipped so the page itself shows */
@media (max-width: 599px) {
  .win:not(.narrow) { position: relative; overflow: hidden; aspect-ratio: 4 / 3; border: 1px solid var(--jsal-line-hi); border-radius: var(--jsal-radius-xl); background: var(--jsal-surface); box-shadow: var(--win-shadow); }
  .win:not(.narrow) img { width: 760px; max-width: none; border: 0; border-radius: 0; box-shadow: none; }
  .win.menu img { transform: translate(-17.8%, -5.2%); }   /* past the menu and the title bar */
}
@media (max-width: 520px) {
  .hero h1 { font-size: 40px; }
  .part h2 { font-size: 24px; }
  .install { padding: var(--jsal-space-20); }
}
</style>
<div class="wrap">
  <TopBar><nav aria-label="Sections"><a href="/play/" data-jsal-nav>Off the clock</a><a href="#install">Install</a></nav></TopBar>
  <main>
    <section class="hero" aria-labelledby="top-h">
      <div>
        <p class="eyebrow">Free for WoW Forever</p>
        <h1 id="top-h">jsal.<em>ui</em></h1>
        <p class="lead"><strong>Your road to 60, planned.</strong> Training, talents, gear, dungeons and professions in one dashboard, with a journal of your adventure and daily games for your guild.</p>
        <div class="actions">
          <a class="jsal-btn primary" href={RELEASES}>Download jsal.ui</a>
          <a class="jsal-btn" href="#install">How to install</a>
        </div>
        <p class="meta">Version 0.3.56 · free, with its code <a href={REPO}>on GitHub</a> · also on <a href={CURSEFORGE}>CurseForge</a> and <a href={WAGO}>Wago</a></p>
      </div>
      <figure class={win(HOME)}><img src={v(HOME.src)} width={HOME.w} height={HOME.h} alt={HOME.alt} decoding="async"></figure>
    </section>
    {GROUPS.map((g) => (
      <section class="group" id={g.key} aria-label={g.name}>
        <div class="group-head"><p class="eyebrow">{g.name}</p><p>{g.line}</p></div>
        {g.parts.map((p) => (
          <article class={`part${row++ % 2 ? " flip" : ""}`} aria-labelledby={`${p.key}-h`}>
            <div class="txt">
              <p class="label">{p.label}</p>
              <h2 id={`${p.key}-h`}>{p.name}</h2>
              <p>{p.line}</p>
              <ul>{p.points.map((x) => <li>{x}</li>)}</ul>
            </div>
            <figure class={win(p.shot)} style={`--w: ${p.shot.w}px`}><img src={v(p.shot.src)} width={p.shot.w} height={p.shot.h} alt={p.shot.alt} loading="lazy" decoding="async"></figure>
          </article>
        ))}
      </section>
    ))}
    <section class="little" aria-labelledby="little-h">
      <h2 id="little-h">And the little things</h2>
      <p>Smaller helpers around the game, each with its own switch in Settings.</p>
      <dl>{LITTLE.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}</dl>
    </section>
    <section class="install" id="install" aria-labelledby="install-h">
      <div>
        <h2 id="install-h">Install</h2>
        <ol>
          <li><a href={RELEASES}>Download jsal.ui</a> and unzip it into <code>World of Warcraft\_forever_\Interface\AddOns</code>, so you have an <code>AddOns\jsalUI</code> folder. Or get it from <a href={CURSEFORGE}>CurseForge</a> or <a href={WAGO}>Wago</a>, whose apps keep it up to date.</li>
          <li>Log in, or restart the game if it was running, then type <code>/jsal</code> or click the minimap button.</li>
        </ol>
        <p>Every part has a switch in <code>/jsal settings</code>, so turn off anything you don't want. It works on its own, or alongside <a href="https://www.curseforge.com/wow/addons/ellesmereui">EllesmereUI</a> if you use it.</p>
      </div>
      <div>
        <h3>Is it really free?</h3>
        <p>Yes, all of it, with no subscription or Patreon tier. Its code is <a href={REPO}>on GitHub</a>.</p>
        <p>Made by John Salvador. Bugs, questions or ideas: join <a href={DISCORD}>the jsal.ui Discord</a>, email <a href="mailto:dev@jsal.io">dev@jsal.io</a>, or use Report a problem inside the addon.</p>
      </div>
    </section>
    <p class="credit">Screenshots of World of Warcraft © Blizzard Entertainment. The pixel art of Jsal's Pals is jsal.ui's own.</p>
  </main>
</div>
</Page>
