---
// jsal.ui, John's free WoW Forever addon: what it does, where to get it and how to install it. The page is laid
// out like the addon's own dashboard (John, 20 Nov 2026, his pick of the "pick one" mockups): a list of its parts
// down the left (Home, then Plan, Craft and Play), and the chosen part's window on the stage beside it, in the
// addon's own font (Outfit) and the site's colours. Each part says whether it's for leveling or useful at any
// level. Under it: why I made it and what it is, the latest release, the Discord, the small helpers and Install. The parts, their
// words and windows are in src/lib/jsal-ui.mjs. The version line and the Latest release card read
// src/data/jsal-ui-release.json, which .github/workflows/jsal-ui-version.yml keeps on jsal.ui's latest release
// hourly. The addon's code and releases are on GitHub (superjsal/jsal-ui). First shipped at /jsal.ui/ and moved
// to /jsal-ui/ the same day to match the repo's name; site/_redirects sends the old address here.
import Page from "../../layouts/Page.astro";
import TopBar from "../../components/TopBar.astro";
import { v } from "../../lib/v.mjs";
import { HOME_PART, GROUPS, LITTLE, PAGES } from "../../lib/jsal-ui.mjs";
import RELEASE from "../../data/jsal-ui-release.json";
const RELEASES = "https://github.com/superjsal/jsal-ui/releases/latest";
// Every release's changes, on this site's updates page (src/pages/jsal-ui/updates.astro)
const UPDATES = "/jsal-ui/updates/";
const REPO = "https://github.com/superjsal/jsal-ui";
// The same releases on the two addon stores, for their apps' one-click installs and updates.
const CURSEFORGE = "https://www.curseforge.com/wow/addons/jsal-ui";
const WAGO = "https://addons.wago.io/addons/jsal-ui";
// jsal.ui's Discord server, for bug reports, ideas and help: an invite that never expires.
const DISCORD = "https://discord.gg/BfUKeCjNeZ";
// The list: Home on its own, then each group's parts under the group's name
const LIST = [{ name: null, parts: [HOME_PART] }, ...GROUPS];
const ALL = LIST.flatMap((g) => g.parts);
// When a part earns its keep, as its row and its stage say it
const WHEN = { leveling: ["1 to 60", "For leveling, 1 to 60"], sixty: ["At 60", "For level 60"], any: ["Any level", "Useful at any level"] };
// On a phone the list and the stages are laid out as one: a group's name, then each row with its stage under it
const ORDER = {};
LIST.reduce((k, g) => { if (g.name) ORDER[`g:${g.name}`] = k++; g.parts.forEach((p) => { ORDER[p.key] = k; k += 2; }); return k; }, 0);
// A part whose picture is narrow sits beside its words; a wide window sits under them (the pals have a wide live pen)
const side = (p) => !p.clip && !p.family && p.shot.w < 600;
// The pen scenes a pal can live in, from the addon's own art (site/img/jsal-ui/pals/): each by day and by night
const SCENES = ["meadow", "coast", "desert", "darkwood", "jungle", "savanna", "snow", "swamp"].map((s) => [s[0].toUpperCase() + s.slice(1), v(`/img/jsal-ui/pals/scene-${s}.png`), v(`/img/jsal-ui/pals/scene-${s}-night.png`)]);
// The scroll reveal for the blocks under the tour, a file of its own (site/jsal-ui/reveal.js), shared with the part pages
const REVEAL = v("/jsal-ui/reveal.js");
const released = new Date(`${RELEASE.date}T12:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---
<Page
  title="jsal.ui: a free WoW Forever addon | jsal.io"
  description="jsal.ui is a free WoW Forever addon that plans your character from level 1 to raid night: trainer visits, talents, gear, dungeons and professions in one dashboard, plus a journal, guild crafting orders and daily games."
  path="/jsal-ui/"
  ogImage="jsal-ui"
  ogImageAlt="Your WoW Forever character, in one dashboard: jsal.ui's Home window, with the character, the trainer visit and the plans"
  ogDescription="A free WoW Forever addon that plans your character from level 1 to raid night: trainer visits, talents, gear, dungeons and professions, with a journal and daily games for your guild."
>
<script is:inline slot="head" src={REVEAL} defer></script>
<style is:inline slot="head">
/* A window from the game keeps the addon's own dark in both themes; its shadow is softer on the light page */
:root {
  --win-fill: #191c23;
  --win-shadow: 0 24px 60px rgb(0 0 0 / 0.16), 0 2px 8px rgb(0 0 0 / 0.08);
  --f: "Outfit", "Segoe UI", system-ui, -apple-system, sans-serif;
  /* the cards' fill, as on Off the clock */
  --plain: #e6e8ec;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) { --win-shadow: 0 24px 60px rgb(0 0 0 / 0.55); --plain: #1c1f27; }
}
:root[data-theme="dark"] { --win-shadow: 0 24px 60px rgb(0 0 0 / 0.55); --plain: #1c1f27; }

* { box-sizing: border-box; }
body { margin: 0; color: var(--jsal-ink); font: 15px/1.6 var(--jsal-font); -webkit-font-smoothing: antialiased; }
.wrap { max-width: calc(var(--jsal-col) + 40px); margin: 0 auto; padding: 0 max(var(--jsal-gutter), env(safe-area-inset-right, 0px)) var(--jsal-page-end) max(var(--jsal-gutter), env(safe-area-inset-left, 0px)); }
h1, h2 { text-wrap: balance; }
p { text-wrap: pretty; }
/* Two fonts: Outfit (--f) for names, headings and buttons; Inter for everything that is read */
.get .jsal-btn, .band .jsal-btn, .little dt { font-family: var(--f); }
main a:not(.jsal-btn, .slot) { color: var(--jsal-accent); text-underline-offset: 2px; }
a:focus-visible { outline: 2px solid var(--jsal-accent); outline-offset: 3px; border-radius: var(--jsal-radius); }
code { font: 500 13px "JetBrains Mono", Consolas, monospace; }

/* Top bar: the shared one (/shell.css), with section links, as on the home page */
.jsal-top nav { display: flex; gap: var(--jsal-space-2); font-size: 14px; }
.jsal-top nav a { padding: var(--jsal-space-8) var(--jsal-space-8); line-height: 20px; color: var(--jsal-muted); text-decoration: none; border-radius: var(--jsal-radius); }
.jsal-top nav a:hover { color: var(--jsal-ink); }
@media (pointer: coarse) {
  .jsal-top nav a { position: relative; }
  .jsal-top nav a::after { content: ""; position: absolute; inset: -4px 0; }   /* 36px drawn, 44px to tap */
}
/* The narrowest phones keep the bar on one row: Off the clock goes (the logo menu has it), Install stays */
@media (max-width: 339px) { .jsal-top nav a[href="/play/"] { display: none; } }


/* Pick a part: the list on the left is the addon's own menu and never moves; the stage beside it is the chosen
   part, with its window from the game */
/* The page's promise leads, at the size of every page's title, with what jsal.ui is and how to get it beside it;
   under it the list and the stage */
/* The title with the download beside it, in one row, so the list and the stage start high on the first screen */
.hello { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--jsal-space-24) var(--jsal-space-32); margin-top: var(--jsal-page-top); }
.hello > div { flex: 0 1 28em; }
.hello h1 { flex: 0 1 auto; max-width: 13.5em; margin: 0; font: 700 46px/1.05 var(--f); letter-spacing: -0.02em; }
.hello h1 em { font-style: normal; color: var(--jsal-accent); }
/* Under the stage, a card: why I made it, beside the logo, and what it is in three facts, each with its icon */
.about { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--jsal-space-40); align-items: center; margin-top: var(--jsal-space-48); padding: var(--jsal-space-32); border-radius: var(--jsal-radius-tile); background: var(--plain); }
.why { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: var(--jsal-space-20); align-items: start; }
.why .jsal-mark { width: 56px; height: 56px; margin: 0; vertical-align: 0; }
.about h2 { margin: 0 0 var(--jsal-space-8); font: 700 24px/1.2 var(--f); letter-spacing: -0.01em; }
.why p { margin: 0; color: var(--jsal-ink-2); font-size: 15px; line-height: 1.6; }
.kit { display: grid; gap: var(--jsal-space-12); margin: 0; padding: 0; list-style: none; }
.kit li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: var(--jsal-space-12); align-items: center; }
.kit .i { display: grid; place-items: center; width: 44px; height: 44px; border-radius: var(--jsal-radius-lg); background: var(--jsal-surface); color: var(--jsal-accent); }
.kit b { display: block; font: 700 20px/1.1 var(--f); }
.kit small { color: var(--jsal-muted); font-size: 14px; }
@media (max-width: 899px) { .about { grid-template-columns: minmax(0, 1fr); gap: var(--jsal-space-24); } }
@media (max-width: 520px) { .about { padding: var(--jsal-space-20); } .why { grid-template-columns: minmax(0, 1fr); gap: var(--jsal-space-12); } .why .jsal-mark { width: 44px; height: 44px; } }
.pick { display: grid; grid-template-columns: 272px minmax(0, 1fr); margin-top: var(--jsal-space-32); }
.get { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: var(--jsal-space-12); }
.jsal-btn.dl { min-height: 44px; padding: 0 var(--jsal-space-20); font: 700 15px/1 var(--f); }
.meta { flex: 1 1 100%; margin: 0; color: var(--jsal-muted); font-size: 13px; line-height: 1.45; text-align: right; }
/* Below 1280px the download goes under the title, from the left */
@media (max-width: 1279px) { .get { justify-content: flex-start; } .meta { text-align: left; } }
.slots { margin-top: var(--jsal-space-8); }
.grp { margin: var(--jsal-space-16) 0 var(--jsal-space-4); color: var(--jsal-muted); font: 600 12px/1.5 var(--jsal-font); letter-spacing: 0.08em; text-transform: uppercase; }
.slot { display: flex; align-items: center; justify-content: space-between; gap: var(--jsal-space-8); position: relative; padding: var(--jsal-space-4) var(--jsal-space-20) var(--jsal-space-4) var(--jsal-space-12); border-radius: var(--jsal-radius-lg) 0 0 var(--jsal-radius-lg); color: inherit; text-decoration: none; transition: background-color var(--jsal-quick); }
.slot:hover { background: var(--jsal-sunk); }
.slot b { font: 600 15px/1.6 var(--f); }
.slot i { color: var(--jsal-muted); font: 600 12px/1.5 var(--jsal-font); font-style: normal; letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; }
/* The chosen part's row takes the stage's fill and runs into it as one piece, and the logo's gold gem marks it */
.slot[aria-selected="true"] { background: var(--jsal-sunk); }   /* style: allow (the chosen part's row is the same piece as its stage, so it wears the stage's fill) */
.slot[aria-selected="true"]::before { content: ""; position: absolute; left: -16px; top: 50%; width: 10px; height: 10px; background: var(--jsal-fill); translate: 0 -50%; rotate: 45deg; }   /* style: allow (the logo's gem as a marker beside the row, not a selected fill) */

/* A stage: the part's name very large, what it does, when it's useful, and its window. Without scripts every
   part's stage shows, one under the other. */
.stages { display: grid; gap: var(--jsal-space-24); min-width: 0; }
/* every stage reaches at least the foot of the list, so the chosen row always joins it, even the last */
.stage { container-type: inline-size; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--jsal-space-24) var(--jsal-space-32); align-items: start; align-content: start; padding: var(--jsal-space-32); border-radius: 0 var(--jsal-radius-tile) var(--jsal-radius-tile) 0; background: var(--jsal-sunk); }
.ui-js .stage:not(.on) { display: none; }
/* Every part's stage is as tall as the tallest, so what's under it stays put as the parts change (the tour, a
   click). The script measures each one, unseen, to find that height. */
.ui-js .stages { position: relative; }
/* and every window shows in one frame, its top 460px, fading out at the foot, so the parts come out about the same
   size and the shared height leaves no part with an empty gap (a phone crops its own way, below) */
@media (min-width: 600px) {
  .win:not(.pen) { max-height: 460px; overflow: hidden; border-radius: var(--jsal-radius-xl); }
  .win:not(.pen)::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 64px; background: linear-gradient(transparent, var(--jsal-sunk)); pointer-events: none; }
}
.ui-js .stage.measure { display: grid; position: absolute; left: 0; right: 0; top: 0; visibility: hidden; }
/* Picking a part: the new stage's parts arrive in order from the way the list moved: its name, its words, then
   its window. The first stage is simply there when the page opens. */
@keyframes arrive { from { opacity: 0; translate: 0 calc(var(--dir, 1) * var(--far, 20px)); } }
/* The gem travels: one gold gem slides down the list to the chosen row, turning as it goes, overshoots a little
   and lands with a ring, so the eye is led to the new spot. From 1280px, where the list is a column. */
.gem { display: none; position: absolute; left: -19px; top: 0; z-index: 1; width: 12px; height: 12px; background: var(--jsal-fill); translate: 0 var(--y, 0); rotate: var(--r, 45deg); pointer-events: none; transition: translate 0.55s cubic-bezier(0.34, 1.45, 0.64, 1), rotate 0.55s cubic-bezier(0.16, 1, 0.3, 1); }   /* style: allow (the gem's trip between rows: a spring that overshoots and settles) */
@keyframes land { from { box-shadow: 0 0 0 0 color-mix(in srgb, var(--jsal-fill) 70%, transparent); } to { box-shadow: 0 0 0 14px color-mix(in srgb, var(--jsal-fill) 0%, transparent); } }
.gem.land { animation: land 0.7s 0.3s ease-out; }   /* style: allow (the ring as the gem lands, after its trip) */
@media (min-width: 1280px) {
  .slots { position: relative; }
  .ui-js .gem { display: block; }
  .ui-js .slot[aria-selected="true"]::before { display: none; }
}
/* A first visit: the gem leans toward the next row and back, twice, to show that the list is the control */
@keyframes peek { 50% { translate: 0 calc(var(--y, 0px) + 22px); } }
.gem.peek { animation: peek 1.3s ease-in-out 2; }   /* style: allow (a one-time nudge: a slow lean, there and back) */
@keyframes gem { from { scale: 0; rotate: -45deg; } }
.live .stage.on :is(.head, .say, .facts, .win) { animation: arrive 0.6s cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0s) both; }   /* style: allow (a choreographed arrival: each part follows the one before) */
.live .stage.on .head { --far: 32px; }
.live .stage.on .say { --d: 0.05s; }
.live .stage.on .facts { --d: 0.1s; }
.live .stage.on .win { --d: 0.12s; --far: 56px; }
.slot[aria-selected="true"]::before { animation: gem 0.4s cubic-bezier(0.16, 1, 0.3, 1); }   /* style: allow (the gem landing on the chosen row) */
.head { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--jsal-space-12); }
.stage h2 { margin: 0; font: 800 clamp(36px, 8.5cqi, 72px)/0.95 var(--f); letter-spacing: -0.03em; }   /* style: allow (the stage's name: the page's one very large line) */
.lv { padding: var(--jsal-pad-tag); border-radius: var(--jsal-radius-sm); background: var(--jsal-surface); color: var(--jsal-ink-2); font: 600 12px/1.5 var(--jsal-font); letter-spacing: 0.08em; text-transform: uppercase; }
.lead { margin: 0; font: 600 20px/1.3 var(--f); }
.lead + p { margin: var(--jsal-space-8) 0 0; color: var(--jsal-ink-2); }
.facts { display: grid; gap: var(--jsal-space-8); margin: 0; padding: 0; list-style: none; line-height: 1.4; }
.facts li { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: var(--jsal-space-12); }
.facts svg { width: 20px; height: 20px; color: var(--jsal-accent); }
/* A narrow window sits beside its words; a wide one runs across the stage under them */
.stage.side { grid-template-columns: minmax(0, 5fr) minmax(0, 4fr); }
.stage.side { grid-template-rows: auto 1fr; }
.stage.side .say { display: flex; flex-direction: column; gap: var(--jsal-space-24); align-self: stretch; }
/* One pal's life in the addon's own pixel art, standing on the stage's floor: egg, then each form it grows into */
.family { margin: auto 0 0; padding-top: var(--jsal-space-24); }
.family ol { display: flex; align-items: flex-end; gap: var(--jsal-space-8); margin: 0; padding: 0; list-style: none; }
.family li { position: relative; flex: 1 1 0; display: grid; justify-items: center; gap: var(--jsal-space-4); min-width: 0; color: var(--jsal-ink-2); font-size: 13px; font-weight: 600; text-align: center; }
.family img { max-width: 100%; height: auto; image-rendering: pixelated; }
.family li + li::before { content: ""; position: absolute; left: calc(var(--jsal-space-8) * -1); bottom: 44px; width: 8px; height: 8px; border: solid var(--jsal-muted); border-width: 2px 2px 0 0; rotate: 45deg; translate: -50% 0; }
/* With scripts the strip is played: one pal in a small window from the game (dark in both themes, as the light it
   grows in is pale), a button that hatches the egg and then grows it, as Grow does in its pen, and the four names
   as steps under it */
/* The pal grows in its own pen, one of the addon's scenes: by day in the light theme, by night in the dark one */
.win.pen canvas { display: block; width: 100%; max-width: 880px; height: auto; aspect-ratio: 220 / 100; margin-inline: auto; border: 1px solid var(--jsal-line-hi); border-radius: var(--jsal-radius-xl); background: var(--win-fill); box-shadow: var(--win-shadow); image-rendering: pixelated; }
/* the pen's controls sit on it, bottom left: icon buttons (each named for screen readers and on hover) and the line
   saying what just happened, on a dark glass the same in both themes, as they sit on the picture */
.win.pen { position: relative; width: 100%; max-width: 880px; margin-inline: auto; }   /* as wide as its picture, so the controls sit in the picture's corner */
.pal { position: absolute; left: var(--jsal-space-12); bottom: var(--jsal-space-12); display: inline-flex; align-items: center; gap: var(--jsal-space-4); max-width: calc(100% - var(--jsal-space-24)); padding: var(--jsal-space-4); border: 1px solid rgb(255 255 255 / 0.14); border-radius: var(--jsal-radius-lg); background: rgb(17 19 24 / 0.72); color: #ece6d6; backdrop-filter: blur(8px); }   /* style: allow (one bar of controls on the pen's picture, the same in both themes) */
.pal .icon-btn { display: grid; place-items: center; flex: none; width: 36px; height: 36px; padding: 0; border: 0; border-radius: var(--jsal-radius); background: transparent; color: inherit; cursor: pointer; transition: background var(--jsal-quick) ease; }
.pal .icon-btn:hover { background: rgb(255 255 255 / 0.1); }   /* style: allow (on the picture) */
.pal .icon-btn.go { color: var(--jsal-fill); }
.pal .icon-btn:disabled { opacity: 0.5; cursor: default; }
.pal .icon-btn:focus-visible { outline: 2px solid var(--jsal-fill); outline-offset: 0; }
.pal .icon-btn svg { width: 20px; height: 20px; }
.pal figcaption.on-pen { margin: 0; padding: 0 var(--jsal-space-12) 0 var(--jsal-space-8); border: 0; border-left: 1px solid rgb(255 255 255 / 0.14); color: inherit; font-size: 13px; line-height: 1.3; }   /* style: allow (on the picture) */
@media (pointer: coarse) { .pal .icon-btn { width: 44px; height: 44px; } }
/* with scripts the pen shows each form and the line under the buttons names it, so the row of names isn't needed */
.play ol { display: none; }
.family.play figcaption { margin-top: var(--jsal-space-12); padding-top: 0; border-top: 0; }
@media (max-width: 520px), (max-height: 500px) and (orientation: landscape) {
  /* the pen comes straight after the words, its controls just under it so they never cover the pal */
  .pal { position: static; margin-top: var(--jsal-space-12); }
  .stage:has(.family) .say { display: contents; }
  .stage:has(.family) .say > div { order: 1; }
  .stage:has(.family) .win.pen { order: 2; }
  .stage:has(.family) .family { order: 3; }
}
.family figcaption { margin-top: var(--jsal-space-12); padding-top: var(--jsal-space-12); border-top: 1px solid var(--jsal-line-hi); color: var(--jsal-muted); font-size: 13px; }
.stage.side .win { grid-column: 2; }
.stage:not(.side) .win { grid-column: 1 / -1; }

/* A window from the game: straight, framed and lifted. A small one (the pals) keeps its own size, so it never blurs. */
.win { position: relative; margin: 0; }
.win :is(img, video) { display: block; width: 100%; max-width: var(--w); height: auto; margin-inline: auto; border: 1px solid var(--jsal-line-hi); border-radius: var(--jsal-radius-xl); background: var(--win-fill); box-shadow: var(--win-shadow); }
/* A clip plays in place of a still while it's on screen, and keeps a Pause button (in the dark theme's colours, on
   the game) in its corner, so nothing moves without a way to stop it */
.clip-ctl { position: absolute; right: var(--jsal-space-12); bottom: var(--jsal-space-12); z-index: 1; }

.band h2, .little h2, .install h2 { margin: 0; font: 700 24px/1.2 var(--f); letter-spacing: -0.01em; }

/* The latest release, and the Discord */
.band { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: var(--jsal-space-48); margin-top: var(--jsal-space-64); padding: var(--jsal-space-32); border-radius: var(--jsal-radius-tile); background: var(--plain); }
.ver { display: flex; align-items: baseline; gap: var(--jsal-space-12); margin: 0; }
.ver b { font: 700 30px/1.1 var(--f); }
.tag { padding: var(--jsal-pad-tag); border-radius: var(--jsal-radius-pill); background: var(--jsal-fill); color: var(--jsal-on-fill); font: 600 12px/1.5 var(--jsal-font); letter-spacing: 0.06em; text-transform: uppercase; }
.when { margin: var(--jsal-space-4) 0 0; color: var(--jsal-muted); }
.band ul { margin: 0; padding-left: 1.2em; }
.band li + li { margin-top: var(--jsal-space-8); }
.more { margin: var(--jsal-space-16) 0 0; }
.band.discord { grid-template-columns: minmax(0, 1fr) auto; align-items: center; margin-top: var(--jsal-space-20); }
.band.discord p { margin: var(--jsal-space-4) 0 0; color: var(--jsal-ink-2); }

/* The small helpers, two columns of name and line */
.little, .install { margin-top: var(--jsal-space-64); }
.little > p { margin: var(--jsal-space-8) 0 var(--jsal-space-16); color: var(--jsal-ink-2); }
.little dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--jsal-space-48); margin: 0; }
.little dl div { padding: var(--jsal-space-12) 0; border-top: 1px solid var(--jsal-line); }
.little dt { font-weight: 600; }
.little dd { margin: 0; color: var(--jsal-ink-2); }

/* Install: a card with the steps, and the one question people ask beside them */
.install { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--jsal-space-48); padding: var(--jsal-space-32); border-radius: var(--jsal-radius-tile); background: var(--plain); }
.install h2 { margin-bottom: var(--jsal-space-12); }
.install h3 { margin: 0 0 var(--jsal-space-4); font: 700 17px/1.4 var(--f); }
.install p, .install li { color: var(--jsal-ink-2); }
.install code { overflow-wrap: anywhere; }   /* the AddOns folder's long path breaks on the narrowest phones */
.install ol { margin: 0 0 var(--jsal-flow); padding-left: 1.3em; }
.install li + li { margin-top: var(--jsal-space-8); }
.install p { margin: 0 0 var(--jsal-flow); }
.install .get-it { display: flex; flex-wrap: wrap; align-items: center; gap: var(--jsal-space-12) var(--jsal-space-16); }
.install .get-it span { flex: 1 1 14em; font-size: 14px; }
.install > div > :last-child { margin-bottom: 0; }
.credit { margin: var(--jsal-space-16) 0 0; font-size: 13px; color: var(--jsal-muted); }

/* Scrolling down, each block under the tour rises 48px (24px on phones) and fades in once, when a sixth of it
   shows. Only what starts below the screen waits (.rv, set by /jsal-ui/reveal.js), and only with motion welcome;
   printed, everything shows. */
:root { --rv-y: 48px; }
@media (pointer: coarse), (max-width: 699px) { :root { --rv-y: 24px; } }
@media (prefers-reduced-motion: no-preference) {
  .rv { opacity: 0; transform: translateY(var(--rv-y)); }
  .rv.in { opacity: 1; transform: none; transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0s), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0s); }   /* style: allow (the scroll reveal: slow and far, so it reads as arriving) */
}
/* The tour: the chosen row's gold line fills while its turn lasts; it rests while the pointer or the keyboard is on
   the list or the stage, or the list is off screen */
.slot::after { content: ""; position: absolute; left: var(--jsal-space-12); right: var(--jsal-space-12); bottom: var(--jsal-space-2); height: 2px; border-radius: var(--jsal-radius-pill); background: var(--jsal-fill); transform: scaleX(0); transform-origin: left; }
.pick.tour .slot[aria-selected="true"]::after { animation: turn 5s linear forwards; }   /* style: allow (a part's turn in the tour) */
.pick.tour:is(:hover, .away, :has(.slots:focus-within, .stages:focus-within)) .slot[aria-selected="true"]::after { animation-play-state: paused; }
@keyframes turn { to { transform: scaleX(1); } }
.tour-btn { display: none; align-self: start; margin-top: var(--jsal-space-12); }
.pick.tour .tour-btn, .pick.rested .tour-btn, .pick.toured .tour-btn { display: inline-flex; }
@media (max-width: 699px), (max-height: 500px) and (orientation: landscape) { .pick.tour .tour-btn, .pick.rested .tour-btn, .pick.toured .tour-btn, .slot::after { display: none; } }
@media print { .rv { opacity: 1; transform: none; } }
/* A part with a page of its own links to it: under its ticked points, where the stage has room for it, so the
   stage keeps its height; on a phone, where the points wait for a wider screen, under its line */
.facts .to-page { display: block; padding-left: calc(var(--jsal-space-20) + var(--jsal-space-12)); }
.say .to-page { display: none; }
@media (max-width: 599px), (max-height: 500px) and (orientation: landscape) {
  .ui-js .say .to-page { display: inline-block; margin-top: var(--jsal-space-8); }
}

/* A small laptop or a tablet: the headline and Download, then the list as rows of parts, then the stage */
@media (max-width: 1279px) {
  .pick { grid-template-columns: minmax(0, 1fr); gap: var(--jsal-space-24); }
  .stage { border-radius: var(--jsal-radius-tile); }
  /* here the gem sits inside the row, before its name */
  .slot[aria-selected="true"]::before { position: static; flex: none; translate: none; }
  .slot { justify-content: flex-start; }
  .slots { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--jsal-space-4); }
  .grp { display: none; }
  .slot { padding: var(--jsal-space-8) var(--jsal-space-12); border: 1px solid var(--jsal-line); border-radius: var(--jsal-radius-lg); }
  .slot i { display: none; }
}
@media (max-width: 899px) {
  .install, .band { grid-template-columns: minmax(0, 1fr); gap: var(--jsal-space-24); }
  .little dl { grid-template-columns: minmax(0, 1fr); }
  .stage, .stage.side { grid-template-columns: minmax(0, 1fr); }
  .stage.side .win { grid-column: 1; }
}
/* Upright phones: the parts as a list under their groups' names, each row with its name and when it's useful, and
   the chosen part open under its own row (its words and its window; the head and the ticked points wait for a wider
   screen). Tapping another row opens that one. A whole window would be too small to read, so each shows its top
   corner at a readable size, cut off by its frame, past the dashboard's menu and title bar. */
/* and a phone held sideways (a short screen), as there the stage is taller than the screen */
@media (max-width: 599px), (max-height: 500px) and (orientation: landscape) {
  .pick { gap: 0; }
  .rail, .slots, .stages { display: contents; }
  .grp, .slot, .stage { order: var(--o); }
  .grp { display: block; margin: var(--jsal-space-20) 0 var(--jsal-space-4); }
  .slot { justify-content: space-between; min-height: 48px; margin-top: var(--jsal-space-4); padding: var(--jsal-space-8) var(--jsal-space-12); border: 0; border-radius: var(--jsal-radius-xl); background: var(--jsal-surface); }
  .slot i { display: inline; }
  .slot[aria-selected="true"] { border-radius: var(--jsal-radius-xl) var(--jsal-radius-xl) 0 0; background: var(--jsal-sunk); }   /* style: allow (the row and its open stage are one piece, so it wears the stage's fill) */
  .slot[aria-selected="true"]::before { display: none; }
  .tour-btn { order: 99; }
  .stage { gap: var(--jsal-space-16); padding: var(--jsal-space-4) var(--jsal-space-16) var(--jsal-space-16); border-radius: 0 0 var(--jsal-radius-xl) var(--jsal-radius-xl); }
  .ui-js .stage :is(.head, .facts) { display: none; }
  .stage.side .say { gap: var(--jsal-space-16); }
  .family { padding-top: 0; }
  .win:not(.pen) { position: relative; overflow: hidden; aspect-ratio: 4 / 3; border: 1px solid var(--jsal-line-hi); border-radius: var(--jsal-radius-xl); background: var(--win-fill); box-shadow: var(--win-shadow); }
  .win.home { aspect-ratio: 4 / 5; }   /* taller, so Home's plans show under the trainer visit */
  .win:not(.pen) :is(img, video) { width: var(--pw, 760px); max-width: none; margin: 0; border: 0; border-radius: 0; box-shadow: none; transform: translate(calc(var(--cx) * -1%), calc(var(--cy) * -1%)); }
  /* one card of three rows, each number in its own column so the words line up */
  .band.discord { grid-template-columns: minmax(0, 1fr); }
}
@media (max-width: 520px) {
  .hello h1 { font-size: 40px; }
  .install, .band { padding: var(--jsal-space-20); }
}
@media (prefers-reduced-motion: reduce) {
  .slot { transition: none; }
  .live .stage.on :is(.head, .say, .facts, .win), .slot[aria-selected="true"]::before, .gem.land, .gem.peek { animation: none; }
  .gem { transition: none; }
}
/* a row brought to the top of a phone screen keeps a little room above it */
.slot { scroll-margin-top: var(--jsal-space-12); }
