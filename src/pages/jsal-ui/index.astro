<script is:inline>
// The scroll reveal: blocks below the fold wait, then rise into place once a sixth of them is in view. Within a
// part, the window follows its words; along a row of numbers or cards, each follows the one before.
if (matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window) {
  const groups = [['.numbers > div', 0.08], ['.part .txt', 0], ['.part .win', 0.12], ['.rest > h2, .rest > p', 0], ['.card', 0.08], ['.band', 0], ['.little', 0], ['.install', 0]];
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    e.target.classList.add('in');
    io.unobserve(e.target);
  }), { threshold: 0.16 });
  for (const [sel, step] of groups) {
    document.querySelectorAll(sel).forEach((el, i) => {
      if (el.getBoundingClientRect().top < innerHeight) return;   // already on screen: shown as it is
      const cols = sel === '.card' ? (getComputedStyle(el.parentElement).gridTemplateColumns.split(' ').length) : 3;
      if (step) el.style.setProperty('--d', `${(sel === '.part .win' ? 1 : i % cols) * step}s`);
      el.classList.add('rv');
      io.observe(el);
    });
  }
}
// The clips: each plays while a third of its frame is on screen and stops when it leaves, downloading only then
// (the frame, not the video, as phones show only a corner of the video). Its button says what a press does (Pause
// or Play), and a pause holds until the visitor plays it again. With reduced motion nothing starts by itself; Play
// still works. A page loaded ahead waits until it's shown.
function clips() {
  const calm = !matchMedia('(prefers-reduced-motion: no-preference)').matches;
  const watch = 'IntersectionObserver' in window && new IntersectionObserver((es) => es.forEach((e) => {
    const v = e.target.querySelector('video');
    if (e.isIntersecting && !v.dataset.held) v.play().catch(() => {});
    else if (!e.isIntersecting && !v.paused) v.pause();
  }), { threshold: 0.33 });
  document.querySelectorAll('.clip video').forEach((v) => {
    const btn = v.parentElement.querySelector('.clip-ctl button');
    const say = () => {
      btn.textContent = v.paused ? 'Play' : 'Pause';
      btn.setAttribute('aria-label', `${btn.textContent} the ${btn.dataset.name} clip`);
    };
    v.addEventListener('play', say);
    v.addEventListener('pause', say);
    say();
    btn.addEventListener('click', () => {
      if (v.paused) { delete v.dataset.held; v.play().catch(() => {}); }
      else { v.dataset.held = '1'; v.pause(); }
    });
    if (calm) v.dataset.held = '1';
    if (watch) watch.observe(v.parentElement);
  });
}
if (document.prerendering) document.addEventListener('prerenderingchange', clips, { once: true });
else clips();
</script>
