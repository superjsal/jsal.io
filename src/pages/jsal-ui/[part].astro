---
// A page for each of jsal.ui's six big parts (/jsal-ui/training/, /build/, /gear/, /dungeons/, /endgame/,
// /professions/), from John's pick of the landing mockups (24 Nov 2026, "A, the tour"), kept beside the jsal.ui
// page's own layout (24 Nov 2026, "part pages + strong"): the tour, one part deep. Its headline and window large,
// then a section for each thing it does (from John's pick of the part-page mockups, 24 Nov 2026, "G": a clip or a
// close-up at its own size with a one-line caption under it, the caption alone where there's no picture yet,
// sections side by side where they fit), Good to know, two more parts and the download. Every word is in PAGES in src/lib/jsal-ui.mjs, and
// the part's name, window and points in GROUPS beside it; the version reads src/data/jsal-ui-release.json, as the
// jsal.ui page's does. Each page is linked from its part's stage on the jsal.ui page ("More on the ..."), and links
// back to it from the top bar, the line over its title and More of jsal.ui. Each block below the first screen
// arrives as it's scrolled to (site/jsal-ui/reveal.js, the same as the jsal.ui page's).
import Page from "../../layouts/Page.astro";
import TopBar from "../../components/TopBar.astro";
import JsalUiStyles from "../../components/JsalUiStyles.astro";
import { v } from "../../lib/v.mjs";
import { GROUPS, PAGES } from "../../lib/jsal-ui.mjs";
import RELEASE from "../../data/jsal-ui-release.json";

export function getStaticPaths() {
  return Object.keys(PAGES).map((part) => ({ params: { part } }));
}
const { part } = Astro.params;
const page = PAGES[part];
const group = GROUPS.find((g) => g.parts.some((p) => p.key === part));
const ALL = Object.fromEntries(GROUPS.flatMap((g) => g.parts).map((p) => [p.key, p]));
const me = ALL[part];
const RELEASES = "https://github.com/superjsal/jsal-ui/releases/latest";
const WHEN = { leveling: "1 to 60", sixty: "At 60", any: "Any level", fun: "Any level" };
const released = new Date(`${RELEASE.date}T12:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
// A row's picture: a close-up (shot in PAGES) at the game's own size, or a clip of a part in use (its key in GROUPS),
// shown as a muted video with its first frame. The part's own clip, where CLIPS has one, leads the page instead of
// its window, in the same figure and played by the same script as on the jsal.ui page.
const clipOf = (row) => row.clip && ALL[row.clip].clip;
// Each section is as wide as its picture (--w); one with no picture yet takes the caption width the CSS gives it. A
// row told on the wide stage only (wide) has no section.
const rows = page.rows.filter((r) => !r.wide).map((r) => ({ ...r, c: clipOf(r) })).map((r) => ({ ...r, w: (r.c || r.shot)?.w }));
// On a phone a clip's corner is drawn at no less than 85% of its own size
const phoneW = (c) => Math.max(c.pw, Math.round(c.w * 0.85));
// Where a part opens: its own word after /jsal, or the dashboard's menu
const where = page.command ? ["Opens with", `/jsal ${page.command}`] : ["In the menu of", "/jsal"];
// More of jsal.ui: two parts, each to its own page or its stage on the jsal.ui page, then the jsal.ui page itself
const next = page.next.map((key) => ({ href: PAGES[key] ? `/jsal-ui/${key}/` : `/jsal-ui/#pick-${key}`, label: ALL[key].label, line: ALL[key].name }));
const maps = rows.some((r) => r.credit);
const clipped = !!(me.film || me.clip) || rows.some((r) => r.c);
// The whole screen (page.screen, wide windows only; job 147 from John's pick of the job 146 mockups): one still of the
// part's window, each row a numbered spot on it with its tooltip. Every row needs a box for it. A box and its
// tooltip are placed in percentages of the still. The tooltip (John, 24 Nov 2026: "tooltip over to the side") sits
// beside its box, level with its top: to its right where it fits inside the still, else to its left. It may lie over
// the next box (dimmed while it's pointed at), never its own. The dim's hole is the box with the gold edge's 4px.
const screen = page.screen && page.rows.every((r) => r.box && r.ticks) ? page.screen : null;
// A stage (page.stage; job 150, John: "B for both") is the whole screen made of pieces: the part's window with its other
// pieces laid over its edge, each at the game's own size, the whole stage breaking out of the column where it's wider
// and drawn smaller only where the window is too narrow for it. Pieces, boxes and dots are placed in percentages of the
// stage; the tooltip is placed as drawn, by the script, on the box's side. Each piece dims on its own: the ones under
// the pointed-at box round a hole the box's size, the others whole.
const stage = !screen && page.stage && page.rows.every((r) => r.box && r.ticks && r.side) ? page.stage : null;
const at = ([x, y, w, h], s) => `left: ${pc(x, s.w)}; top: ${pc(y, s.h)}; width: ${pc(w, s.w)}; height: ${pc(h, s.h)}`;
const frame = (p) => [p.x, p.y, p.w + 2, p.h + 2];
// A box's hole in its piece's dim, in percentages of the picture inside the piece's 1px frame, with the gold edge's 4px
const holeIn = ([x, y, w, h], p) => `left: calc(${pc(x - p.x - 1, p.w)} - 4px); top: calc(${pc(y - p.y - 1, p.h)} - 4px); width: calc(${pc(w, p.w)} + 8px); height: calc(${pc(h, p.h)} + 8px)`;
const order = stage ? (stage.order || page.rows.map((_, i) => i)) : [];
// A box told in several pieces opens a hole in each of them, the holes in the same order as the pieces
const ons = (r) => [].concat(r.on);
// A window with tabs (stage.states): its first tab shows at first; a row's dots go with its piece's tab, and arrive
// in their order within it
const states = stage && stage.states;
const tabOf = (r) => stage.pieces[ons(r)[0]].state;
const first = states ? states[0][0] : null;
const nIn = (i) => states ? order.filter((j) => tabOf(page.rows[j]) === tabOf(page.rows[i])).indexOf(i) : order.indexOf(i);
const pc = (n, of) => `${+((n / of) * 100).toFixed(4)}%`;
const TIP = 320, GAP = 16;
const spots = screen ? page.rows.map(({ box: [x, y, w, h] }) => {
  const right = x + w + GAP + TIP <= screen.w;
  return {
    area: `left: ${pc(x, screen.w)}; top: ${pc(y, screen.h)}; width: ${pc(w, screen.w)}; height: ${pc(h, screen.h)}`,
    hole: `left: calc(${pc(x, screen.w)} - 4px); top: calc(${pc(y, screen.h)} - 4px); width: calc(${pc(w, screen.w)} + 8px); height: calc(${pc(h, screen.h)} + 8px)`,
    tip: [pc(right ? x + w + GAP : x - GAP - TIP, screen.w), pc(y, screen.h), right ? "right" : "left"],
  };
}) : [];

const MAPS = "https://sreyesmaps.com";
---
<Page
  title={`${page.title} | jsal.io`}
  description={page.description}
  path={`/jsal-ui/${part}/`}
  ogImage="jsal-ui"
  ogImageAlt="Your WoW Forever character, in one dashboard: jsal.ui's Home window, with the character, the trainer visit and the plans"
  ogDescription={page.description}
>
<JsalUiStyles slot="head" />
<script is:inline slot="head" src={v("/jsal-ui/reveal.js")} defer></script>
<style is:inline slot="head">
/* The line back to the jsal.ui page and the part's chapter */
.crumb { margin: var(--jsal-page-top) 0 0; }
/* The part's name and headline, what it does, and the download with when it's useful beside them */
.hero { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--jsal-space-24) var(--jsal-space-48); align-items: end; margin-top: var(--jsal-space-20); }
.hero h1 { margin: 0; font: 700 46px/1.05 var(--f); letter-spacing: -0.02em; }
.hero .lead { max-width: 40em; margin: var(--jsal-space-16) 0 0; color: var(--jsal-ink-2); font-size: 17px; line-height: 1.55; }
.side { display: grid; justify-items: end; gap: var(--jsal-space-12); }
.side p { margin: 0; color: var(--jsal-muted); font-size: 14px; }
.side code { padding: var(--jsal-space-2) var(--jsal-space-8); border: 1px solid var(--jsal-line-hi); border-radius: var(--jsal-radius); color: var(--jsal-ink); }
.big { margin-top: var(--jsal-space-40); }

/* A section for each thing the part does: its picture at its own size with a short caption under it, exactly as wide
   as the picture. Sections sit side by side wherever they fit, standing on one line so their captions line up; one
   with no picture yet is its caption alone, at a typical picture's width */
.caps { display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-end; gap: var(--jsal-space-64) var(--jsal-space-40); margin-top: calc(var(--jsal-space-64) + var(--jsal-space-24)); }
.part-row { display: flex; flex-direction: column; gap: var(--jsal-space-20); flex: 0 1 var(--w, 26rem); max-width: 100%; min-width: 0; scroll-margin-top: var(--jsal-space-24); }
.part-row .words { text-align: center; }
.part-row h2 { margin: var(--jsal-space-4) 0 0; font: 700 20px/1.25 var(--f); letter-spacing: -0.02em; }
.part-row .say { margin: var(--jsal-space-8) 0 0; color: var(--jsal-ink-2); font-size: 15px; }
/* A close-up is one card or list from a window, never drawn larger than the game draws it */
.win.shot img { max-width: var(--w); margin-inline: auto; }

/* Good to know: three short facts, a card each */
.good { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--jsal-space-20); margin-top: calc(var(--jsal-space-64) + var(--jsal-space-32)); }
.good h2, .next h2, .band h2 { margin: 0; font: 700 24px/1.2 var(--f); letter-spacing: -0.01em; }
.good h2 { grid-column: 1 / -1; }
.good div { padding: var(--jsal-space-24); border-radius: var(--jsal-radius-tile); background: var(--plain); }
.good h3 { margin: 0; font: 700 20px/1.3 var(--f); }
.good p { margin: var(--jsal-space-8) 0 0; color: var(--jsal-ink-2); font-size: 14px; line-height: 1.5; }
/* More of jsal.ui: two parts and the jsal.ui page, as links the size of a card */
.next { margin-top: calc(var(--jsal-space-64) + var(--jsal-space-24)); }
.next ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--jsal-space-20); margin: var(--jsal-space-16) 0 0; padding: 0; list-style: none; }
.next a { display: grid; align-content: start; gap: var(--jsal-space-8); height: 100%; padding: var(--jsal-space-20) var(--jsal-space-24); border: 1px solid var(--jsal-line); border-radius: var(--jsal-radius-tile); color: inherit; text-decoration: none; transition: border-color var(--jsal-quick); }
.next a:hover { border-color: var(--jsal-hover-line); }
.next b { font: 700 20px/1.2 var(--f); }
.next span { color: var(--jsal-ink-2); font-size: 14px; line-height: 1.5; }
.next .more { color: var(--jsal-accent); font-size: 14px; }
/* Get it: the download again at the foot, with the version */
.band { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--jsal-space-24); margin-top: var(--jsal-space-64); padding: var(--jsal-space-32); border-radius: var(--jsal-radius-tile); background: var(--plain); }
.band p { margin: var(--jsal-space-4) 0 0; color: var(--jsal-ink-2); }
.band .get { display: flex; flex-wrap: wrap; gap: var(--jsal-space-12); }

@media (max-width: 899px) {
  .hero { grid-template-columns: minmax(0, 1fr); align-items: start; }
  .side { justify-items: start; }
  .good, .next ul { grid-template-columns: minmax(0, 1fr); }
}
@media (max-width: 599px) {
  .caps { gap: var(--jsal-space-48); margin-top: var(--jsal-space-64); }
  .good { margin-top: var(--jsal-space-64); }
  .band { padding: var(--jsal-space-20); }
  .band .get .jsal-btn { flex: 1 1 auto; }
  /* a close-up wider than the screen keeps its words readable: drawn at no less than 85% of the game's size, its
     left part shown in its frame */
  .win.shot { overflow: hidden; border: 1px solid var(--jsal-line-hi); border-radius: var(--jsal-radius-xl); background: var(--win-fill); box-shadow: var(--win-shadow); }
  .win.shot img { width: min(var(--w), max(100%, calc(var(--w) * 0.85))); max-width: none; margin: 0; border: 0; border-radius: 0; box-shadow: none; }
  /* a close-up that is a whole panel is fitted to its frame instead, so none of it is cut off */
  .win.shot.fit img { width: min(var(--w), 100%); }
}
/* Touch: the small links and the clip's button get a 44px tap area that takes no room */
@media (max-width: 599px), (pointer: coarse) {
  .crumb a, .foot a, .clip-ctl .jsal-btn { position: relative; }
  .crumb a::after { content: ""; position: absolute; inset: -10px -8px; }
  .foot a::after { content: ""; position: absolute; inset: -15px -8px; }
  .clip-ctl .jsal-btn::after { content: ""; position: absolute; inset: -8px; }
}
@media (max-width: 520px) { .hero h1 { font-size: 40px; } }
/* The narrowest phones keep the bar on one row: Updates goes (the jsal.ui page links it) */
@media (max-width: 374px) { .jsal-top nav a[href="/jsal-ui/updates/"] { display: none; } }
@media (prefers-reduced-motion: reduce) { .next a { transition: none; } }
</style>
{clipped && (
<style is:inline slot="head">
@media (min-width: 600px) { .win.clip { width: min(100%, var(--w)); margin-inline: auto; } }   /* a clip's frame is the clip itself, never drawn larger than it was made, so its Pause button sits against the clip's own corner */
/* A clip plays while it's on screen, and keeps a Pause button (in the dark theme's colours, on the game) in its
   corner, so nothing moves without a way to stop it */
.clip-ctl { position: absolute; right: var(--jsal-space-12); bottom: var(--jsal-space-12); z-index: 1; }
</style>
)}
{screen && (
<style is:inline slot="head">
.whole { width: min(100%, var(--w)); margin-inline: auto; }
.screen > img { display: block; width: 100%; height: auto; border: 1px solid var(--jsal-line-hi); border-radius: var(--jsal-radius-xl); background: var(--win-fill); box-shadow: var(--win-shadow); }
</style>
)}
{stage && (
<style is:inline slot="head">
/* A stage wider than the column breaks out of it evenly, on whole pixels, up to 40px from each edge of the window;
   only a window narrower than that draws it smaller */
.whole { --bw: min(var(--w), calc(100vw - 80px)); width: var(--bw); margin-left: round(down, calc((100% - var(--bw)) / 2), 1px); }
.screen { aspect-ratio: var(--ar); }
/* Each piece in its own frame, its picture filling it at the game's own size; a card lies over the window with a
   deeper shadow, and a small one has the smaller corner */
.piece { position: absolute; }
.pic { position: absolute; inset: 0; overflow: hidden; border: 1px solid var(--jsal-line-hi); border-radius: var(--jsal-radius-xl); background: var(--win-fill); box-shadow: var(--win-shadow); }
.pic img { display: block; width: 100%; height: 100%; }
.piece.card .pic { box-shadow: 0 0 0 1px rgb(0 0 0 / 0.5), 0 18px 48px rgb(0 0 0 / 0.55); }   /* style: allow (a card's shadow on the game's dark, as the tooltip's) */
.piece.small .pic { border-radius: var(--jsal-radius-lg); }
</style>
)}
{states && (
<style is:inline slot="head">
/* A window with tabs: the switch over it, large and centred, picks which tab's picture shows (with its own dots); the
   picture of the tab left fades out as the new one fades in */
.tabs { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--jsal-space-12) var(--jsal-space-16); margin-bottom: var(--jsal-space-24); }
.tabs p { margin: 0; color: var(--jsal-ink-2); font-size: 15px; }
.tabs .jsal-seg { padding: var(--jsal-space-4); }
.tabs .jsal-seg > button { min-height: 44px; padding: var(--jsal-space-8) var(--jsal-space-24); font-size: 15px; }
.piece[data-state]:not([data-shown]) { visibility: hidden; opacity: 0; }
@media (prefers-reduced-motion: no-preference) {
  .piece[data-state] { transition: opacity var(--jsal-settle) ease, visibility 0s; }
  .piece[data-state]:not([data-shown]) { transition: opacity var(--jsal-settle) ease, visibility 0s linear var(--jsal-settle); }
}
</style>
)}
{stage && page.rows.some((r) => r.side === "below-end") && (
<style is:inline slot="head">
/* A tooltip under its thing, at its right end, its pointer up at it */
.tip[data-side="below"] { --fx: 0px; --fy: calc(var(--jsal-space-8) * -1); }
.tip[data-side="below"]::before { top: -7px; left: auto; right: var(--jsal-space-24); transform: rotate(135deg); }
</style>
)}
{stage && page.rows.some((r) => r.box[3] < 60) && (
<style is:inline slot="head">
/* A thing too short to carry its dot on its corner without covering its words has the dot beside it, on the left */
.area.slim .dot { top: calc(50% - 12px); left: calc(var(--jsal-space-40) * -1); }
</style>
)}
{(screen || stage) && (
<style is:inline slot="head">
/* Wide windows: one whole screen of the part, at the game's own size, in place of its film and close-ups (which
   phones and narrower windows keep). It fits at its own size from 1280px, where the column grows to 1120px */
@media (min-width: 1280px) { .film, .caps { display: none; } }
@media (max-width: 1279px) { .whole { display: none; } }
.screen { position: relative; }
/* The dim: while a thing is pointed at or focused, the rest of the window darkens round a hole that follows it,
   far enough that the words under the tooltip never compete with its own */
.shade { position: absolute; inset: 0; overflow: hidden; border-radius: var(--jsal-radius-xl); pointer-events: none; }
.hole { position: absolute; border-radius: var(--jsal-radius-lg); box-shadow: 0 0 0 2400px transparent; }
.screen[data-pointing] .hole { box-shadow: 0 0 0 2400px rgb(0 0 0 / 0.7); }
/* Each thing the part does: a button over it, its numbered gold dot on the top left corner (above the tooltip, so
   every number shows), a gold edge when it's the one shown */
.area { position: absolute; margin: 0; padding: 0; border: 0; border-radius: var(--jsal-radius-lg); background: none; color: inherit; font: inherit; cursor: default; outline: none; }
.area::before { content: ""; position: absolute; inset: calc(var(--jsal-space-4) * -1); border-radius: var(--jsal-radius-lg); box-shadow: 0 0 0 2px transparent; }
.area[data-on]::before { box-shadow: 0 0 0 2px var(--jsal-fill), 0 0 24px rgb(227 176 75 / 0.25); }   /* style: allow (the gold's glow, on the game's dark) */
.area:focus-visible::before { box-shadow: 0 0 0 2px var(--jsal-fill), 0 0 0 5px rgb(227 176 75 / 0.35); }   /* style: allow (focus on the game's dark: gold, then a softer gold, never the page's gap) */
/* Under the dim the other things also blur a little, so their words sit further back than the tooltip's */
.area::after { content: ""; position: absolute; inset: calc(var(--jsal-space-4) * -1); border-radius: var(--jsal-radius-lg); pointer-events: none; -webkit-backdrop-filter: blur(0); backdrop-filter: blur(0); }
.screen[data-pointing] .area:not([data-on])::after { -webkit-backdrop-filter: blur(1.5px); backdrop-filter: blur(1.5px); }
.dot { position: absolute; top: calc(var(--jsal-space-8) * -1); left: calc(var(--jsal-space-8) * -1); z-index: 4; display: grid; place-items: center; width: 24px; height: 24px; border-radius: var(--jsal-radius-pill); background: var(--jsal-fill); color: var(--jsal-on-fill); font: 700 13px/1 var(--f); box-shadow: 0 0 0 2px var(--jsal-on-fill); }
/* The tooltip: the site's own card beside the thing it describes, level with its top, its pointer on that thing's
   edge; it may lie over the next thing (dimmed meanwhile), never its own. One box that moves from thing to thing,
   with every note in it, the hidden ones kept for screen readers. A note is the thing's three points, each with the
   gold tick */
.tip { pointer-events: none; --fx: calc(var(--jsal-space-8) * -1); --fy: 0px; position: absolute; z-index: 3; width: 320px; padding: var(--jsal-space-16) var(--jsal-space-20); border: 1px solid var(--jsal-line-hi); border-radius: var(--jsal-radius-lg); background: var(--jsal-surface); color: var(--jsal-ink); box-shadow: 0 0 0 1px rgb(0 0 0 / 0.4), 0 12px 32px rgb(0 0 0 / 0.5); }
.tip[data-side="left"] { --fx: var(--jsal-space-8); }
.tip[data-side="above"] { --fx: 0px; --fy: var(--jsal-space-8); }
.tip::before { content: ""; position: absolute; top: var(--jsal-space-20); left: -7px; width: 12px; height: 12px; border-bottom: 1px solid var(--jsal-line-hi); border-left: 1px solid var(--jsal-line-hi); background: inherit; transform: rotate(45deg); }
.tip[data-side="left"]::before { left: auto; right: -7px; transform: rotate(-135deg); }
.tip[data-side="above"]::before { top: auto; bottom: -7px; left: auto; right: var(--jsal-space-24); transform: rotate(-45deg); }
@media screen and (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .tip { background: var(--jsal-sunk); } }
:root[data-theme="dark"] .tip { background: var(--jsal-sunk); }
.tip[data-off] { visibility: hidden; opacity: 0; transform: translate(var(--fx), var(--fy)); }
.note:not([data-on]) { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.note h2 { margin: var(--jsal-space-4) 0 0; font: 700 17px/1.25 var(--f); letter-spacing: -0.02em; }
.ticks { display: grid; gap: var(--jsal-space-8); margin: var(--jsal-space-12) 0 0; padding: 0; list-style: none; color: var(--jsal-ink-2); font-size: 14px; line-height: 1.4; }
.ticks li { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: var(--jsal-space-12); }
.ticks li::before { content: ""; width: 18px; height: 18px; background: var(--jsal-accent); -webkit-mask: var(--jsal-tick) center / 15px no-repeat; mask: var(--jsal-tick) center / 15px no-repeat; }
/* Motion, only where it's welcome: the dots arrive one after another as the page opens; the edge, the dim and its blur fade; the tooltip and the dim's hole glide from thing to thing; a tooltip fades in and out with a short slide out from its thing, opening in place, and a new note fades in inside it. Without, every change is
   instant */
@media (prefers-reduced-motion: no-preference) {
  .screen[data-in] .dot { animation: dot-in var(--jsal-settle) var(--jsal-ease-out) backwards; animation-delay: calc(var(--jsal-quick) * var(--n)); }
  @keyframes dot-in { from { opacity: 0; transform: scale(0.4); } }
  .area::before { transition: box-shadow var(--jsal-quick) ease; }
  .area::after { transition: -webkit-backdrop-filter var(--jsal-quick) ease, backdrop-filter var(--jsal-quick) ease; }
  .hole { transition: left var(--jsal-settle) var(--jsal-ease-out), top var(--jsal-settle) var(--jsal-ease-out), width var(--jsal-settle) var(--jsal-ease-out), height var(--jsal-settle) var(--jsal-ease-out), box-shadow var(--jsal-quick) ease; }
  .hole[data-snap] { transition: box-shadow var(--jsal-quick) ease; }
  .tip { transition: left var(--jsal-settle) var(--jsal-ease-out), top var(--jsal-settle) var(--jsal-ease-out), height var(--jsal-settle) var(--jsal-ease-out), opacity var(--jsal-quick) ease, transform var(--jsal-settle) var(--jsal-ease-out); }
  .tip[data-off] { transition: opacity var(--jsal-quick) ease, transform var(--jsal-quick) ease, visibility 0s linear var(--jsal-quick); }
  .tip[data-snap] { transition: opacity var(--jsal-quick) ease, transform var(--jsal-settle) var(--jsal-ease-out); }
  .note[data-on] { animation: note-in var(--jsal-quick) ease; }
  @keyframes note-in { from { opacity: 0; } }
}
</style>
)}
{(screen || stage) && <script is:inline slot="head" src={v("/jsal-ui/screen.js")} defer></script>}
{maps && (
<style is:inline slot="head">
/* The maps' maker, credited under the words about them */
.credit { margin: var(--jsal-space-12) 0 0; color: var(--jsal-muted); font-size: 12px; }
.stage-credit { margin: var(--jsal-space-16) 0 0; text-align: center; }
@media (max-width: 599px), (pointer: coarse) { .credit a, .stage-credit a { position: relative; } .credit a::after, .stage-credit a::after { content: ""; position: absolute; inset: -15px -8px; } }
</style>
)}
<div class="wrap">
  <TopBar><nav aria-label="Sections"><a href="/jsal-ui/" aria-current="true">jsal.ui</a><a href="/jsal-ui/updates/">Updates</a><a href="/jsal-ui/#install">Install</a></nav></TopBar>
<main>
  <nav class="crumb jsal-crumbs" aria-label="Breadcrumb"><a href="/jsal-ui/">jsal.ui</a> <span aria-hidden="true">›</span> <span aria-current="page">{me.label}</span></nav>
  <section class="hero" aria-labelledby="part-h">
    <div>
      <h1 id="part-h">{me.name}</h1>
      <p class="lead">{page.lead}</p>
    </div>
    <div class="side">
      <a class="jsal-btn primary dl" href={RELEASES}>Download jsal.ui</a>
      <p><span class="lv">{WHEN[me.when]}</span>&nbsp; {where[0]} <code>{where[1]}</code></p>
    </div>
  </section>
  <!-- The part's film (its window, moving) or its clip where it has one, the same as on its stage on the jsal.ui
       page; else its window, which on a phone shows its top corner at the game's own size -->
  {me.film ? (
    <figure class="win clip film crop big" data-rv style={`--w: ${me.film.w}px; --pw: ${me.film.w}px; --cx: ${me.film.cx ?? me.shot.cx}; --cy: ${me.film.cy ?? me.shot.cy}`}>
      <video muted loop playsinline preload="none" poster={v(me.film.poster)} width={me.film.w} height={me.film.h} aria-label={me.shot.alt}><source src={v(me.film.src)} type="video/mp4"></video>
      <span class="clip-ctl jsal-dark"><button type="button" class="jsal-btn small" data-name={me.label}>Play</button></span>
    </figure>
  ) : me.clip ? (
    <figure class="win clip crop big" data-rv style={`--w: ${me.clip.w}px; --pw: ${me.clip.pw}px; --cx: ${me.clip.cx}; --cy: ${me.clip.cy}`}>
      <video muted loop playsinline preload="none" poster={v(me.clip.poster)} width={me.clip.w} height={me.clip.h} aria-label={me.clip.alt}><source src={v(me.clip.src)} type="video/mp4"></video>
      <span class="clip-ctl jsal-dark"><button type="button" class="jsal-btn small" data-name={me.label}>Play</button></span>
    </figure>
  ) : (
    <figure class="win crop big" data-rv style={`--pw: ${me.shot.w}px; --cx: ${me.shot.cx}; --cy: ${me.shot.cy}`}><img src={v(me.shot.src)} width={me.shot.w} height={me.shot.h} alt={me.shot.alt} fetchpriority="high" decoding="async"></figure>
  )}{screen && (
    <figure class="whole big" data-rv style={`--w: ${screen.w}px`}>
      <!-- On wide windows: the part's whole window, with a numbered spot on each thing it does and a tooltip beside
           the one pointed at or tabbed to (none while it rests); the notes are all here for screen readers -->
      <div class="screen" data-screen>
        <img src={v(screen.src)} width={screen.w} height={screen.h} alt={screen.alt} decoding="async">
        <div class="shade" aria-hidden="true"><span class="hole" style={spots[0].hole}></span></div>
        {rows.map((r, i) => (
          <button type="button" class="area" style={`${spots[i].area}; --n: ${i}`} data-tip={spots[i].tip.join(" ")} data-hole={spots[i].hole} aria-describedby={`note-${i}`}><span class="dot" aria-hidden="true">{i + 1}</span><span class="sr-only">{r.label}</span></button>
        ))}
        <div class="tip" data-off data-side={spots[0].tip[2]} style={`left: ${spots[0].tip[0]}; top: ${spots[0].tip[1]}`}>
          {rows.map((r, i) => (
            <div class="note" id={`note-${i}`}>
              <p class="eyebrow">{r.label}</p>
              <h2>{r.name}</h2>
              <ul class="ticks">{r.ticks.map((t) => <li>{t}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </figure>
  )}{stage && (
    <figure class="whole big" data-rv style={`--w: ${stage.w}px`}>
      <!-- On wide windows: the part's window with its other pieces laid over its edge, a numbered spot on each thing it
           does and a tooltip beside the one pointed at or tabbed to (none while it rests); the notes are all here for
           screen readers -->{states && (
        <div class="tabs"><p id="tabs-h">Pick a tab to see it</p><div class="jsal-seg" role="group" aria-labelledby="tabs-h">{states.map(([k, word]) => <button type="button" data-pick={k} aria-pressed={String(k === first)}>{word}</button>)}</div></div>
      )}
      <div class="screen" data-screen style={`--ar: ${stage.w} / ${stage.h}`}>
        {stage.pieces.map((p) => (
          <div class={["piece", p.card && "card", p.h < 100 && "small"].filter(Boolean).join(" ")} style={at(frame(p), stage)} data-state={p.state} data-shown={p.state === first ? "" : undefined}>
            <div class="pic"><img src={v(p.src)} width={p.w} height={p.h} alt={p.alt} loading="lazy" decoding="async"><div class="shade" aria-hidden="true"><span class="hole"></span></div></div>
          </div>
        ))}
        {order.map((i, n) => (
          <button type="button" class={page.rows[i].box[3] < 60 ? "area slim" : "area"} style={`${at(page.rows[i].box, stage)}; --n: ${nIn(i)}`} data-on-piece={ons(page.rows[i]).join(" ")} data-side={page.rows[i].side} data-hole={ons(page.rows[i]).map((k) => holeIn(page.rows[i].box, stage.pieces[k])).join(" | ")} data-state={states ? tabOf(page.rows[i]) : undefined} hidden={states ? tabOf(page.rows[i]) !== first : undefined} aria-describedby={`note-${i}`}><span class="dot" aria-hidden="true">{n + 1}</span><span class="sr-only">{page.rows[i].label}</span></button>
        ))}
        <div class="tip" data-off data-side="right">
          {order.map((i) => (
            <div class="note" id={`note-${i}`}>
              <p class="eyebrow">{page.rows[i].label}</p>
              <h2>{page.rows[i].head || page.rows[i].name}</h2>
              <ul class="ticks">{page.rows[i].ticks.map((t) => <li>{t}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
      {maps && <p class="credit stage-credit">Forever's own dungeons use <a href={MAPS}>Santiago Reyes's maps</a>, with his permission. No bosses marked on those, on purpose: the new dungeons are yours to explore.</p>}
    </figure>
  )}
  <div class="caps">
  {rows.map((r, i) => (
    <section class="part-row" aria-labelledby={`row-${i}`} style={r.w ? `--w: ${r.w}px` : undefined} {...(r.w ? { "data-rv-row": "" } : { "data-rv": "" })}>
      {r.c ? (
        <figure class="win clip crop" style={`--w: ${r.c.w}px; --pw: ${phoneW(r.c)}px; --cx: ${r.c.cx}; --cy: ${r.c.cy}`}>
          <video muted loop playsinline preload="none" poster={v(r.c.poster)} width={r.c.w} height={r.c.h} aria-label={r.c.alt}><source src={v(r.c.src)} type="video/mp4"></video>
          <span class="clip-ctl jsal-dark"><button type="button" class="jsal-btn small" data-name={r.label}>Play</button></span>
        </figure>
      ) : r.shot && (
        <figure class={r.shot.fit ? "win shot fit" : "win shot"} style={`--w: ${r.shot.w}px`}><img src={v(r.shot.src)} width={r.shot.w} height={r.shot.h} alt={r.shot.alt} loading="lazy" decoding="async"></figure>
      )}
      <div class="words">
        <p class="eyebrow">{r.label}</p>
        <h2 id={`row-${i}`}>{r.name}</h2>
        <p class="say">{r.say}</p>
        {r.credit && <p class="credit">Forever's own dungeons use <a href={MAPS}>Santiago Reyes's maps</a>, with his permission. No bosses marked on those, on purpose: the new dungeons are yours to explore.</p>}
      </div>
    </section>
  ))}
  </div>
  <section class="good" aria-labelledby="good-h" data-rv-cards>
    <h2 id="good-h">Good to know</h2>
    {page.good.map(([t, d]) => <div><h3>{t}</h3><p>{d}</p></div>)}
  </section>
  <nav class="next" aria-labelledby="next-h">
    <h2 id="next-h" data-rv>More of jsal.ui</h2>
    <ul data-rv-cards>
      {next.map((n) => <li><a href={n.href} data-plain><b>{n.label}</b><span>{n.line}</span><span class="more">{n.label}</span></a></li>)}
      <li><a href="/jsal-ui/" data-plain><b>Everything in jsal.ui</b><span>Every part, from trainer visits to daily games with your guild.</span><span class="more">The jsal.ui page</span></a></li>
    </ul>
  </nav>
  <section class="band" aria-labelledby="get-h" data-rv>
    <div><h2 id="get-h">Get jsal.ui</h2><p>Free, for WoW Forever. Version {RELEASE.version}, {released}.</p></div>
    <div class="get"><a class="jsal-btn primary dl" href={RELEASES}>Download jsal.ui</a><a class="jsal-btn dl" href="/jsal-ui/#install">How to install</a></div>
  </section>
  <footer class="foot" data-rv>
    <p>Made by jsal · <a href="mailto:dev@jsal.io">dev@jsal.io</a></p>
    <p>Screenshots of World of Warcraft © Blizzard Entertainment.{maps && " Dungeon maps by Santiago Reyes."}</p>
  </footer>
</main>
</div>
{clipped && (
<script is:inline>
// The clips: each plays while a third of its frame is on screen and stops when it leaves, downloading only then
// (the frame, not the video, as phones show only a corner of the video). Its button says what a press does (Pause
// or Play), and a pause holds until the visitor plays it again. With reduced motion, or when the browser is asked to
// save data, nothing starts by itself or downloads; Play still works. A page loaded ahead waits until it's shown.
function clips() {
  const calm = !matchMedia('(prefers-reduced-motion: no-preference)').matches || !!(navigator.connection && navigator.connection.saveData);
  const watch = 'IntersectionObserver' in window && new IntersectionObserver((es) => es.forEach((e) => {
    const v = e.target.querySelector('video');
    if (e.isIntersecting && !v.dataset.held) v.play().catch(() => {});
    else if (!e.isIntersecting && !v.paused) v.pause();
  }), { threshold: 0.33 });
  document.querySelectorAll('.clip video').forEach((v) => {
    const btn = v.parentElement.querySelector('.clip-ctl button');
    const say = () => {
      btn.textContent = v.paused ? 'Play' : 'Pause';
      btn.setAttribute('aria-label', `${btn.textContent} the ${btn.dataset.name} clip`);
    };
    v.addEventListener('play', say);
    v.addEventListener('pause', say);
    say();
    btn.addEventListener('click', () => {
      if (v.paused) { delete v.dataset.held; v.play().catch(() => {}); }
      else { v.dataset.held = '1'; v.pause(); }
    });
    if (calm) v.dataset.held = '1';
    if (watch) watch.observe(v.parentElement);
  });
}
if (document.prerendering) document.addEventListener('prerenderingchange', clips, { once: true });
else clips();
</script>
)}
