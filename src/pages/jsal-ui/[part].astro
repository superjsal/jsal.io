---
// A page for each of jsal.ui's six big parts (/jsal-ui/training/, /build/, /gear/, /dungeons/, /endgame/,
// /professions/), from John's pick of the landing mockups (24 Nov 2026, "A, the tour"), kept beside the jsal.ui
// page's own layout (24 Nov 2026, "part pages + strong"): the tour, one part deep. Its headline and window large,
// then a row for each thing it does (a clip or a close-up beside it where the site has one; the words alone where it
// doesn't yet), Good to know, two more parts and the download. Every word is in PAGES in src/lib/jsal-ui.mjs, and
// the part's name, window and points in GROUPS beside it; the version reads src/data/jsal-ui-release.json, as the
// jsal.ui page's does. Each page is linked from its part's stage on the jsal.ui page ("More on the ..."), and links
// back to it from the top bar, the line over its title and More of jsal.ui. Each block below the first screen
// arrives as it's scrolled to (site/jsal-ui/reveal.js, the same as the jsal.ui page's).
import Page from "../../layouts/Page.astro";
import TopBar from "../../components/TopBar.astro";
import JsalUiStyles from "../../components/JsalUiStyles.astro";
import { v } from "../../lib/v.mjs";
import { GROUPS, PAGES } from "../../lib/jsal-ui.mjs";
import RELEASE from "../../data/jsal-ui-release.json";

export function getStaticPaths() {
  return Object.keys(PAGES).map((part) => ({ params: { part } }));
}
const { part } = Astro.params;
const page = PAGES[part];
const group = GROUPS.find((g) => g.parts.some((p) => p.key === part));
const ALL = Object.fromEntries(GROUPS.flatMap((g) => g.parts).map((p) => [p.key, p]));
const me = ALL[part];
const RELEASES = "https://github.com/superjsal/jsal-ui/releases/latest";
const WHEN = { leveling: "1 to 60", sixty: "At 60", any: "Any level" };
const released = new Date(`${RELEASE.date}T12:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
// A row's picture: a close-up (shot in PAGES) at the game's own size, or a clip of a part in use (its key in GROUPS),
// shown as a muted video with its first frame. The part's own clip, where CLIPS has one, leads the page instead of
// its window, in the same figure and played by the same script as on the jsal.ui page.
const clipOf = (row) => row.clip && ALL[row.clip].clip;
// Rows with a picture take turns left and right, the first one's picture on the right
let k = 0;
const rows = page.rows.map((r) => ({ ...r, c: clipOf(r), flip: clipOf(r) || r.shot ? k++ % 2 === 0 : false }));
// A picture wider than the usual picture column gets two thirds of the row, so its words stay at least 85% of the
// game's size
const wide = (r) => ((r.c || r.shot)?.w || 0) > 740;
// On a phone a clip's corner is drawn at no less than 85% of its own size
const phoneW = (c) => Math.max(c.pw, Math.round(c.w * 0.85));
// Where a part opens: its own word after /jsal, or the dashboard's menu
const where = page.command ? ["Opens with", `/jsal ${page.command}`] : ["In the menu of", "/jsal"];
// More of jsal.ui: two parts, each to its own page or its stage on the jsal.ui page, then the jsal.ui page itself
const next = page.next.map((key) => ({ href: PAGES[key] ? `/jsal-ui/${key}/` : `/jsal-ui/#pick-${key}`, label: ALL[key].label, line: ALL[key].name }));
const maps = rows.some((r) => r.credit);
const clipped = !!(me.film || me.clip) || rows.some((r) => r.c);
const bare = rows.some((r) => !r.c && !r.shot);
const MAPS = "https://sreyesmaps.com";
---
<Page
  title={`${page.title} | jsal.io`}
  description={page.description}
  path={`/jsal-ui/${part}/`}
  ogImage="jsal-ui"
  ogImageAlt="Your WoW Forever character, in one dashboard: jsal.ui's Home window, with the character, the trainer visit and the plans"
  ogDescription={page.description}
>
<JsalUiStyles slot="head" />
<script is:inline slot="head" src={v("/jsal-ui/reveal.js")} defer></script>
<style is:inline slot="head">
/* The line back to the jsal.ui page and the part's chapter */
.crumb { margin: var(--jsal-page-top) 0 0; }
/* The part's name and headline, what it does, and the download with when it's useful beside them */
.hero { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--jsal-space-24) var(--jsal-space-48); align-items: end; margin-top: var(--jsal-space-20); }
.hero h1 { margin: var(--jsal-space-8) 0 0; font: 700 46px/1.05 var(--f); letter-spacing: -0.02em; }
.hero .lead { max-width: 40em; margin: var(--jsal-space-16) 0 0; color: var(--jsal-ink-2); font-size: 17px; line-height: 1.55; }
.side { display: grid; justify-items: end; gap: var(--jsal-space-12); }
.side p { margin: 0; color: var(--jsal-muted); font-size: 14px; }
.side code { padding: var(--jsal-space-2) var(--jsal-space-8); border: 1px solid var(--jsal-line-hi); border-radius: var(--jsal-radius); color: var(--jsal-ink); }
.big { margin-top: var(--jsal-space-40); }

/* A row for each thing the part does: its picture beside its words, or, until one is drawn, its words beside its
   ticked points */
.part-row { margin-top: calc(var(--jsal-space-64) + var(--jsal-space-24)); scroll-margin-top: var(--jsal-space-24); }
.part-row h2 { margin: var(--jsal-space-8) 0 0; font: 700 30px/1.1 var(--f); letter-spacing: -0.02em; }
/* A row's picture takes turns left and right; stacked, the picture leads */
@media (min-width: 1280px) {
  .row.flip { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); }
  .row.flip > .win { order: 2; }
}
/* A close-up is one card or list from a window, never drawn larger than the game draws it */
.win.shot img { max-width: var(--w); margin-inline: auto; }

/* Good to know: three short facts, a card each */
.good { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--jsal-space-20); margin-top: calc(var(--jsal-space-64) + var(--jsal-space-32)); }
.good h2, .next h2, .band h2 { margin: 0; font: 700 24px/1.2 var(--f); letter-spacing: -0.01em; }
.good h2 { grid-column: 1 / -1; }
.good div { padding: var(--jsal-space-24); border-radius: var(--jsal-radius-tile); background: var(--plain); }
.good h3 { margin: 0; font: 700 20px/1.3 var(--f); }
.good p { margin: var(--jsal-space-8) 0 0; color: var(--jsal-ink-2); font-size: 14px; line-height: 1.5; }
/* More of jsal.ui: two parts and the jsal.ui page, as links the size of a card */
.next { margin-top: calc(var(--jsal-space-64) + var(--jsal-space-24)); }
.next ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--jsal-space-20); margin: var(--jsal-space-16) 0 0; padding: 0; list-style: none; }
.next a { display: grid; align-content: start; gap: var(--jsal-space-8); height: 100%; padding: var(--jsal-space-20) var(--jsal-space-24); border: 1px solid var(--jsal-line); border-radius: var(--jsal-radius-tile); color: inherit; text-decoration: none; transition: border-color var(--jsal-quick); }
.next a:hover { border-color: var(--jsal-hover-line); }
.next b { font: 700 20px/1.2 var(--f); }
.next span { color: var(--jsal-ink-2); font-size: 14px; line-height: 1.5; }
.next .more { color: var(--jsal-accent); font-size: 14px; }
/* Get it: the download again at the foot, with the version */
.band { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--jsal-space-24); margin-top: var(--jsal-space-64); padding: var(--jsal-space-32); border-radius: var(--jsal-radius-tile); background: var(--plain); }
.band p { margin: var(--jsal-space-4) 0 0; color: var(--jsal-ink-2); }
.band .get { display: flex; flex-wrap: wrap; gap: var(--jsal-space-12); }

@media (max-width: 899px) {
  .hero { grid-template-columns: minmax(0, 1fr); align-items: start; }
  .side { justify-items: start; }
  .good, .next ul { grid-template-columns: minmax(0, 1fr); }
}
@media (max-width: 599px) {
  .part-row { margin-top: var(--jsal-space-64); }
  .part-row h2 { font-size: 24px; }
  .good { margin-top: var(--jsal-space-64); }
  .band { padding: var(--jsal-space-20); }
  .band .get .jsal-btn { flex: 1 1 auto; }
  /* a close-up wider than the screen keeps its words readable: drawn at no less than 85% of the game's size, its
     left part shown in its frame */
  .win.shot { overflow: hidden; border: 1px solid var(--jsal-line-hi); border-radius: var(--jsal-radius-xl); background: var(--win-fill); box-shadow: var(--win-shadow); }
  .win.shot img { width: min(var(--w), max(100%, calc(var(--w) * 0.85))); max-width: none; margin: 0; border: 0; border-radius: 0; box-shadow: none; }
}
@media (max-width: 520px) { .hero h1 { font-size: 40px; } }
/* The narrowest phones keep the bar on one row: Updates goes (the jsal.ui page links it) */
@media (max-width: 374px) { .jsal-top nav a[href="/jsal-ui/updates/"] { display: none; } }
@media (prefers-reduced-motion: reduce) { .next a { transition: none; } }
</style>
{rows.some(wide) && (
<style is:inline slot="head">
/* A wide picture takes two thirds of its row */
@media (min-width: 1280px) {
  .row.wide { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
  .row.wide.flip { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); }
}
</style>
)}
{bare && (
<style is:inline slot="head">
/* A row with no picture yet: its words beside its ticked points, in a card */
.row.bare { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); align-items: center; }
.row.bare .say { margin-bottom: 0; }
.row.bare > .ticks { padding: var(--jsal-space-24); border-radius: var(--jsal-radius-tile); background: var(--plain); }
@media (max-width: 1279px) { .row.bare { grid-template-columns: minmax(0, 1fr); } }
</style>
)}
{clipped && (
<style is:inline slot="head">
@media (min-width: 600px) { .win.clip video { max-width: var(--w); margin-inline: auto; } }   /* a clip never drawn larger than it was made */
/* A clip plays while it's on screen, and keeps a Pause button (in the dark theme's colours, on the game) in its
   corner, so nothing moves without a way to stop it */
.clip-ctl { position: absolute; right: var(--jsal-space-12); bottom: var(--jsal-space-12); z-index: 1; }
</style>
)}
{maps && (
<style is:inline slot="head">
/* The maps' maker, credited under the words about them */
.credit { margin: var(--jsal-space-12) 0 0; color: var(--jsal-muted); font-size: 13px; }
</style>
)}
<div class="wrap">
  <TopBar><nav aria-label="Sections"><a href="/jsal-ui/" aria-current="true">jsal.ui</a><a href="/jsal-ui/updates/">Updates</a><a href="/jsal-ui/#install">Install</a></nav></TopBar>
<main>
  <nav class="crumb jsal-crumbs" aria-label="Breadcrumb"><a href="/jsal-ui/">jsal.ui</a> <span aria-hidden="true">›</span> <span aria-current="page">{me.label}</span></nav>
  <section class="hero" aria-labelledby="part-h">
    <div>
      <p class="eyebrow">{me.label}</p>
      <h1 id="part-h">{me.name}</h1>
      <p class="lead">{page.lead}</p>
    </div>
    <div class="side">
      <a class="jsal-btn primary dl" href={RELEASES}>Download jsal.ui</a>
      <p><span class="lv">{WHEN[me.when]}</span>&nbsp; {where[0]} <code>{where[1]}</code></p>
    </div>
  </section>
  <!-- The part's film (its window, moving) or its clip where it has one, the same as on its stage on the jsal.ui
       page; else its window, which on a phone shows its top corner at the game's own size -->
  {me.film ? (
    <figure class="win clip film crop big" data-rv style={`--w: ${me.film.w}px; --pw: ${me.film.w}px; --cx: ${me.shot.cx}; --cy: ${me.shot.cy}`}>
      <video muted loop playsinline preload="none" poster={v(me.film.poster)} width={me.film.w} height={me.film.h} aria-label={me.shot.alt}><source src={v(me.film.src)} type="video/mp4"></video>
      <span class="clip-ctl jsal-dark"><button type="button" class="jsal-btn small" data-name={me.label}>Play</button></span>
    </figure>
  ) : me.clip ? (
    <figure class="win clip crop big" data-rv style={`--w: ${me.clip.w}px; --pw: ${me.clip.pw}px; --cx: ${me.clip.cx}; --cy: ${me.clip.cy}`}>
      <video muted loop playsinline preload="none" poster={v(me.clip.poster)} width={me.clip.w} height={me.clip.h} aria-label={me.clip.alt}><source src={v(me.clip.src)} type="video/mp4"></video>
      <span class="clip-ctl jsal-dark"><button type="button" class="jsal-btn small" data-name={me.label}>Play</button></span>
    </figure>
  ) : (
    <figure class="win crop big" data-rv style={`--pw: ${me.shot.w}px; --cx: ${me.shot.cx}; --cy: ${me.shot.cy}`}><img src={v(me.shot.src)} width={me.shot.w} height={me.shot.h} alt={me.shot.alt} fetchpriority="high" decoding="async"></figure>
  )}
  {rows.map((r, i) => r.c ? (
    <section class={`row part-row${r.flip ? " flip" : ""}${wide(r) ? " wide" : ""}`} aria-labelledby={`row-${i}`} data-rv-row>
      <figure class="win clip crop" style={`--w: ${r.c.w}px; --pw: ${phoneW(r.c)}px; --cx: ${r.c.cx}; --cy: ${r.c.cy}`}>
        <video muted loop playsinline preload="none" poster={v(r.c.poster)} width={r.c.w} height={r.c.h} aria-label={r.c.alt}><source src={v(r.c.src)} type="video/mp4"></video>
        <span class="clip-ctl jsal-dark"><button type="button" class="jsal-btn small" data-name={r.label}>Play</button></span>
      </figure>
      <div class="words">
        <p class="eyebrow">{r.label}</p>
        <h2 id={`row-${i}`}>{r.name}</h2>
        <p class="say">{r.say}</p>
        <ul class="ticks">{r.points.map((x) => <li>{x}</li>)}</ul>
      </div>
    </section>
  ) : r.shot ? (
    <section class={`row part-row${r.flip ? " flip" : ""}${wide(r) ? " wide" : ""}`} aria-labelledby={`row-${i}`} data-rv-row>
      <figure class="win shot" style={`--w: ${r.shot.w}px`}><img src={v(r.shot.src)} width={r.shot.w} height={r.shot.h} alt={r.shot.alt} loading="lazy" decoding="async"></figure>
      <div class="words">
        <p class="eyebrow">{r.label}</p>
        <h2 id={`row-${i}`}>{r.name}</h2>
        <p class="say">{r.say}</p>
        {r.credit && <p class="credit">Maps by Santiago Reyes · Atlas de Azeroth: Forever · <a href={MAPS}>sreyesmaps.com</a></p>}
        <ul class="ticks">{r.points.map((x) => <li>{x}</li>)}</ul>
      </div>
    </section>
  ) : (
    <section class="row bare part-row" aria-labelledby={`row-${i}`} data-rv-row>
      <div class="words">
        <p class="eyebrow">{r.label}</p>
        <h2 id={`row-${i}`}>{r.name}</h2>
        <p class="say">{r.say}</p>
        {r.credit && <p class="credit">Maps by Santiago Reyes · Atlas de Azeroth: Forever · <a href={MAPS}>sreyesmaps.com</a></p>}
      </div>
      <ul class="ticks">{r.points.map((x) => <li>{x}</li>)}</ul>
    </section>
  ))}
  <section class="good" aria-labelledby="good-h" data-rv-cards>
    <h2 id="good-h">Good to know</h2>
    {page.good.map(([t, d]) => <div><h3>{t}</h3><p>{d}</p></div>)}
  </section>
  <nav class="next" aria-labelledby="next-h">
    <h2 id="next-h" data-rv>More of jsal.ui</h2>
    <ul data-rv-cards>
      {next.map((n) => <li><a href={n.href} data-plain><b>{n.label}</b><span>{n.line}</span><span class="more">{n.label}</span></a></li>)}
      <li><a href="/jsal-ui/" data-plain><b>Everything in jsal.ui</b><span>Every part, from trainer visits to daily games with your guild.</span><span class="more">The jsal.ui page</span></a></li>
    </ul>
  </nav>
  <section class="band" aria-labelledby="get-h" data-rv>
    <div><h2 id="get-h">Get jsal.ui</h2><p>Free, for WoW Forever. Version {RELEASE.version}, {released}.</p></div>
    <div class="get"><a class="jsal-btn primary dl" href={RELEASES}>Download jsal.ui</a><a class="jsal-btn dl" href="/jsal-ui/#install">How to install</a></div>
  </section>
  <footer class="foot" data-rv>
    <p>Made by jsal · <a href="mailto:dev@jsal.io">dev@jsal.io</a></p>
    <p>Screenshots of World of Warcraft © Blizzard Entertainment.{maps && " Dungeon maps by Santiago Reyes."}</p>
  </footer>
</main>
</div>
{clipped && (
<script is:inline>
// The clips: each plays while a third of its frame is on screen and stops when it leaves, downloading only then
// (the frame, not the video, as phones show only a corner of the video). Its button says what a press does (Pause
// or Play), and a pause holds until the visitor plays it again. With reduced motion, or when the browser is asked to
// save data, nothing starts by itself or downloads; Play still works. A page loaded ahead waits until it's shown.
function clips() {
  const calm = !matchMedia('(prefers-reduced-motion: no-preference)').matches || !!(navigator.connection && navigator.connection.saveData);
  const watch = 'IntersectionObserver' in window && new IntersectionObserver((es) => es.forEach((e) => {
    const v = e.target.querySelector('video');
    if (e.isIntersecting && !v.dataset.held) v.play().catch(() => {});
    else if (!e.isIntersecting && !v.paused) v.pause();
  }), { threshold: 0.33 });
  document.querySelectorAll('.clip video').forEach((v) => {
    const btn = v.parentElement.querySelector('.clip-ctl button');
    const say = () => {
      btn.textContent = v.paused ? 'Play' : 'Pause';
      btn.setAttribute('aria-label', `${btn.textContent} the ${btn.dataset.name} clip`);
    };
    v.addEventListener('play', say);
    v.addEventListener('pause', say);
    say();
    btn.addEventListener('click', () => {
      if (v.paused) { delete v.dataset.held; v.play().catch(() => {}); }
      else { v.dataset.held = '1'; v.pause(); }
    });
    if (calm) v.dataset.held = '1';
    if (watch) watch.observe(v.parentElement);
  });
}
if (document.prerendering) document.addEventListener('prerenderingchange', clips, { once: true });
else clips();
</script>
)}
</Page>
