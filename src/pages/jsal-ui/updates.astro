---
// jsal.ui's updates: every released version, newest first, with everything in it a player would notice (John, 21 Nov
// 2026: "a page on jsal.io strictly for updates. categorized, labeled and everything"; of the mockups, "I do like the
// tags on B, can we do that but A", then "A2"). A card a release, laid out like the jsal.ui page's Latest release
// card: the version, LATEST, the date and its counts at the left, a note when the game needs a restart; at the
// right one list in the order New, Better, Fixed, Taken out, each line with its kind's pill and the part it
// touches, and a thanks where a player found it. The releases and the check of them are in
// src/lib/jsal-ui-updates.mjs. Betas never show here; older releases are on GitHub.
import Page from "../../layouts/Page.astro";
import TopBar from "../../components/TopBar.astro";
import { releases, olderThan } from "../../lib/jsal-ui-updates.mjs";
const RELEASES = releases();
const OLDER = olderThan(RELEASES);
const ALL_RELEASES = "https://github.com/superjsal/jsal-ui/releases";
const plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;
---
<Page
  title="What's new in jsal.ui | jsal.io"
  description="Every change in each release of jsal.ui, the free WoW Forever addon, newest first: what's new, what's better, what's fixed and what's taken out, with the part of the addon each one touches."
  path="/jsal-ui/updates/"
  ogImage="jsal-ui"
  ogImageAlt="Your WoW Forever character, in one dashboard: jsal.ui's Home window, with the character, the trainer visit and the plans"
  ogDescription="Every change in each release of jsal.ui, the free WoW Forever addon, newest first."
>
<style is:inline slot="head">
:root {
  --f: "Outfit", "Segoe UI", system-ui, -apple-system, sans-serif;
  /* the cards' fill, as on the jsal.ui page */
  --plain: #e6e8ec;
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --plain: #1c1f27; } }
:root[data-theme="dark"] { --plain: #1c1f27; }
* { box-sizing: border-box; }
body { margin: 0; color: var(--jsal-ink); font: 15px/1.6 var(--jsal-font); -webkit-font-smoothing: antialiased; }
.wrap { max-width: calc(var(--jsal-col) + 40px); margin: 0 auto; padding: 0 max(var(--jsal-gutter), env(safe-area-inset-right, 0px)) var(--jsal-page-end) max(var(--jsal-gutter), env(safe-area-inset-left, 0px)); }
/* Top bar: the shared one, with the jsal.ui page's links, as that page has them */
.jsal-top nav { display: flex; gap: var(--jsal-space-2); font-size: 14px; }
.jsal-top nav a { padding: var(--jsal-space-8) var(--jsal-space-8); line-height: 20px; color: var(--jsal-muted); text-decoration: none; border-radius: var(--jsal-radius); }
.jsal-top nav a:hover { color: var(--jsal-ink); }
@media (pointer: coarse) {
  .jsal-top nav a { position: relative; }
  .jsal-top nav a::after { content: ""; position: absolute; inset: -4px 0; }   /* 36px drawn, 44px to tap */
}
.upd { margin-top: var(--jsal-page-top); }
.code { margin: 0 0 var(--jsal-space-12); font: 500 12px/1.5 "JetBrains Mono", Consolas, monospace; letter-spacing: 0.06em; text-transform: uppercase; color: var(--jsal-accent); }
.code a { color: inherit; text-decoration: none; }
h1 { margin: 0; font: 700 46px/1.05 var(--f); letter-spacing: -0.02em; }
h1 em { font-style: normal; color: var(--jsal-accent); }
.lead { margin: var(--jsal-space-24) 0 0; max-width: 44em; font-size: 17px; color: var(--jsal-ink-2); text-wrap: pretty; }
.meta { margin: var(--jsal-space-8) 0 0; color: var(--jsal-muted); font-size: 14px; }
.upd a { color: var(--jsal-accent); text-underline-offset: 2px; }
/* A release: its version, date and counts at the left, its changes at the right */
.rel { display: grid; grid-template-columns: 15em minmax(0, 1fr); gap: var(--jsal-space-48); margin-top: var(--jsal-space-24); padding: var(--jsal-space-32); border-radius: var(--jsal-radius-tile); background: var(--plain); scroll-margin-top: var(--jsal-space-24); }
.rel:first-of-type { margin-top: var(--jsal-space-40); }
.ver { display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--jsal-space-12); margin: 0; font: 700 30px/1.1 var(--f); }
.ver a { color: inherit; text-decoration: none; }
.tag { align-self: center; padding: var(--jsal-pad-tag); border-radius: var(--jsal-radius-pill); background: var(--jsal-fill); color: var(--jsal-on-fill); font: 600 12px/1.5 var(--jsal-font); letter-spacing: 0.06em; text-transform: uppercase; }
.when { margin: var(--jsal-space-4) 0 0; color: var(--jsal-muted); }
.count { margin: var(--jsal-space-16) 0 0; color: var(--jsal-ink-2); font-size: 14px; }
.count span { display: block; color: var(--jsal-muted); }
.restart { margin: var(--jsal-space-16) 0 0; padding: var(--jsal-pad-note); border-radius: var(--jsal-radius); background: var(--jsal-warn-soft); color: var(--jsal-ink); font-size: 14px; line-height: 1.45; }
.restart b { display: block; color: var(--jsal-warn); font: 600 12px/1.5 "JetBrains Mono", Consolas, monospace; letter-spacing: 0.06em; text-transform: uppercase; }
/* A change: its kind's pill, the part of the addon it touches, its words */
.changes { margin: 0; padding: 0; list-style: none; }
.changes li { display: grid; grid-template-columns: 6.6em 9em minmax(0, 1fr); gap: var(--jsal-space-12); align-items: baseline; padding: var(--jsal-space-8) 0; border-top: 1px solid var(--jsal-line); color: var(--jsal-ink-2); }
.changes li:first-child { border-top: 0; }
.part { color: var(--jsal-ink); font-weight: 600; }
.k { justify-self: start; padding: 0 var(--jsal-space-8); border-radius: var(--jsal-radius-pill); font: 600 12px/1.8 var(--jsal-font); letter-spacing: 0.04em; text-transform: uppercase; white-space: nowrap; }
.k.new { background: var(--jsal-accent-soft); color: var(--jsal-accent); }
.k.better { background: var(--jsal-info-soft); color: var(--jsal-info); }
.k.fixed { background: var(--jsal-ok-soft); color: var(--jsal-ok); }
.k.out { background: var(--jsal-sunk); color: var(--jsal-muted); }
.thanks { display: inline-block; margin-left: var(--jsal-space-8); padding: 0 var(--jsal-space-8); border-radius: var(--jsal-radius-pill); background: var(--jsal-ok-soft); color: var(--jsal-ok); font-size: 13px; font-weight: 600; line-height: 1.7; white-space: nowrap; }
.older { margin: var(--jsal-space-32) 0 0; color: var(--jsal-muted); }
@media (max-width: 720px) {
  .rel { grid-template-columns: minmax(0, 1fr); gap: var(--jsal-space-20); padding: var(--jsal-space-24) var(--jsal-space-20); }
  .count span { display: inline; margin-left: var(--jsal-space-4); }
  .changes li { grid-template-columns: auto minmax(0, 1fr); gap: var(--jsal-space-2) var(--jsal-space-12); }
  .changes .w { grid-column: 1 / -1; }
}
@media (max-width: 520px) { h1 { font-size: 40px; } }
</style>
<div class="wrap">
  <TopBar><nav aria-label="Sections"><a href="/jsal-ui/">jsal.ui</a><a href="/jsal-ui/#install">Install</a></nav></TopBar>
  <main class="upd">
    <p class="code"><a href="/jsal-ui/">jsal.ui</a> · Updates</p>
    <h1>What’s <em>new</em> in jsal.ui</h1>
    <p class="lead">My WoW Forever addon’s releases, newest first, with everything you’d notice in each. The game’s own notes keep the top five; this is the whole list.</p>
    <p class="meta">{plural(RELEASES.length, "release", "releases")} · betas show here once they’re released</p>
    {RELEASES.map((r) => (
    <section class="rel" id={`v${r.version}`} aria-labelledby={`h${r.version}`}>
      <div>
        <h2 class="ver" id={`h${r.version}`}><a href={`#v${r.version}`}>{r.version}</a>{r.latest && <span class="tag">Latest</span>}</h2>
        <p class="when"><time data-updated={r.latest ? "" : undefined} datetime={r.date}>{r.when}</time></p>
        <p class="count">{plural(r.changes.length, "change", "changes")}<span>{r.counts.map((k) => `${k.n} ${k.word.toLowerCase()}`).join(" · ")}</span></p>
        {r.restart && <p class="restart"><b>Restart the game</b>once, after updating: this version’s files changed.</p>}
      </div>
      <ul class="changes">
        {r.changes.map((c) => (
        <li><span class={`k ${c.kind}`}>{c.word}</span><span class="part">{c.part}</span><span class="w">{c.title && <strong class="t">{c.title}. </strong>}{c.text}{c.thanks && <span class="thanks">Thanks, {c.thanks}</span>}</span></li>
        ))}
      </ul>
    </section>
    ))}
    {OLDER && <p class="older">Older releases: <a href={ALL_RELEASES}>{OLDER} and before</a></p>}
  </main>
</div>
</Page>
