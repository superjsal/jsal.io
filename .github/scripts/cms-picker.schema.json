{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$comment": "The public CMS Picker data (cms-picker/data.json), written by playbook.py publish. check_data.py checks it against this file: before every publish, before every push (build\\check.ps1) and on GitHub. It understands the keywords used here: type, required, properties, additionalProperties, items, enum, pattern, minLength, minimum, maximum.",
  "type": "object",
  "required": ["schemaVersion", "verdicts", "asOf", "groups", "items", "platforms", "answers"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [2] },
    "asOf": { "type": "string", "minLength": 1 },
    "verdicts": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "title": { "type": "string", "minLength": 1 }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "group"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "label": { "type": "string", "minLength": 1 },
          "term": { "type": "string", "minLength": 1 },
          "group": { "type": "string", "pattern": "^[a-z0-9_]+$" }
        }
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "profile"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "logo": { "type": "string", "pattern": "^logos/[A-Za-z0-9_./-]+(\\?v=[0-9a-f]+)?$" },
          "profile": {
            "type": "object",
            "required": ["type", "summary", "goals"],
            "properties": {
              "type": { "type": "string", "minLength": 1 },
              "summary": { "type": "string" },
              "goals": { "type": "array", "items": { "type": "string", "enum": ["site", "store", "content", "custom"] } },
              "tags": { "type": "array", "items": { "type": "string" } },
              "aiTags": { "type": "array", "items": { "type": "string" } },
              "goodFit": { "type": "array", "items": { "type": "string" } },
              "lessSuited": { "type": "array", "items": { "type": "string" } },
              "hosting": { "type": "string" },
              "export": { "type": "string" }
            }
          }
        }
      }
    },
    "answers": {
      "$comment": "platform id → row id → one answer",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["verdict", "scope"],
          "additionalProperties": false,
          "properties": {
            "verdict": { "type": "string", "enum": ["yes", "auto", "plugin", "code", "hosting", "check", "indirect", "no"] },
            "mark": { "type": "string" },
            "scope": { "$comment": "U same on every site, V varies by site (plan, theme or setup), C not verified", "type": "string", "enum": ["U", "V", "C"] },
            "sourceUrl": { "type": "string", "pattern": "^https://\\S+$" },
            "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        }
      }
    },
    "quiz": {
      "type": "object",
      "required": ["ease", "look"],
      "properties": {
        "ease": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 3 } },
        "look": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string", "enum": ["template", "visual", "pixel"] } } },
        "largeCatalogue": { "type": "array", "items": { "type": "string" } },
        "smallShop": { "type": "array", "items": { "type": "string" } },
        "storeOnly": { "type": "array", "items": { "type": "string" } },
        "agency": { "type": "array", "items": { "type": "string" } },
        "agencyOnly": { "type": "array", "items": { "type": "string" } },
        "customFrontEnd": { "type": "array", "items": { "type": "string" } },
        "devControl": { "type": "array", "items": { "type": "string" } },
        "kind": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "domainDocs": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^https://\\S+$" } }
      }
    }
  }
}
